<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><External>null</External><External>nil</External><Item class="Folder" referent="RBX000034"><Properties><string name="Name">SPSO_Package</string></Properties><Item class="StringValue" referent="RBX000025"><Properties><string name="Name">_version</string><string name="Value">game-v3</string></Properties></Item><Item class="Folder" referent="RBX000026"><Properties><string name="Name">ReplicatedStorage/SPSO/Runtime</string></Properties><Item class="ModuleScript" referent="RBX000001"><Properties><string name="Name">ExactAnimator</string><ProtectedString name="Source"><![CDATA[--!native
-- SPSO ExactAnimator: plays a hero's ORIGINAL animation curves exactly the way Unity's legacy
-- Animation component did: Hermite curves, quaternion components normalised, the full node chain,
-- crossfades, wrap modes, animation events, facial expressions (FacialAnimation.cs) and root motion
-- (CharacterMotionController.performRootMotion).
--
-- Output on clients:
--   * pose without visible bone scale -> Roblox Bones (Bone.Transform) of the imported skinned model
--   * pose WITH bone scale (fists swelling etc.) -> an EditableMesh copy skinned on the CPU from the
--     same pose (Roblox bones cannot scale); the imported mesh is hidden meanwhile.
-- Headless mode (server, or no model): time, events and root motion only.
--
-- local a = ExactAnimator.new(HeroPack.get("ElRugido"), model, config); a:Start()
-- a:CrossFade("attack_L1", 0.1); a.Event:Connect(function(fn, data, clipName, ev) ... end)
local AssetService = game:GetService("AssetService")
local ContentProvider = game:GetService("ContentProvider")
local RunService = game:GetService("RunService")

local ExactAnimator = {}
ExactAnimator.__index = ExactAnimator

local WrapMode = { Default = 0, Once = 1, Loop = 2, PingPong = 4, ClampForever = 8 }
ExactAnimator.WrapMode = WrapMode
local FACES = { normal = 0, happy = 1, surprised = 2, aggressive = 3, squint = 4, blink = 5, custom1 = 6, custom2 = 7 }
ExactAnimator.Faces = FACES
local HUGE = math.huge

-- tiny signal ---------------------------------------------------------------------------------
local Signal = {}
Signal.__index = Signal
function Signal.new() return setmetatable({ _fns = {} }, Signal) end
function Signal:Connect(fn)
	local fns = self._fns
	table.insert(fns, fn)
	return { Disconnect = function() local i = table.find(fns, fn); if i then table.remove(fns, i) end end }
end
function Signal:Fire(...)
	for _, fn in table.clone(self._fns) do task.spawn(fn, ...) end
end
ExactAnimator.Signal = Signal

-- Unity AnimationCurve evaluation of one curve at time t into out[1..dim] -------------------------
local function evalCurve(buf: buffer, cv, t: number, cursors, ci: number, out)
	local dim = cv.dim
	local const = cv.const
	if const then
		for d = 1, dim do out[d] = const[d] end
		return
	end
	local times, n, vOff = cv.times, cv.n, cv.vOff
	if n == 1 or t <= times[1] then
		for d = 0, dim - 1 do out[d + 1] = buffer.readf32(buf, vOff + d * 4) end
		return
	elseif t >= times[n] then
		local o = vOff + (n - 1) * dim * 4
		for d = 0, dim - 1 do out[d + 1] = buffer.readf32(buf, o + d * 4) end
		return
	end
	local i = cursors[ci] or 1
	if i < 1 or i > n - 1 or times[i] > t then
		local lo, hi = 1, n - 1
		while lo < hi do
			local mid = (lo + hi + 1) // 2
			if times[mid] <= t then lo = mid else hi = mid - 1 end
		end
		i = lo
	else
		while i < n - 1 and times[i + 1] <= t do i += 1 end
	end
	cursors[ci] = i
	local t0 = times[i]
	local dt = times[i + 1] - t0
	local o0 = vOff + (i - 1) * dim * 4
	if dt <= 0 then
		for d = 0, dim - 1 do out[d + 1] = buffer.readf32(buf, o0 + d * 4) end
		return
	end
	local u = (t - t0) / dt
	local u2 = u * u
	local u3 = u2 * u
	local h00, h10, h01, h11 = 2 * u3 - 3 * u2 + 1, u3 - 2 * u2 + u, -2 * u3 + 3 * u2, u3 - u2
	local o1 = o0 + dim * 4
	local so = cv.outOffs[i]
	local si = cv.inOff + i * dim * 4 -- in slope of key i+1
	for d = 0, dim - 1 do
		local v0 = buffer.readf32(buf, o0 + d * 4)
		local m0 = buffer.readf32(buf, so + d * 4) * dt
		local m1 = buffer.readf32(buf, si + d * 4) * dt
		local r = h00 * v0 + h10 * m0 + h01 * buffer.readf32(buf, o1 + d * 4) + h11 * m1
		if r ~= r or r == HUGE or r == -HUGE or m0 ~= m0 or m1 ~= m1 or m0 == HUGE or m0 == -HUGE or m1 == HUGE or m1 == -HUGE then
			r = v0 -- stepped key
		end
		out[d + 1] = r
	end
end
ExactAnimator.evalCurve = evalCurve

-- construction -------------------------------------------------------------------------------------
function ExactAnimator.new(pack, model: Model?, config)
	config = config or {}
	local self = setmetatable({}, ExactAnimator)
	self.pack, self.model, self.config = pack, model, config
	self.headless = model == nil or config.headless == true
	local N = #pack.nodes
	self.N = N
	local RT, RQ, RS, parent = table.create(3 * N), table.create(4 * N), table.create(3 * N), table.create(N)
	for i, n in pack.nodes do
		RT[3 * i - 2], RT[3 * i - 1], RT[3 * i] = n.t[1], n.t[2], n.t[3]
		RQ[4 * i - 3], RQ[4 * i - 2], RQ[4 * i - 1], RQ[4 * i] = n.q[1], n.q[2], n.q[3], n.q[4]
		RS[3 * i - 2], RS[3 * i - 1], RS[3 * i] = n.s[1], n.s[2], n.s[3]
		parent[i] = n.parent
	end
	self.RT, self.RQ, self.RS, self.parent = RT, RQ, RS, parent
	self.LT, self.LQ, self.LS = table.create(3 * N, 0), table.create(4 * N, 0), table.create(3 * N, 0)
	self.ST, self.SQ, self.SS = table.create(3 * N, 0), table.create(4 * N, 0), table.create(3 * N, 0)
	self.W = table.create(12 * N, 0)
	self.SM = table.create(12 * #pack.bones, 0)
	self.tmp = table.create(4, 0)
	self.states, self.active, self.pending = {}, {}, {}
	self.clock = 0
	self.Event = Signal.new()
	self.wrapDefaults = config.wrapModes or {}
	self.face, self.faceDefault, self.faceRevertAt = 0, 0, 0
	self.rootNode = pack.nodeIndex.motion_export
	self.rootForward, self.rootPrevY = 0, nil
	self.mode = "bones"
	if not self.headless then self:_bindRig(model) end
	return self
end

function ExactAnimator:_bindRig(model: Model)
	local pack, config = self.pack, self.config
	local root = config.rigRoot or model:FindFirstChild("RootPart", true)
	assert(root, "hero model has no RootPart")
	self.rigRoot = root
	local byName = {}
	for _, d in root:GetDescendants() do
		if d:IsA("Bone") then byName[d.Name] = d end
	end
	local NB = #pack.bones
	self.rigBones, self.rigParent, self.boneCFInv = table.create(NB), table.create(NB, 0), table.create(NB)
	self.C, self.A = table.create(12 * NB, 0), table.create(NB)
	local depth = {}
	for b, pb in pack.bones do
		local bone = byName[pb.name]
		assert(bone, "rig has no bone " .. pb.name)
		self.rigBones[b] = bone
		local par = bone.Parent
		self.rigParent[b] = (par and par:IsA("Bone")) and (pack.boneIndex[par.Name] or 0) or 0
		self.boneCFInv[b] = bone.CFrame:Inverse()
		local rest, p, d = bone.CFrame, bone.Parent, 0
		while p and p:IsA("Bone") do
			rest = p.CFrame * rest
			p = p.Parent
			d += 1
		end
		depth[b] = d
		local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = rest:GetComponents()
		local m, c = pb.binv, (b - 1) * 12
		local C = self.C
		for row = 0, 2 do -- C = Binv * Rest
			local a0, a1, a2, a3 = m[row * 4 + 1], m[row * 4 + 2], m[row * 4 + 3], m[row * 4 + 4]
			C[c + row * 4 + 1] = a0 * r00 + a1 * r10 + a2 * r20
			C[c + row * 4 + 2] = a0 * r01 + a1 * r11 + a2 * r21
			C[c + row * 4 + 3] = a0 * r02 + a1 * r12 + a2 * r22
			C[c + row * 4 + 4] = a0 * x + a1 * y + a2 * z + a3
		end
	end
	local order = {}
	for b = 1, NB do order[b] = b end
	table.sort(order, function(a, b) return depth[a] < depth[b] end)
	self.boneOrder = order
	self.rigParts, self.rigTransparency = {}, {}
	for _, part in pack.parts do
		local mp = model:FindFirstChild(part.name, true)
		if mp then
			self.rigParts[part.name] = mp
			self.rigTransparency[mp] = mp.Transparency
		end
	end
	self.faceIds = config.faceTextures
	self.headName = config.headPart
	if self.faceIds then
		task.spawn(function() pcall(ContentProvider.PreloadAsync, ContentProvider, self.faceIds) end)
	end
	self.textureOverride = {}
	self.skinEnabled = config.skin ~= false
	self.skinTolerance = config.skinTolerance or 0.002
	self.lodDistance = config.lodDistance or 120
	self.normalsEvery = config.normalsEvery or 1
	self.skinFrame = 0
	if self.skinEnabled and config.prebuildSkin ~= false then task.spawn(self._buildSkin, self) end
end

-- EditableMesh copy of the hero for frames that need bone scale
function ExactAnimator:_buildSkin()
	if self.skin ~= nil then return end
	self.skin = false
	local ok, err = pcall(function()
		local list = {}
		for _, part in self.pack.parts do
			local rigPart = self.rigParts[part.name]
			local em = AssetService:CreateEditableMesh()
			if not em then error("EditableMesh memory budget reached", 0) end
			local pos, nrm, uv, tri = part.pos, part.nrm, part.uv, part.tri
			local vids, nids, uids = table.create(part.nV), table.create(part.nN), table.create(part.nUV)
			for v = 1, part.nV do vids[v] = em:AddVertex(Vector3.new(pos[3 * v - 2], pos[3 * v - 1], pos[3 * v])) end
			for k = 1, part.nN do nids[k] = em:AddNormal(Vector3.new(nrm[3 * k - 2], nrm[3 * k - 1], nrm[3 * k])) end
			for k = 1, part.nUV do uids[k] = em:AddUV(Vector2.new(uv[2 * k - 1], uv[2 * k])) end
			for t = 0, part.nT - 1 do
				local o = t * 9
				local f = em:AddTriangle(vids[tri[o + 1]], vids[tri[o + 2]], vids[tri[o + 3]])
				em:SetFaceNormals(f, { nids[tri[o + 4]], nids[tri[o + 5]], nids[tri[o + 6]] })
				em:SetFaceUVs(f, { uids[tri[o + 7]], uids[tri[o + 8]], uids[tri[o + 9]] })
			end
			local mp = AssetService:CreateMeshPartAsync(Content.fromObject(em))
			mp.Name = part.name .. "_Exact"
			mp.Size = mp.MeshSize
			mp.Anchored, mp.CanCollide, mp.CanQuery, mp.CanTouch, mp.Massless = false, false, false, false, true
			if rigPart then
				mp.TextureContent = self.textureOverride[part.name] or rigPart.TextureContent
				mp.Material, mp.Color = rigPart.Material, rigPart.Color
			end
			mp.Transparency = 1
			mp.CFrame = self.rigRoot.CFrame
			local weld = Instance.new("WeldConstraint")
			weld.Part0, weld.Part1 = self.rigRoot, mp
			weld.Parent = mp
			mp.Parent = self.model
			table.insert(list, { part = part, em = em, mp = mp, vids = vids, nids = nids, rigPart = rigPart })
		end
		self.skin = list
		if self.faceIds and self.headName then
			for _, s in list do
				if s.part.name == self.headName then s.mp.TextureID = self.faceIds[self.face + 1] or s.mp.TextureID end
			end
		end
	end)
	if not ok then
		warn("[SPSO] exact skin unavailable, using bones only: " .. tostring(err))
		self.skin = false
	end
end

-- states (Unity AnimationState) --------------------------------------------------------------------
function ExactAnimator:HasClip(name: string): boolean
	return self.pack.clips[name] ~= nil
end

function ExactAnimator:GetState(name: string)
	local st = self.states[name]
	if st then return st end
	local clip = self.pack.clips[name]
	if not clip then return nil end
	local wrap = self.wrapDefaults[name] or clip.wrap
	if wrap == WrapMode.Default then wrap = WrapMode.Once end
	st = { name = name, clip = clip, length = clip.duration, time = 0, speed = 1, wrapMode = wrap,
		weight = 0, target = 0, fadeSpeed = HUGE, enabled = false, cursors = {} }
	self.states[name] = st
	return st
end

function ExactAnimator:_start(st)
	if st.enabled then return end
	st.enabled, st.justStarted, st.ended = true, true, false
	table.insert(self.active, st)
end

function ExactAnimator:_stop(st)
	st.enabled, st.weight, st.target, st.time, st.ended = false, 0, 0, 0, false
	local i = table.find(self.active, st)
	if i then table.remove(self.active, i) end
end

function ExactAnimator:IsPlaying(name: string): boolean
	local st = self.states[name]
	return st ~= nil and st.enabled
end

function ExactAnimator:Play(name: string): boolean
	local st = self:GetState(name)
	if not st then return false end
	for _, o in table.clone(self.active) do
		if o ~= st then self:_stop(o) end
	end
	self:_start(st)
	st.weight, st.target, st.fadeSpeed = 1, 1, HUGE
	return true
end

function ExactAnimator:CrossFade(name: string, fade: number?): boolean
	fade = fade or 0.3
	local st = self:GetState(name)
	if not st then return false end
	if fade <= 0 or #self.active == 0 or (#self.active == 1 and self.active[1] == st) then
		return self:Play(name)
	end
	self:_start(st)
	st.target = 1
	st.fadeSpeed = math.max(1e-6, 1 - st.weight) / fade
	for _, o in self.active do
		if o ~= st then
			o.target = 0
			o.fadeSpeed = math.max(1e-6, o.weight) / fade
		end
	end
	return true
end

function ExactAnimator:Stop(name: string?)
	if name then
		local st = self.states[name]
		if st and st.enabled then self:_stop(st) end
	else
		for _, o in table.clone(self.active) do self:_stop(o) end
	end
end

function ExactAnimator:Rewind(name: string?)
	for n, st in self.states do
		if name == nil or n == name then
			st.time, st.cursors = 0, {}
			if st.enabled then st.justStarted = true end
		end
	end
end

-- the clip that currently has the most weight (and is fading in)
function ExactAnimator:Current()
	local best
	for _, st in self.active do
		if st.target > 0 and (best == nil or st.weight > best.weight) then best = st end
	end
	return best
end

-- face (FacialAnimation.cs) ----------------------------------------------------------------------
function ExactAnimator:SetFace(k: number)
	if k == self.face then return end
	self.face = k
	if self.headless or not self.faceIds then return end
	local id = self.faceIds[k + 1]
	if not id then return end
	local rp = self.headName and self.rigParts[self.headName]
	if rp then rp.TextureID = id end
	if type(self.skin) == "table" then
		for _, s in self.skin do
			if s.part.name == self.headName then s.mp.TextureID = id end
		end
	end
end

function ExactAnimator:_faceTag(data: string)
	local expr, secs = string.match(data, "^%s*([%w_]+)%s*:?%s*([%d%.%-eE]*)")
	local k = expr and FACES[string.lower(expr)]
	if k then self:SetFace(k) end
	local s = tonumber(secs)
	if s and s > 0 then self.faceRevertAt = self.clock + s end
end

-- replace a part's texture on the imported mesh and on its exact-skin copy (e.g. a recolored EditableImage)
function ExactAnimator:SetPartTexture(partName: string, content: Content)
	if self.headless then return end
	self.textureOverride[partName] = content
	local rp = self.rigParts[partName]
	if rp then rp.TextureContent = content end
	if type(self.skin) == "table" then
		for _, s in self.skin do
			if s.part.name == partName then s.mp.TextureContent = content end
		end
	end
end

-- root motion: forward studs accumulated since the last call (performRootMotion semantics)
function ExactAnimator:ConsumeRootMotion(): number
	local d = self.rootForward
	self.rootForward = 0
	return d
end

-- frame update ---------------------------------------------------------------------------------------
local function sampleTime(st)
	local d = st.length
	local t = st.time
	if d <= 0 then return 0 end
	if st.wrapMode == WrapMode.Loop then
		return t % d
	elseif st.wrapMode == WrapMode.PingPong then
		local c = t % (2 * d)
		return c > d and 2 * d - c or c
	end
	return math.clamp(t, 0, d)
end

function ExactAnimator:_queueEvents(st, prev: number)
	local clip = st.clip
	local evs = clip.events
	local d = st.length
	if st.justStarted then
		prev = -1e-6 -- a state that just started fires everything from time 0 (catch-up after a late start)
		st.justStarted = false
	end
	local cur = st.time
	local function q(a, b)
		if st.target <= 0 then return end
		for _, e in evs do
			if e.time > a and e.time <= b and e.time <= d + 1e-5 then
				table.insert(self.pending, { st.name, e })
			end
		end
	end
	if st.wrapMode == WrapMode.Loop and d > 0 then
		if cur >= d then
			q(prev, d)
			cur %= d
			st.time = cur
			q(-1e-6, cur)
		else
			q(prev, cur)
		end
	elseif st.wrapMode == WrapMode.PingPong then
		return
	else
		q(prev, math.min(cur, d))
		if cur >= d and st.wrapMode == WrapMode.Once then st.ended = true end
	end
end

function ExactAnimator:_sample(st, T, Q, S)
	local N = self.N
	table.move(self.RT, 1, 3 * N, 1, T)
	table.move(self.RQ, 1, 4 * N, 1, Q)
	table.move(self.RS, 1, 3 * N, 1, S)
	local buf, t, cursors, tmp = self.pack.buf, sampleTime(st), st.cursors, self.tmp
	for ci, cv in st.clip.curves do
		evalCurve(buf, cv, t, cursors, ci, tmp)
		local n, kind = cv.node, cv.kind
		if kind == 0 then
			Q[4 * n - 3], Q[4 * n - 2], Q[4 * n - 1], Q[4 * n] = tmp[1], tmp[2], tmp[3], tmp[4]
		elseif kind == 1 then
			T[3 * n - 2], T[3 * n - 1], T[3 * n] = tmp[1], tmp[2], tmp[3]
		else
			S[3 * n - 2], S[3 * n - 1], S[3 * n] = tmp[1], tmp[2], tmp[3]
		end
	end
end

function ExactAnimator:_compose()
	local N, parent, W = self.N, self.parent, self.W
	local LT, LQ, LS = self.LT, self.LQ, self.LS
	for i = 1, N do
		local x, y, z, w = LQ[4 * i - 3], LQ[4 * i - 2], LQ[4 * i - 1], LQ[4 * i]
		local len = math.sqrt(x * x + y * y + z * z + w * w)
		if len > 1e-12 then x, y, z, w = x / len, y / len, z / len, w / len end
		local sx, sy, sz = LS[3 * i - 2], LS[3 * i - 1], LS[3 * i]
		local tx, ty, tz = LT[3 * i - 2], LT[3 * i - 1], LT[3 * i]
		local xx, yy, zz, xy, xz, yz, wx, wy, wz = x * x, y * y, z * z, x * y, x * z, y * z, w * x, w * y, w * z
		local b00, b01, b02 = (1 - 2 * (yy + zz)) * sx, 2 * (xy - wz) * sy, 2 * (xz + wy) * sz
		local b10, b11, b12 = 2 * (xy + wz) * sx, (1 - 2 * (xx + zz)) * sy, 2 * (yz - wx) * sz
		local b20, b21, b22 = 2 * (xz - wy) * sx, 2 * (yz + wx) * sy, (1 - 2 * (xx + yy)) * sz
		local o = (i - 1) * 12
		local p = parent[i]
		if p <= 0 then
			W[o + 1], W[o + 2], W[o + 3], W[o + 4] = b00, b01, b02, tx
			W[o + 5], W[o + 6], W[o + 7], W[o + 8] = b10, b11, b12, ty
			W[o + 9], W[o + 10], W[o + 11], W[o + 12] = b20, b21, b22, tz
		else
			local q = (p - 1) * 12
			for r = 0, 2 do
				local a0, a1, a2, a3 = W[q + r * 4 + 1], W[q + r * 4 + 2], W[q + r * 4 + 3], W[q + r * 4 + 4]
				W[o + r * 4 + 1] = a0 * b00 + a1 * b10 + a2 * b20
				W[o + r * 4 + 2] = a0 * b01 + a1 * b11 + a2 * b21
				W[o + r * 4 + 3] = a0 * b02 + a1 * b12 + a2 * b22
				W[o + r * 4 + 4] = a0 * tx + a1 * ty + a2 * tz + a3
			end
		end
	end
	-- skinning matrices S_b = W(node_b) * Binv_b
	local SM = self.SM
	for b, pb in self.pack.bones do
		local o, m, s = (pb.node - 1) * 12, pb.binv, (b - 1) * 12
		for r = 0, 2 do
			local a0, a1, a2, a3 = W[o + r * 4 + 1], W[o + r * 4 + 2], W[o + r * 4 + 3], W[o + r * 4 + 4]
			SM[s + r * 4 + 1] = a0 * m[1] + a1 * m[5] + a2 * m[9]
			SM[s + r * 4 + 2] = a0 * m[2] + a1 * m[6] + a2 * m[10]
			SM[s + r * 4 + 3] = a0 * m[3] + a1 * m[7] + a2 * m[11]
			SM[s + r * 4 + 4] = a0 * m[4] + a1 * m[8] + a2 * m[12] + a3
		end
	end
end

function ExactAnimator:_evaluate()
	local active, N = self.active, self.N
	local LT, LQ, LS = self.LT, self.LQ, self.LS
	local total, count, only = 0, 0, nil
	for _, st in active do
		if st.weight > 0 then
			total += st.weight
			count += 1
			only = st
		end
	end
	if count == 0 then return false end
	if count == 1 then
		self:_sample(only, LT, LQ, LS)
	else
		local ST, SQ, SS = self.ST, self.SQ, self.SS
		for k = 1, 3 * N do LT[k] = 0; LS[k] = 0 end
		for k = 1, 4 * N do LQ[k] = 0 end
		local first = true
		for _, st in active do
			if st.weight > 0 then
				self:_sample(st, ST, SQ, SS)
				local w = st.weight / total
				for i = 1, N do
					local a, b = 3 * i - 2, 4 * i - 3
					LT[a] += w * ST[a]; LT[a + 1] += w * ST[a + 1]; LT[a + 2] += w * ST[a + 2]
					LS[a] += w * SS[a]; LS[a + 1] += w * SS[a + 1]; LS[a + 2] += w * SS[a + 2]
					local sw = w
					if not first and (LQ[b] * SQ[b] + LQ[b + 1] * SQ[b + 1] + LQ[b + 2] * SQ[b + 2] + LQ[b + 3] * SQ[b + 3]) < 0 then
						sw = -w
					end
					LQ[b] += sw * SQ[b]; LQ[b + 1] += sw * SQ[b + 1]; LQ[b + 2] += sw * SQ[b + 2]; LQ[b + 3] += sw * SQ[b + 3]
				end
				first = false
			end
		end
	end
	self:_compose()
	return true
end

-- worst vertex error (studs) if bone scale/shear were dropped: decides bones vs exact skin
function ExactAnimator:_scaleError(): number
	local W, worst = self.W, 0
	for _, pb in self.pack.bones do
		local o = (pb.node - 1) * 12
		local c0x, c0y, c0z = W[o + 1], W[o + 5], W[o + 9]
		local c1x, c1y, c1z = W[o + 2], W[o + 6], W[o + 10]
		local c2x, c2y, c2z = W[o + 3], W[o + 7], W[o + 11]
		local d = math.max(math.abs(c0x * c0x + c0y * c0y + c0z * c0z - 1), math.abs(c1x * c1x + c1y * c1y + c1z * c1z - 1),
			math.abs(c2x * c2x + c2y * c2y + c2z * c2z - 1), 2 * math.abs(c0x * c1x + c0y * c1y + c0z * c1z),
			2 * math.abs(c0x * c2x + c0y * c2y + c0z * c2z), 2 * math.abs(c1x * c2x + c1y * c2y + c1z * c2z))
		local e = 0.5 * d * pb.radius
		if e > worst then worst = e end
	end
	return worst
end

function ExactAnimator:_applyBones()
	local W, C, A, pack = self.W, self.C, self.A, self.pack
	for _, b in self.boneOrder do
		local o, c = (pack.bones[b].node - 1) * 12, (b - 1) * 12
		local m = table.create(12)
		for r = 0, 2 do
			local w0, w1, w2, w3 = W[o + r * 4 + 1], W[o + r * 4 + 2], W[o + r * 4 + 3], W[o + r * 4 + 4]
			m[r * 4 + 1] = w0 * C[c + 1] + w1 * C[c + 5] + w2 * C[c + 9]
			m[r * 4 + 2] = w0 * C[c + 2] + w1 * C[c + 6] + w2 * C[c + 10]
			m[r * 4 + 3] = w0 * C[c + 3] + w1 * C[c + 7] + w2 * C[c + 11]
			m[r * 4 + 4] = w0 * C[c + 4] + w1 * C[c + 8] + w2 * C[c + 12] + w3
		end
		local cf = CFrame.new(m[4], m[8], m[12], m[1], m[2], m[3], m[5], m[6], m[7], m[9], m[10], m[11]):Orthonormalize()
		A[b] = cf
		local p = self.rigParent[b]
		self.rigBones[b].Transform = self.boneCFInv[b] * (p == 0 and cf or A[p]:ToObjectSpace(cf))
	end
end

function ExactAnimator:_applySkin(skin)
	local SM = self.SM
	local doNormals = self.skinFrame % self.normalsEvery == 0
	self.skinFrame += 1
	for _, s in skin do
		local part, em, vids = s.part, s.em, s.vids
		local pos, bi, bw = part.pos, part.bi, part.bw
		for v = 1, part.nV do
			local x, y, z = pos[3 * v - 2], pos[3 * v - 1], pos[3 * v]
			local ox, oy, oz = 0, 0, 0
			local k = 4 * v - 4
			for j = 1, 4 do
				local w = bw[k + j]
				if w > 0 then
					local o = (bi[k + j] - 1) * 12
					ox += w * (SM[o + 1] * x + SM[o + 2] * y + SM[o + 3] * z + SM[o + 4])
					oy += w * (SM[o + 5] * x + SM[o + 6] * y + SM[o + 7] * z + SM[o + 8])
					oz += w * (SM[o + 9] * x + SM[o + 10] * y + SM[o + 11] * z + SM[o + 12])
				end
			end
			em:SetPosition(vids[v], Vector3.new(ox, oy, oz))
		end
		if doNormals then
			local nrm, nvert, nids = part.nrm, part.nvert, s.nids
			for n = 1, part.nN do
				local k = 4 * nvert[n] - 4
				local x, y, z = nrm[3 * n - 2], nrm[3 * n - 1], nrm[3 * n]
				local ox, oy, oz = 0, 0, 0
				for j = 1, 4 do
					local w = bw[k + j]
					if w > 0 then
						local o = (bi[k + j] - 1) * 12
						ox += w * (SM[o + 1] * x + SM[o + 2] * y + SM[o + 3] * z)
						oy += w * (SM[o + 5] * x + SM[o + 6] * y + SM[o + 7] * z)
						oz += w * (SM[o + 9] * x + SM[o + 10] * y + SM[o + 11] * z)
					end
				end
				local len = math.sqrt(ox * ox + oy * oy + oz * oz)
				if len > 1e-9 then em:SetNormal(nids[n], Vector3.new(ox / len, oy / len, oz / len)) end
			end
		end
	end
end

function ExactAnimator:_setMode(mode: string)
	if mode == self.mode then return end
	self.mode = mode
	local useSkin = mode == "skin"
	if type(self.skin) ~= "table" then return end
	for _, s in self.skin do
		s.mp.Transparency = useSkin and 0 or 1
		if s.rigPart then s.rigPart.Transparency = useSkin and 1 or (self.rigTransparency[s.rigPart] or 0) end
	end
end

function ExactAnimator:_apply()
	local root = self.rigRoot
	if not root or not root.Parent then return end
	self:_applyBones()
	local useSkin = false
	if self.skinEnabled and self:_scaleError() > self.skinTolerance then
		local cam = workspace.CurrentCamera
		useSkin = cam == nil or (cam.CFrame.Position - root.Position).Magnitude <= self.lodDistance
	end
	if useSkin and type(self.skin) == "table" then
		self:_applySkin(self.skin)
		self:_setMode("skin")
	else
		if useSkin and self.skin == nil then task.spawn(self._buildSkin, self) end
		self:_setMode("bones")
	end
end

function ExactAnimator:Step(dt: number)
	self.clock += dt
	local active = self.active
	for i = #active, 1, -1 do
		local st = active[i]
		if st.weight ~= st.target then
			if st.fadeSpeed == HUGE then
				st.weight = st.target
			elseif st.weight < st.target then
				st.weight = math.min(st.target, st.weight + st.fadeSpeed * dt)
			else
				st.weight = math.max(st.target, st.weight - st.fadeSpeed * dt)
			end
		end
		if st.target <= 0 and st.weight <= 0 then
			self:_stop(st)
		else
			local prev = st.time
			st.time = prev + dt * st.speed
			self:_queueEvents(st, prev)
		end
	end
	if self.faceRevertAt > 0 and self.clock >= self.faceRevertAt then
		self.faceRevertAt = 0
		self:SetFace(self.faceDefault)
	end
	if #active > 0 and self:_evaluate() then
		local rn = self.rootNode
		if rn then
			local y = self.LT[3 * rn - 1]
			if self.rootPrevY and math.abs(y) >= 0.1 * self.pack.studs then
				self.rootForward += self.rootPrevY - y
			end
			self.rootPrevY = y
		end
		if not self.headless then self:_apply() end
	end
	for i = #active, 1, -1 do
		if active[i].ended then self:_stop(active[i]) end
	end
	if #self.pending > 0 then
		local pending = self.pending
		self.pending = {}
		for _, p in pending do
			local name, e = p[1], p[2]
			if e.fn == "OnFaceAnimTag" then self:_faceTag(e.data) end
			self.Event:Fire(e.fn, e.data, name, e)
		end
	end
end

-- sample one clip at time t (no blending) into self.SM; used by SelfTest and tools
function ExactAnimator:PoseAt(name: string, t: number)
	local st = { clip = self.pack.clips[name], length = self.pack.clips[name].duration, time = t,
		wrapMode = WrapMode.ClampForever, cursors = {} }
	self:_sample(st, self.LT, self.LQ, self.LS)
	self:_compose()
	if not self.headless then self:_applyBones() end
	return self.SM
end

-- driver ----------------------------------------------------------------------------------------------
local running = {}
local conn
function ExactAnimator:Start()
	running[self] = true
	if not conn then
		local ev = RunService:IsClient() and (RunService.PreRender or RunService.RenderStepped) or RunService.Heartbeat
		conn = ev:Connect(function(dt)
			for a in running do
				local ok, err = pcall(a.Step, a, dt)
				if not ok then
					running[a] = nil
					warn("[SPSO] animator stopped: " .. tostring(err))
				end
			end
		end)
	end
end

function ExactAnimator:Destroy()
	running[self] = nil
	if type(self.skin) == "table" then
		for _, s in self.skin do
			s.mp:Destroy()
			pcall(s.em.Destroy, s.em)
			if s.rigPart then s.rigPart.Transparency = self.rigTransparency[s.rigPart] or 0 end
		end
	end
	self.skin = false
	self.Event._fns = {}
end

-- proves the runtime reproduces the original curves: pack self-tests (off-grid times included) and a
-- signature of every clip, computed offline with the reference evaluator
function ExactAnimator.SelfTest(pack)
	local a = ExactAnimator.new(pack, nil, { headless = true })
	local NB = #pack.bones
	local maxS, maxSig = 0, 0
	for _, t in pack.tests do
		local SM = a:PoseAt(pack.clipList[t.clip].name, t.time)
		for k = 1, NB * 12 do
			local e = math.abs(SM[k] - t.S[k])
			if e > maxS then maxS = e end
		end
	end
	for _, s in pack.sigs do
		local SM = a:PoseAt(pack.clipList[s.clip].name, s.time)
		local sig = 0
		for b = 1, NB do
			for ij = 1, 12 do sig += SM[(b - 1) * 12 + ij] * b * ij end
		end
		local e = math.abs(sig - s.sig) / math.max(1, math.abs(s.sig))
		if e > maxSig then maxSig = e end
	end
	return { maxMatrixError = maxS, maxSignatureError = maxSig, tests = #pack.tests, clips = #pack.sigs }
end

return ExactAnimator
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000002"><Properties><string name="Name">HeroPack</string><ProtectedString name="Source"><![CDATA[--!native
-- SPSO HeroPack: decodes an SPSOHRO1 hero pack (format: roblox-port/tools/spso_hero_pack.py).
-- The pack is stored in the place as base64 chunks (StringValues named 001, 002, ...) under
-- ReplicatedStorage.SPSO.Heroes.<Hero>.Pack, so it works in live servers without HTTP.
-- Curve data stays in the decompressed buffer; only key times and per-key offsets become Luau tables.
local EncodingService = game:GetService("EncodingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local HeroPack = {}
local cache = {}
local DIM = { [0] = 4, [1] = 3, [2] = 3 }
local f32tmp = buffer.create(4)

local function toF32(x: number): number
	buffer.writef32(f32tmp, 0, x)
	return buffer.readf32(f32tmp, 0)
end

function HeroPack.decode(raw: buffer)
	assert(buffer.readstring(raw, 0, 8) == "SPSOHRO1", "not an SPSO hero pack")
	local o = 8
	local function u8() local v = buffer.readu8(raw, o); o += 1; return v end
	local function u16() local v = buffer.readu16(raw, o); o += 2; return v end
	local function i16() local v = buffer.readi16(raw, o); o += 2; return v end
	local function u32() local v = buffer.readu32(raw, o); o += 4; return v end
	local function i32() local v = buffer.readi32(raw, o); o += 4; return v end
	local function f32() local v = buffer.readf32(raw, o); o += 4; return v end
	local function f64() local v = buffer.readf64(raw, o); o += 8; return v end
	local function str() local n = u16(); local s = buffer.readstring(raw, o, n); o += n; return s end
	local function f32s(n) local t = table.create(n); for i = 1, n do t[i] = buffer.readf32(raw, o); o += 4 end; return t end

	local pack = { buf = raw, version = u32(), studs = f32(), hero = str(),
		nodes = {}, nodeIndex = {}, bones = {}, boneIndex = {}, parts = {}, clips = {}, clipList = {}, tests = {}, sigs = {} }
	for i = 1, u16() do
		local n = { name = str(), parent = i16() + 1, t = f32s(3), q = f32s(4), s = f32s(3) }
		pack.nodes[i] = n
		pack.nodeIndex[n.name] = i
	end
	for b = 1, u16() do
		local bone = { node = u16() + 1, binv = f32s(12), radius = f32() }
		bone.name = pack.nodes[bone.node].name
		pack.bones[b] = bone
		pack.boneIndex[bone.name] = b
	end
	for p = 1, u16() do
		local part = { name = str() }
		local nV = u32()
		part.nV = nV
		part.pos = f32s(nV * 3)
		local bi = table.create(nV * 4)
		for k = 1, nV * 4 do bi[k] = buffer.readu8(raw, o) + 1; o += 1 end
		part.bi = bi
		part.bw = f32s(nV * 4)
		local nN = u32()
		part.nN = nN
		part.nvert = table.create(nN)
		part.nrm = table.create(nN * 3)
		for k = 1, nN do
			part.nvert[k] = u32() + 1
			part.nrm[3 * k - 2], part.nrm[3 * k - 1], part.nrm[3 * k] = f32(), f32(), f32()
		end
		part.nUV = u32()
		part.uv = f32s(part.nUV * 2)
		local nT = u32()
		part.nT = nT
		local tri = table.create(nT * 9)
		for k = 1, nT * 9 do tri[k] = buffer.readu32(raw, o) + 1; o += 4 end
		part.tri = tri
		pack.parts[p] = part
	end
	for c = 1, u16() do
		local clip = { index = c, name = str(), duration = f32(), rate = f32(), wrap = u8(), events = {}, curves = {} }
		clip.rootMotion = u8() % 2 == 1
		for e = 1, u16() do
			clip.events[e] = { time = f32(), fn = str(), data = str(), float = f32(), int = i32() }
		end
		table.sort(clip.events, function(a, b) return a.time < b.time end)
		for k = 1, u16() do
			local cv = { node = u16() + 1, kind = u8() }
			local flags = u8()
			local dim = DIM[cv.kind]
			cv.dim = dim
			if flags % 2 == 1 then
				cv.const = f32s(dim)
			else
				local n = u16()
				cv.n = n
				local times = table.create(n)
				if math.floor(flags / 2) % 2 == 1 then
					for i = 1, n do times[i] = toF32(buffer.readu16(raw, o) / clip.rate); o += 2 end
				else
					for i = 1, n do times[i] = buffer.readf32(raw, o); o += 4 end
				end
				cv.times = times
				cv.vOff = o
				o += n * dim * 4
				cv.inOff = o
				o += n * dim * 4
				local outOffs = table.create(n)
				if math.floor(flags / 4) % 2 == 1 then
					local maskOff = o
					o += (n + 7) // 8
					for i = 1, n do
						local byte = buffer.readu8(raw, maskOff + (i - 1) // 8)
						if bit32.btest(byte, bit32.lshift(1, (i - 1) % 8)) then
							outOffs[i] = o
							o += dim * 4
						else
							outOffs[i] = cv.inOff + (i - 1) * dim * 4
						end
					end
				else
					for i = 1, n do outOffs[i] = cv.inOff + (i - 1) * dim * 4 end
				end
				cv.outOffs = outOffs
			end
			clip.curves[k] = cv
		end
		pack.clips[clip.name] = clip
		pack.clipList[c] = clip
	end
	local NB = #pack.bones
	for i = 1, u16() do
		pack.tests[i] = { clip = u16() + 1, time = f32(), S = f32s(NB * 12) }
	end
	for i = 1, u16() do
		pack.sigs[i] = { clip = u16() + 1, time = f32(), sig = f64() }
	end
	assert(o == buffer.len(raw), "pack has trailing bytes")
	return pack
end

-- folder: Folder of StringValues (base64 of the zstd-compressed pack), named in order
function HeroPack.fromFolder(folder: Instance)
	local chunks = {}
	for _, c in folder:GetChildren() do
		if c:IsA("StringValue") then table.insert(chunks, c) end
	end
	table.sort(chunks, function(a, b) return a.Name < b.Name end)
	local parts = table.create(#chunks)
	for i, c in chunks do parts[i] = c.Value end
	local z = EncodingService:Base64Decode(buffer.fromstring(table.concat(parts)))
	return HeroPack.decode(EncodingService:DecompressBuffer(z, Enum.CompressionAlgorithm.Zstd))
end

-- Cached load of ReplicatedStorage.SPSO.Heroes.<hero>.Pack (waits for replication on clients)
function HeroPack.get(hero: string)
	if cache[hero] then return cache[hero] end
	local root = ReplicatedStorage:WaitForChild("SPSO"):WaitForChild("Heroes"):WaitForChild(hero)
	local folder = root:WaitForChild("Pack")
	local expected = folder:GetAttribute("Chunks")
	while expected and #folder:GetChildren() < expected do task.wait() end
	local pack = HeroPack.fromFolder(folder)
	cache[hero] = pack
	return pack
end

return HeroPack
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000027"><Properties><string name="Name">ReplicatedStorage/SPSO/Game</string></Properties><Item class="ModuleScript" referent="RBX000003"><Properties><string name="Name">CharacterAnimator</string><ProtectedString name="Source"><![CDATA[-- Client-side animation for one fighter (player hero or enemy): an ExactAnimator plus
--   * locomotion picked from the character's motion (idle / run with speed scaling / jump up / fall / land),
--     the way the original CharacterMotionController + BehaviorMovement chose clips
--   * actions replicated by the server in the "SPSO_Action" attribute ("clip|serverTime|fade|seq"):
--     attacks, hit reactions, emotes, death; "none" ends the action
--   * root motion of actions applied to the local player's own character (the server moves enemies)
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SPSO = ReplicatedStorage:WaitForChild("SPSO")
local HeroPack = require(SPSO:WaitForChild("Runtime"):WaitForChild("HeroPack"))
local ExactAnimator = require(SPSO.Runtime:WaitForChild("ExactAnimator"))
local Config = require(SPSO:WaitForChild("Game"):WaitForChild("GameConfig"))

local CharacterAnimator = {}
CharacterAnimator.__index = CharacterAnimator

function CharacterAnimator.new(model: Model, opts)
	opts = opts or {}
	local heroName = model:GetAttribute("SPSO_Hero") or Config.PlayerHero
	local cfg = Config.Heroes[heroName] or Config.Heroes[Config.PlayerHero]
	local self = setmetatable({}, CharacterAnimator)
	self.model, self.cfg, self.isLocal = model, cfg, opts.isLocal == true
	self.humanoid = model:FindFirstChildOfClass("Humanoid")
	self.hrp = model:FindFirstChild("HumanoidRootPart")
	self.anim = ExactAnimator.new(HeroPack.get(cfg.pack), model, {
		wrapModes = cfg.wrapModes,
		faceTextures = opts.faces ~= false and cfg.faceTextures or nil,
		headPart = cfg.headPart,
		skin = opts.skin ~= false,
		prebuildSkin = opts.prebuildSkin,
		lodDistance = opts.lodDistance or 120,
	})
	self.action, self.actionSeq, self.loco = nil, nil, nil
	self.airTime, self.landLock = 0, 0
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { model }
	params.IgnoreWater = true
	self.rayParams = params
	self:_loco("movement_idle", 0)
	self.conns = {
		model:GetAttributeChangedSignal("SPSO_Action"):Connect(function() self:_onAction() end),
	}
	self:_onAction()
	return self
end

function CharacterAnimator:_onAction()
	local s = self.model:GetAttribute("SPSO_Action")
	if type(s) ~= "string" then return end
	local clip, t0, fade, seq = string.match(s, "^([^|]+)|([^|]+)|([^|]+)|([^|]+)$")
	if not clip or seq == self.actionSeq then return end
	self.actionSeq = seq
	if clip == "none" then
		self.action = nil
		return
	end
	local anim = self.anim
	if not anim:HasClip(clip) then return end
	if anim:IsPlaying(clip) then anim:Stop(clip) end
	anim:CrossFade(clip, tonumber(fade) or 0.1)
	local late = workspace:GetServerTimeNow() - (tonumber(t0) or 0)
	if late > 0 and late < 0.3 then anim:GetState(clip).time = late end
	self.action, self.loco = clip, nil
end

function CharacterAnimator:_loco(name: string, fade: number)
	if self.loco == name and self.anim:IsPlaying(name) then return end
	self.loco = name
	self.anim:CrossFade(name, fade)
end

function CharacterAnimator:_locomotion(dt: number)
	local hrp, hum, anim = self.hrp, self.humanoid, self.anim
	local v = hrp.AssemblyLinearVelocity
	local horiz = math.sqrt(v.X * v.X + v.Z * v.Z)
	local grounded
	if self.isLocal and hum then
		grounded = hum.FloorMaterial ~= Enum.Material.Air
	else
		local depth = hrp.Size.Y / 2 + (hum and hum.HipHeight or 2) + 0.7
		grounded = workspace:Raycast(hrp.Position, Vector3.new(0, -depth, 0), self.rayParams) ~= nil
	end
	if not grounded then
		self.airTime += dt
		if self.airTime > 0.12 then
			if v.Y > 1 then
				if self.loco ~= "jump_up" and self.loco ~= "jump_run_up" then
					self:_loco(horiz > 6 and "jump_run_up" or "jump_up", 0.1)
				end
			else
				local cur = self.loco
				if cur == "jump_fall" or cur == "jump_run_fall" then
					local st = anim:GetState(cur)
					if st.time >= st.length then self:_loco("jump_fall_loop", 0.2) end
				elseif cur ~= "jump_fall_loop" then
					self:_loco(horiz > 6 and "jump_run_fall" or "jump_fall", 0.2)
				end
			end
		end
		return
	end
	if self.airTime > 0.3 then
		self:_loco(horiz > 6 and "jump_run_land" or "jump_land", 0.08)
		self.landLock = 0.22
	end
	self.airTime = 0
	if self.landLock > 0 then
		self.landLock -= dt
		return
	end
	if horiz > 2.5 then
		self:_loco("movement_run", 0.2)
		anim:GetState("movement_run").speed = math.clamp(horiz / self.cfg.runAnimSpeed, 0.5, 1.6)
	else
		self:_loco("movement_idle", 0.3)
	end
end

function CharacterAnimator:Update(dt: number)
	local hrp = self.hrp
	if not hrp or not hrp.Parent then return end
	local anim = self.anim
	if self.action then
		local st = anim:GetState(self.action)
		if not st.enabled then
			self.action = nil -- a Once clip finished; ClampForever actions hold until the server ends them
		end
	end
	if not self.action and not self.model:GetAttribute("SPSO_Dead") then
		self:_locomotion(dt)
	end
	anim:Step(dt)
	local d = anim:ConsumeRootMotion()
	if self.isLocal and self.action and d ~= 0 then
		local clip = anim.pack.clips[self.action]
		if clip and clip.rootMotion then hrp.CFrame += hrp.CFrame.LookVector * d end
	end
end

function CharacterAnimator:Current(): string?
	return self.action
end

function CharacterAnimator:Destroy()
	for _, c in self.conns do c:Disconnect() end
	self.anim:Destroy()
end

return CharacterAnimator
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000004"><Properties><string name="Name">GameConfig</string><ProtectedString name="Source"><![CDATA[-- SPSO brawler tuning. Clip names, timings and events come from the original game's animations;
-- the numbers here (speeds, damage, waves) are the Roblox port's tuning.
local WM = { Once = 1, Loop = 2, PingPong = 4, ClampForever = 8 }

local Config = {}

Config.Map = "OrbitalArena"
Config.PlayerHero = "ElRugido"

Config.Heroes = {
	ElRugido = {
		displayName = "El Rugido",
		pack = "ElRugido",
		template = "Hero_ElRugido", -- ServerStorage.SPSO.Characters
		headPart = "ElRugido_Head",
		bodyPart = "ElRugido_Body",
		-- the 8 FacialAnimation expressions (Normal, Happy, Surprised, Aggressive, Squint, Blink, Custom1, Custom2)
		-- (tile 0 uses the model's own head texture, which is the same image)
		faceTextures = {
			"rbxassetid://95009761023746", "rbxassetid://87813758884419", "rbxassetid://129014191028706",
			"rbxassetid://80712657085550", "rbxassetid://125458260096839", "rbxassetid://121373604073448",
			"rbxassetid://123655553866245", "rbxassetid://126536608314547",
		},
		-- wrap modes the original CharacterMotionController / behaviours set
		wrapModes = {
			movement_idle = WM.Loop, movement_run = WM.Loop, pickup_idle = WM.Loop, pickup_run = WM.Loop,
			jump_fall_loop = WM.Loop, sit_idle = WM.Loop, emote_manipulate_loop = WM.Loop,
			jump_up = WM.ClampForever, jump_run_up = WM.ClampForever, jump_fall = WM.ClampForever,
			jump_run_fall = WM.ClampForever, jump_land = WM.ClampForever, jump_run_land = WM.ClampForever,
			recoil_death = WM.ClampForever, recoil_launch = WM.ClampForever, pickup = WM.ClampForever,
		},
		walkSpeed = 24, -- studs/s
		runAnimSpeed = 24, -- movement_run plays at 1x at this speed (scaled like the original)
		jumpPower = 62,
		health = 1000,
	},
}

-- chains: OnChainAttackAnimTag opens the window for the next attack (BehaviorAttackBase)
Config.Chains = {
	L = { "attack_L1", "attack_L2", "attack_L3", "attack_L4", "attack_L5" },
	R = { "attack_R1", "attack_R2", "attack_R3" },
	Super = { "attack_super" },
}

-- damage and the reaction the target plays
Config.Attacks = {
	attack_L1 = { damage = 32, reaction = "small" },
	attack_L2 = { damage = 36, reaction = "small" },
	attack_L3 = { damage = 44, reaction = "small" },
	attack_L4 = { damage = 56, reaction = "big" },
	attack_L5 = { damage = 90, reaction = "launch" },
	attack_R1 = { damage = 70, reaction = "big" },
	attack_R2 = { damage = 80, reaction = "big" },
	attack_R3 = { damage = 110, reaction = "launch" },
	attack_super = { damage = 240, reaction = "launch", radius = 20 },
	power_emote_1 = { damage = 180, reaction = "launch", radius = 18 },
}
Config.Reach = 9.5 -- studs from the attacker's root, plus the target's radius
Config.TargetRadius = 2
Config.Arc = 150 -- degrees in front of the attacker
Config.PowerPerHit = 8
Config.SuperCost = 100
Config.FadeAttack = 0.1
Config.FadeRecoil = 0.05
Config.HeroStunImmunity = 1.0 -- seconds after a hero recoil during which hits only deal damage
Config.RecoilCancel = 0.25 -- a hero can attack out of a small/big recoil after this many seconds

Config.Enemy = {
	name = "Rival Luchador",
	health = 260,
	damageScale = 0.32,
	walkSpeed = 15,
	attackRange = 8.5,
	attacks = { "attack_L1", "attack_L2", "attack_R1" },
	cooldown = { 2.0, 3.6 },
	maxAttackers = 2, -- enemies swinging at the same time
	waitAfterHeroHit = 0.7, -- don't pile onto a hero that was just hit
	thinkRate = 0.12,
	despawnAfter = 3.5,
}

-- enemy costume variants: recolored El Rugido textures (tools/recolor_variants.py, uploaded as images)
Config.Variants = {
	{ name = "Azul", body = "rbxassetid://70368986942892", head = "rbxassetid://123547823862723" },
	{ name = "Verde", body = "rbxassetid://74383374415269", head = "rbxassetid://131632527789308" },
	{ name = "Morado", body = "rbxassetid://126193897515330", head = "rbxassetid://78351291351379" },
	{ name = "Negro", body = "rbxassetid://73001122951843", head = "rbxassetid://133342632575321" },
}

Config.Waves = { 2, 3, 4, 5, 6 }
Config.WaveBreak = 3
Config.RespawnTime = 4

Config.Emotes = { "emote_taunt", "emote_cheer", "emote_laugh", "emote_dance" }

-- camera: fixed angle like the original brawler camera, facing the arena's back wall (-Z)
Config.Camera = { offset = Vector3.new(0, 21, 27), lookHeight = 3.5, fov = 55, zoomMin = 0.6, zoomMax = 1.6 }

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000005"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[-- Remote events shared by server and clients (created by the server under ReplicatedStorage.SPSO.Remotes)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}
local folder

local function getFolder()
	if folder then return folder end
	local spso = ReplicatedStorage:WaitForChild("SPSO")
	if RunService:IsServer() then
		folder = spso:FindFirstChild("Remotes")
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = "Remotes"
			folder.Parent = spso
		end
	else
		folder = spso:WaitForChild("Remotes")
	end
	return folder
end

function Net.event(name: string): RemoteEvent
	local f = getFolder()
	local e = f:FindFirstChild(name)
	if not e then
		if RunService:IsServer() then
			e = Instance.new("RemoteEvent")
			e.Name = name
			e.Parent = f
		else
			e = f:WaitForChild(name)
		end
	end
	return e
end

return Net
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000028"><Properties><string name="Name">ServerScriptService/SPSO</string></Properties><Item class="Script" referent="RBX000006"><Properties><string name="Name">Brawler</string><ProtectedString name="Source"><![CDATA[-- SPSO brawler server: heroes and enemies as "fighters", the original attack chains and hit windows
-- (timed by the clips' own AnimationEvents through headless ExactAnimators), hit reactions,
-- enemy AI, waves, power meter. Clients animate every fighter from the replicated "SPSO_Action".
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local SPSO = ReplicatedStorage:WaitForChild("SPSO")
local Config = require(SPSO:WaitForChild("Game"):WaitForChild("GameConfig"))
local Net = require(SPSO.Game:WaitForChild("Net"))
local HeroPack = require(SPSO:WaitForChild("Runtime"):WaitForChild("HeroPack"))
local ExactAnimator = require(SPSO.Runtime:WaitForChild("ExactAnimator"))

local AttackRemote, EmoteRemote, FxRemote = Net.event("Attack"), Net.event("Emote"), Net.event("Fx")
local heroCfg = Config.Heroes[Config.PlayerHero]
local pack = HeroPack.get(heroCfg.pack)
Players.RespawnTime = Config.RespawnTime

local arena = workspace:WaitForChild(Config.Map, 30)
local spawns = arena and arena:FindFirstChild("Spawns")
local enemyFolder = workspace:FindFirstChild("SPSO_Enemies") or Instance.new("Folder")
enemyFolder.Name = "SPSO_Enemies"
enemyFolder.Parent = workspace

local fighters = {}
local seq = 0
local now = os.clock

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function spawnPoint(prefix: string, i: number): CFrame
	local pts = {}
	if spawns then
		for _, p in spawns:GetChildren() do
			if p:IsA("BasePart") and string.sub(p.Name, 1, #prefix) == prefix then table.insert(pts, p) end
		end
		table.sort(pts, function(a, b) return a.Name < b.Name end)
	end
	if #pts == 0 then return CFrame.new(0, 6, prefix == "Player" and 25 or -25) end
	return pts[(i - 1) % #pts + 1].CFrame
end

local Fighter = {}
Fighter.__index = Fighter

function Fighter.new(model: Model, team: string, player: Player?)
	local f = setmetatable({}, Fighter)
	f.model, f.team, f.player = model, team, player
	f.hum = model:FindFirstChildOfClass("Humanoid")
	f.hrp = model:FindFirstChild("HumanoidRootPart")
	f.power = 0
	f.chainKind, f.chainIndex, f.chainOpen, f.buffered, f.rIndex = nil, 0, false, nil, 0
	f.hitOpen, f.hitSet = false, {}
	f.action, f.actionKind = nil, nil
	f.dead = false
	f.nextThink, f.nextAttack, f.launchAt = 0, now() + 1.5, nil
	f.actionStart, f.stunImmuneUntil, f.lastHitAt = 0, 0, 0
	f.anim = ExactAnimator.new(pack, nil, { headless = true, wrapModes = heroCfg.wrapModes })
	f.anim.Event:Connect(function(fn, data, clip) f:onEvent(fn, data, clip) end)
	model:SetAttribute("SPSO_Hero", heroCfg.pack)
	model:SetAttribute("SPSO_Team", team)
	model:SetAttribute("SPSO_Dead", false)
	model:SetAttribute("SPSO_Lock", false)
	CollectionService:AddTag(model, "SPSO_Fighter")
	fighters[model] = f
	return f
end

function Fighter:play(clip: string, fade: number, kind: string)
	seq += 1
	local anim = self.anim
	if anim:IsPlaying(clip) then anim:Stop(clip) end
	anim:CrossFade(clip, fade)
	self.action, self.actionKind = clip, kind
	self.actionStart = now()
	self.hitOpen, self.chainOpen, self.hitSet = false, false, {}
	self.model:SetAttribute("SPSO_Action", string.format("%s|%.4f|%.3f|%d", clip, workspace:GetServerTimeNow(), fade, seq))
	self.model:SetAttribute("SPSO_Lock", kind ~= "emote")
end

function Fighter:clear()
	seq += 1
	self.action, self.actionKind = nil, nil
	self.chainKind, self.chainIndex, self.chainOpen = nil, 0, false
	self.hitOpen, self.launchAt = false, nil
	self.anim:Stop()
	self.model:SetAttribute("SPSO_Action", string.format("none|%.4f|0.2|%d", workspace:GetServerTimeNow(), seq))
	self.model:SetAttribute("SPSO_Lock", false)
end

function Fighter:addPower(n: number)
	self.power = math.clamp(self.power + n, 0, Config.SuperCost)
	if self.player then self.player:SetAttribute("SPSO_Power", self.power) end
end

function Fighter:onEvent(fn: string, _data: string, clip: string)
	if clip ~= self.action then return end
	if fn == "OnCollisionEnableAnimTag" then
		self.hitOpen, self.hitSet = true, {}
	elseif fn == "OnCollisionDisableAnimTag" then
		self.hitOpen = false
	elseif fn == "OnChainAttackAnimTag" and not self.chainOpen then
		self.chainOpen = true
		if self.buffered then
			local k = self.buffered
			self.buffered = nil
			self:tryAttack(k)
		end
	end
end

function Fighter:tryAttack(kind: string)
	if self.dead or self.actionKind == "death" then return end
	if self.actionKind == "recoil" then
		-- heroes can fight out of a small/big recoil (not out of a launch)
		local cancel = self.team == "Hero" and (self.action == "recoil_small" or self.action == "recoil_big")
			and now() - self.actionStart >= Config.RecoilCancel
		if not cancel then return end
		self:clear()
	end
	local busy = self.actionKind == "attack"
	if busy and not self.chainOpen then
		self.buffered = kind
		return
	end
	if kind == "Super" then
		if self.team == "Hero" and self.power < Config.SuperCost then return end
		self:addPower(-Config.SuperCost)
		self.chainKind, self.chainIndex = "Super", 1
		self:play(Config.Chains.Super[1], Config.FadeAttack, "attack")
		return
	end
	local chain = Config.Chains[kind]
	if not chain then return end
	local idx
	if kind == "R" then
		self.rIndex = self.rIndex % #chain + 1
		idx = self.rIndex
	elseif busy and self.chainKind == "L" then
		idx = self.chainIndex + 1
	else
		idx = 1
	end
	if not chain[idx] then return end
	self.chainKind, self.chainIndex = kind, idx
	self:play(chain[idx], Config.FadeAttack, "attack")
end

local function knockback(target, attacker, back: number, up: number)
	if target.team ~= "Enemy" or not target.hrp then return end
	local dir = attacker and attacker.hrp and flat(target.hrp.Position - attacker.hrp.Position) or Vector3.zero
	dir = dir.Magnitude > 0.1 and dir.Unit or -target.hrp.CFrame.LookVector
	target.hum:ChangeState(Enum.HumanoidStateType.Freefall)
	target.hrp.AssemblyLinearVelocity = dir * back + Vector3.new(0, up, 0)
end

local function enemiesLeft(): number
	local n = 0
	for _, f in fighters do
		if f.team == "Enemy" and not f.dead then n += 1 end
	end
	return n
end

function Fighter:die(attacker, data)
	if self.dead then return end
	self.dead = true
	self.buffered = nil
	self.model:SetAttribute("SPSO_Dead", true)
	if self.team == "Enemy" then
		SPSO:SetAttribute("EnemiesLeft", enemiesLeft())
		if data and data.reaction == "launch" then
			knockback(self, attacker, 30, 42)
			self:play("recoil_launch", Config.FadeRecoil, "death")
			task.delay(0.75, function()
				if self.model.Parent then self:play("recoil_launch_land", 0.05, "death") end
			end)
		else
			self:play("recoil_death", Config.FadeRecoil, "death")
		end
		task.delay(Config.Enemy.despawnAfter, function()
			fighters[self.model] = nil
			self.model:Destroy()
		end)
	else
		self:play("recoil_death", Config.FadeRecoil, "death")
		if self.hrp then self.hrp.Anchored = true end
	end
end

function Fighter:takeHit(attacker, data)
	if self.dead then return end
	local dmg = data.damage * (attacker.team == "Enemy" and Config.Enemy.damageScale or 1)
	self.hum.Health = math.max(0, self.hum.Health - dmg)
	if attacker.team == "Hero" then attacker:addPower(Config.PowerPerHit) end
	FxRemote:FireAllClients("hit", {
		pos = self.hrp.Position + Vector3.new(0, 4, 0), amount = math.floor(dmg + 0.5),
		heavy = data.reaction ~= "small", team = self.team,
	})
	if self.team == "Enemy" and attacker.hrp then
		local dir = flat(attacker.hrp.Position - self.hrp.Position)
		if dir.Magnitude > 0.1 then self.hrp.CFrame = CFrame.lookAt(self.hrp.Position, self.hrp.Position + dir) end
	end
	if self.hum.Health <= 0 then
		self:die(attacker, data)
		return
	end
	self.lastHitAt = now()
	if self.team == "Hero" then
		if now() < self.stunImmuneUntil then return end -- damage only while recovering
		self.stunImmuneUntil = now() + Config.HeroStunImmunity
	end
	self.buffered = nil
	local reaction = data.reaction
	if self.team == "Hero" and reaction == "launch" then reaction = "big" end
	if reaction == "launch" then
		self:play("recoil_launch", Config.FadeRecoil, "recoil")
		self.launchAt = now()
		knockback(self, attacker, 26, 38)
	else
		self:play(reaction == "big" and "recoil_big" or "recoil_small", Config.FadeRecoil, "recoil")
	end
	if self.team == "Enemy" then self.nextAttack = math.max(self.nextAttack, now() + 0.9) end
end

function Fighter:checkHits()
	local data = Config.Attacks[self.action]
	if not data or not self.hrp then return end
	local pos, look = self.hrp.Position, flat(self.hrp.CFrame.LookVector).Unit
	local cosArc = math.cos(math.rad(Config.Arc / 2))
	for _, t in fighters do
		if t ~= self and t.team ~= self.team and not t.dead and not self.hitSet[t] and t.hrp and t.hrp.Parent then
			local off = flat(t.hrp.Position - pos)
			local dist = off.Magnitude
			local hit
			if data.radius then
				hit = dist <= data.radius + Config.TargetRadius
			else
				hit = dist <= Config.Reach + Config.TargetRadius and (dist < 3 or look:Dot(off.Unit) >= cosArc)
			end
			if hit and math.abs(t.hrp.Position.Y - pos.Y) < 9 then
				self.hitSet[t] = true
				t:takeHit(self, data)
			end
		end
	end
end

function Fighter:onActionEnd()
	local clip, kind = self.action, self.actionKind
	if kind == "death" then return end
	if clip == "recoil_launch_land" then
		self:play("recoil_getup", 0.1, "recoil")
		return
	end
	local b = self.buffered
	self.buffered = nil
	self:clear()
	if b then self:tryAttack(b) end
end

function Fighter:think()
	local t = now()
	if self.dead or t < self.nextThink then return end
	self.nextThink = t + Config.Enemy.thinkRate
	if self.action then
		self.hum.WalkSpeed = 0
		return
	end
	self.hum.WalkSpeed = Config.Enemy.walkSpeed
	local best, bd
	for _, o in fighters do
		if o.team == "Hero" and not o.dead and o.hrp and o.hrp.Parent then
			local d = flat(o.hrp.Position - self.hrp.Position).Magnitude
			if not bd or d < bd then best, bd = o, d end
		end
	end
	if not best then
		self.hum:Move(Vector3.zero)
		return
	end
	local dir = flat(best.hrp.Position - self.hrp.Position)
	if bd > Config.Enemy.attackRange then
		-- keep a little spacing between enemies
		local push = Vector3.zero
		for _, o in fighters do
			if o ~= self and o.team == "Enemy" and not o.dead and o.hrp then
				local away = flat(self.hrp.Position - o.hrp.Position)
				if away.Magnitude < 6 and away.Magnitude > 0.01 then push += away.Unit * (6 - away.Magnitude) end
			end
		end
		self.hum:MoveTo(best.hrp.Position - dir.Unit * (Config.Enemy.attackRange * 0.7) + push)
	else
		self.hum:Move(Vector3.zero)
		self.hrp.CFrame = CFrame.lookAt(self.hrp.Position, self.hrp.Position + dir)
		local swinging = 0
		for _, o in fighters do
			if o.team == "Enemy" and o.actionKind == "attack" then swinging += 1 end
		end
		if t >= self.nextAttack and swinging < Config.Enemy.maxAttackers and t - best.lastHitAt > Config.Enemy.waitAfterHeroHit then
			local list = Config.Enemy.attacks
			self:play(list[math.random(#list)], Config.FadeAttack, "attack")
			local c = Config.Enemy.cooldown
			self.nextAttack = t + c[1] + math.random() * (c[2] - c[1])
		end
	end
end

RunService.Heartbeat:Connect(function(dt)
	for model, f in fighters do
		if not model.Parent then
			fighters[model] = nil
			continue
		end
		f.anim:Step(dt)
		local d = f.anim:ConsumeRootMotion()
		if f.team == "Enemy" and f.action and d ~= 0 and f.hrp then
			local clip = pack.clips[f.action]
			if clip and clip.rootMotion then f.hrp.CFrame += f.hrp.CFrame.LookVector * d end
		end
		if f.action == "recoil_launch" and f.launchAt and not f.dead and now() - f.launchAt > 0.75 then
			f.launchAt = nil
			f:play("recoil_launch_land", 0.05, "recoil")
		elseif f.action and not f.anim:IsPlaying(f.action) then
			f:onActionEnd()
		end
		if f.hitOpen then f:checkHits() end
		if f.team == "Enemy" then f:think() end
	end
end)

-- players ---------------------------------------------------------------------------------------------
local function setupCharacter(player: Player, char: Model)
	local hum = char:WaitForChild("Humanoid") :: Humanoid
	char:WaitForChild("HumanoidRootPart")
	hum.MaxHealth, hum.Health = heroCfg.health, heroCfg.health
	hum.BreakJointsOnDeath = false
	hum.WalkSpeed = heroCfg.walkSpeed
	hum.UseJumpPower = true
	hum.JumpPower = heroCfg.jumpPower
	char:PivotTo(spawnPoint("Player", player.UserId % 4 + 1) + Vector3.new(0, 4, 0))
	local f = Fighter.new(char, "Hero", player)
	f.power = player:GetAttribute("SPSO_Power") or 0
	hum.Died:Connect(function() f:die(nil, nil) end)
end

local function onPlayer(player: Player)
	player:SetAttribute("SPSO_Power", player:GetAttribute("SPSO_Power") or 0)
	player.CharacterAdded:Connect(function(c) setupCharacter(player, c) end)
	if player.Character then setupCharacter(player, player.Character) end
end
Players.PlayerAdded:Connect(onPlayer)
for _, p in Players:GetPlayers() do task.spawn(onPlayer, p) end

AttackRemote.OnServerEvent:Connect(function(player, kind)
	local f = player.Character and fighters[player.Character]
	if f and (kind == "L" or kind == "R" or kind == "Super") then f:tryAttack(kind) end
end)

EmoteRemote.OnServerEvent:Connect(function(player, idx)
	local f = player.Character and fighters[player.Character]
	if not f or f.dead or type(idx) ~= "number" then return end
	if idx == 0 then
		if f.actionKind == "emote" then f:clear() end
	elseif not f.action and Config.Emotes[idx] then
		f:play(Config.Emotes[idx], 0.25, "emote")
	end
end)

-- enemies and waves ---------------------------------------------------------------------------------
local function spawnEnemy(i: number)
	local template = ServerStorage.SPSO.Characters:FindFirstChild("Enemy_Luchador")
	if not template then return end
	local e = template:Clone()
	local variant = Config.Variants[(i - 1) % #Config.Variants + 1]
	e.Name = Config.Enemy.name .. " " .. variant.name
	e:SetAttribute("SPSO_Variant", variant.name)
	local body = e:FindFirstChild(heroCfg.bodyPart, true)
	local head = e:FindFirstChild(heroCfg.headPart, true)
	if body and variant.body then body.TextureID = variant.body end
	if head and variant.head then head.TextureID = variant.head end
	local hum = e:FindFirstChildOfClass("Humanoid")
	hum.MaxHealth, hum.Health = Config.Enemy.health, Config.Enemy.health
	hum.BreakJointsOnDeath = false
	hum.WalkSpeed = Config.Enemy.walkSpeed
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	e:PivotTo(spawnPoint("Enemy", i) + Vector3.new(math.random() * 4 - 2, 4, math.random() * 4 - 2))
	e.Parent = enemyFolder
	e.HumanoidRootPart:SetNetworkOwner(nil)
	local f = Fighter.new(e, "Enemy", nil)
	f.nextAttack = now() + 1.2 + math.random() * 1.5
	hum.Died:Connect(function() f:die(nil, nil) end)
end

local function banner(text: string)
	SPSO:SetAttribute("Banner", text)
	SPSO:SetAttribute("BannerSeq", (SPSO:GetAttribute("BannerSeq") or 0) + 1)
end

local function heroAlive(): boolean
	for _, f in fighters do
		if f.team == "Hero" and not f.dead then return true end
	end
	return false
end

task.spawn(function()
	SPSO:SetAttribute("Waves", #Config.Waves)
	while true do
		repeat task.wait(1) until heroAlive()
		for w, count in Config.Waves do
			SPSO:SetAttribute("Wave", w)
			banner("WAVE " .. w)
			task.wait(2.5)
			for i = 1, count do
				spawnEnemy(i + w)
				task.wait(0.35)
			end
			SPSO:SetAttribute("EnemiesLeft", enemiesLeft())
			repeat task.wait(0.5) until enemiesLeft() == 0
			task.wait(Config.WaveBreak)
		end
		banner("VICTORY!")
		for _, f in fighters do
			if f.team == "Hero" and not f.dead and not f.action then f:play("emote_victory", 0.25, "emote") end
		end
		task.wait(8)
		for _, f in fighters do
			if f.team == "Hero" and not f.dead then f.hum.Health = f.hum.MaxHealth end
		end
	end
end)
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000029"><Properties><string name="Name">StarterPlayer/StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX000007"><Properties><string name="Name">BrawlerClient</string><ProtectedString name="Source"><![CDATA[-- SPSO brawler client: animates every fighter with the exact animation runtime, the original
-- brawler-style fixed camera, input (attacks, super, emotes), HUD, hit effects.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local SPSO = ReplicatedStorage:WaitForChild("SPSO")
local Game = SPSO:WaitForChild("Game")
local Config = require(Game:WaitForChild("GameConfig"))
local Net = require(Game:WaitForChild("Net"))
local CharacterAnimator = require(Game:WaitForChild("CharacterAnimator"))

local player = Players.LocalPlayer
local AttackRemote, EmoteRemote, FxRemote = Net.event("Attack"), Net.event("Emote"), Net.event("Fx")
local heroCfg = Config.Heroes[Config.PlayerHero]

-- animators for every fighter ----------------------------------------------------------------------------
local animators = {}
local healthBars = {}

local function makeHealthBar(model: Model)
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local bb = Instance.new("BillboardGui")
	bb.Name = "SPSO_Health"
	bb.Size = UDim2.fromOffset(90, 10)
	bb.StudsOffset = Vector3.new(0, 5.6, 0)
	bb.AlwaysOnTop = true
	bb.Adornee = hrp
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.fromRGB(25, 20, 30)
	bg.BorderSizePixel = 0
	bg.Parent = bb
	Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 4)
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(235, 70, 70)
	fill.BorderSizePixel = 0
	fill.Parent = bg
	Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 4)
	bb.Parent = player:WaitForChild("PlayerGui")
	healthBars[model] = { gui = bb, fill = fill }
end

local function attach(model: Instance)
	if not model:IsA("Model") or animators[model] then return end
	animators[model] = "pending"
	task.spawn(function()
		local root = model:WaitForChild("RootPart", 10)
		local hrp = model:WaitForChild("HumanoidRootPart", 10)
		if not root or not hrp then
			animators[model] = nil
			return
		end
		local t0 = os.clock()
		while #root:GetDescendants() < 39 and os.clock() - t0 < 10 do task.wait() end
		local isLocal = model == player.Character
		local variant = model:GetAttribute("SPSO_Variant")
		local enemy = model:GetAttribute("SPSO_Team") == "Enemy"
		local ok, ca = pcall(CharacterAnimator.new, model, {
			-- exact bone-scale skinning (EditableMesh) for the local hero; others use the bones (memory budget)
			isLocal = isLocal, skin = isLocal, prebuildSkin = isLocal,
			faces = not (variant and variant ~= ""), lodDistance = 300,
		})
		if not ok then
			warn("[SPSO] animator failed for " .. model:GetFullName() .. ": " .. tostring(ca))
			animators[model] = nil
			return
		end
		if not model.Parent then
			ca:Destroy()
			animators[model] = nil
			return
		end
		animators[model] = ca
		if enemy then makeHealthBar(model) end
	end)
end

local function detach(model: Instance)
	local ca = animators[model]
	if type(ca) == "table" then ca:Destroy() end
	animators[model] = nil
	local hb = healthBars[model]
	if hb then hb.gui:Destroy() end
	healthBars[model] = nil
end

CollectionService:GetInstanceAddedSignal("SPSO_Fighter"):Connect(attach)
CollectionService:GetInstanceRemovedSignal("SPSO_Fighter"):Connect(detach)
for _, m in CollectionService:GetTagged("SPSO_Fighter") do attach(m) end

-- camera ----------------------------------------------------------------------------------------------------
local camera = workspace.CurrentCamera
local zoom, camFocus, shake = 1, nil, 0
UserInputService.InputChanged:Connect(function(input, gp)
	if not gp and input.UserInputType == Enum.UserInputType.MouseWheel then
		zoom = math.clamp(zoom - input.Position.Z * 0.08, Config.Camera.zoomMin, Config.Camera.zoomMax)
	end
end)

local function updateCamera(dt: number)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	camera.CameraType = Enum.CameraType.Scriptable
	local focus = hrp.Position * Vector3.new(1, 0, 1) + Vector3.new(0, hrp.Position.Y - 3.3 + Config.Camera.lookHeight, 0)
	camFocus = camFocus and camFocus:Lerp(focus, 1 - math.exp(-7 * dt)) or focus
	local jitter = Vector3.zero
	if shake > 0 then
		shake = math.max(0, shake - dt * 2.5)
		jitter = Vector3.new(math.random() - 0.5, math.random() - 0.5, 0) * shake
	end
	camera.FieldOfView = Config.Camera.fov
	camera.CFrame = CFrame.lookAt(camFocus + Config.Camera.offset * zoom + jitter, camFocus + jitter * 0.5)
end

-- movement lock during actions, emote cancel by moving ------------------------------------------------------
local function updateLocal()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	local locked = char:GetAttribute("SPSO_Lock") == true or char:GetAttribute("SPSO_Dead") == true
	hum.WalkSpeed = locked and 0 or heroCfg.walkSpeed
	hum.UseJumpPower = true
	hum.JumpPower = locked and 0 or heroCfg.jumpPower
	hum.AutoRotate = not locked
	local ca = animators[char]
	if type(ca) == "table" and ca:Current() and string.sub(ca:Current(), 1, 6) == "emote_" and hum.MoveDirection.Magnitude > 0.1 then
		EmoteRemote:FireServer(0)
	end
end

-- input ----------------------------------------------------------------------------------------------------
local function faceNearestEnemy()
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp or char:GetAttribute("SPSO_Lock") then return end
	local best, bd = nil, 16
	for m in animators do
		if m:GetAttribute("SPSO_Team") == "Enemy" and not m:GetAttribute("SPSO_Dead") and m.PrimaryPart then
			local d = (m.PrimaryPart.Position - hrp.Position).Magnitude
			if d < bd then best, bd = m.PrimaryPart, d end
		end
	end
	if best then
		local dir = (best.Position - hrp.Position) * Vector3.new(1, 0, 1)
		if dir.Magnitude > 0.1 then hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + dir) end
	end
end

local function bind(name: string, kind: string, ...)
	ContextActionService:BindAction(name, function(_, state)
		if state == Enum.UserInputState.Begin then
			faceNearestEnemy()
			AttackRemote:FireServer(kind)
		end
		return Enum.ContextActionResult.Sink
	end, true, ...)
	ContextActionService:SetTitle(name, kind == "Super" and "SUPER" or kind)
end
bind("SPSO_L", "L", Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonX)
bind("SPSO_R", "R", Enum.UserInputType.MouseButton2, Enum.KeyCode.ButtonY)
bind("SPSO_Super", "Super", Enum.KeyCode.F, Enum.KeyCode.ButtonB)
UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	local keys = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four }
	local i = table.find(keys, input.KeyCode)
	if i then EmoteRemote:FireServer(i) end
end)

-- HUD ------------------------------------------------------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "SPSO_HUD"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = player:WaitForChild("PlayerGui")

local function label(parent, text, size, pos, ts, color)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size, l.Position = size, pos
	l.Font = Enum.Font.FredokaOne
	l.Text, l.TextSize = text, ts
	l.TextColor3 = color or Color3.new(1, 1, 1)
	l.TextStrokeTransparency = 0.4
	l.Parent = parent
	return l
end

local function bar(parent, y, color)
	local bg = Instance.new("Frame")
	bg.Size, bg.Position = UDim2.new(1, -24, 0, 16), UDim2.fromOffset(12, y)
	bg.BackgroundColor3 = Color3.fromRGB(20, 24, 40)
	bg.BorderSizePixel = 0
	bg.Parent = parent
	Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 6)
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = color
	fill.BorderSizePixel = 0
	fill.Parent = bg
	Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 6)
	return fill
end

local panel = Instance.new("Frame")
panel.Size, panel.Position = UDim2.fromOffset(300, 104), UDim2.fromOffset(16, 16)
panel.BackgroundColor3 = Color3.fromRGB(14, 40, 62)
panel.BackgroundTransparency = 0.2
panel.Parent = gui
Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 12)
local stroke = Instance.new("UIStroke", panel)
stroke.Color, stroke.Thickness = Color3.fromRGB(120, 220, 235), 2
local nameLabel = label(panel, string.upper(heroCfg.displayName), UDim2.new(1, -24, 0, 28), UDim2.fromOffset(12, 6), 24)
nameLabel.TextXAlignment = Enum.TextXAlignment.Left
local hpFill = bar(panel, 40, Color3.fromRGB(235, 70, 70))
local pwFill = bar(panel, 64, Color3.fromRGB(255, 200, 60))
local pwLabel = label(panel, "", UDim2.new(1, -24, 0, 16), UDim2.fromOffset(12, 83), 14, Color3.fromRGB(255, 225, 140))
pwLabel.TextXAlignment = Enum.TextXAlignment.Left

local waveLabel = label(gui, "", UDim2.fromOffset(400, 34), UDim2.new(0.5, -200, 0, 18), 28)
local bannerLabel = label(gui, "", UDim2.fromOffset(900, 120), UDim2.new(0.5, -450, 0.32, 0), 96, Color3.fromRGB(255, 230, 120))
bannerLabel.TextTransparency, bannerLabel.TextStrokeTransparency = 1, 1
local hint = label(gui, "WASD move  •  Space jump  •  Left click combo  •  Right click heavy  •  F super  •  1-4 emotes",
	UDim2.new(1, -32, 0, 22), UDim2.new(0, 16, 1, -34), 18, Color3.fromRGB(210, 240, 245))
hint.TextXAlignment = Enum.TextXAlignment.Left

local lastBanner = SPSO:GetAttribute("BannerSeq")
local function showBanner()
	bannerLabel.Text = SPSO:GetAttribute("Banner") or ""
	bannerLabel.TextTransparency, bannerLabel.TextStrokeTransparency = 0, 0.2
	bannerLabel.TextSize = 120
	TweenService:Create(bannerLabel, TweenInfo.new(0.35, Enum.EasingStyle.Back), { TextSize = 96 }):Play()
	task.delay(1.8, function()
		TweenService:Create(bannerLabel, TweenInfo.new(0.6), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	end)
end
SPSO:GetAttributeChangedSignal("BannerSeq"):Connect(function()
	if SPSO:GetAttribute("BannerSeq") ~= lastBanner then
		lastBanner = SPSO:GetAttribute("BannerSeq")
		showBanner()
	end
end)

local function updateHUD()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then hpFill.Size = UDim2.fromScale(math.clamp(hum.Health / math.max(1, hum.MaxHealth), 0, 1), 1) end
	local power = player:GetAttribute("SPSO_Power") or 0
	pwFill.Size = UDim2.fromScale(math.clamp(power / Config.SuperCost, 0, 1), 1)
	pwLabel.Text = power >= Config.SuperCost and "SUPER READY — press F" or "POWER"
	local w = SPSO:GetAttribute("Wave")
	waveLabel.Text = w and string.format("WAVE %d / %d   •   RIVALS LEFT %d", w, SPSO:GetAttribute("Waves") or 0, SPSO:GetAttribute("EnemiesLeft") or 0) or ""
	for model, hb in healthBars do
		local h = model:FindFirstChildOfClass("Humanoid")
		if h then
			hb.fill.Size = UDim2.fromScale(math.clamp(h.Health / math.max(1, h.MaxHealth), 0, 1), 1)
			hb.gui.Enabled = h.Health > 0
		end
	end
end

-- hit effects ------------------------------------------------------------------------------------------------
FxRemote.OnClientEvent:Connect(function(kind, data)
	if kind ~= "hit" then return end
	local spark = Instance.new("Part")
	spark.Shape = Enum.PartType.Ball
	spark.Material = Enum.Material.Neon
	spark.Color = data.team == "Hero" and Color3.fromRGB(255, 90, 90) or Color3.fromRGB(255, 230, 120)
	spark.Anchored, spark.CanCollide, spark.CanQuery, spark.CanTouch, spark.CastShadow = true, false, false, false, false
	spark.Size = Vector3.one * 1.5
	spark.Position = data.pos
	spark.Parent = workspace
	TweenService:Create(spark, TweenInfo.new(0.25), { Size = Vector3.one * (data.heavy and 7 or 4.5), Transparency = 1 }):Play()
	game:GetService("Debris"):AddItem(spark, 0.3)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(120, 50)
	bb.StudsOffsetWorldSpace = Vector3.new(math.random() * 2 - 1, 1, 0)
	bb.AlwaysOnTop = true
	local holder = Instance.new("Attachment")
	holder.WorldPosition = data.pos
	holder.Parent = workspace.Terrain
	bb.Adornee = holder
	local t = label(bb, tostring(data.amount), UDim2.fromScale(1, 1), UDim2.new(), data.heavy and 40 or 30,
		data.team == "Hero" and Color3.fromRGB(255, 110, 110) or Color3.fromRGB(255, 240, 150))
	bb.Parent = gui
	TweenService:Create(bb, TweenInfo.new(0.8), { StudsOffsetWorldSpace = bb.StudsOffsetWorldSpace + Vector3.new(0, 4, 0) }):Play()
	TweenService:Create(t, TweenInfo.new(0.8), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	task.delay(0.85, function()
		bb:Destroy()
		holder:Destroy()
	end)
	if data.heavy then shake = math.max(shake, 0.9) end
end)

-- frame loop -------------------------------------------------------------------------------------------------
RunService.PreRender:Connect(function(dt)
	for model, ca in animators do
		if type(ca) == "table" then
			if not model.Parent then
				detach(model)
			else
				local ok, err = pcall(ca.Update, ca, dt)
				if not ok then
					warn("[SPSO] " .. tostring(err))
					detach(model)
				end
			end
		end
	end
	updateLocal()
	updateCamera(dt)
	updateHUD()
end)
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000030"><Properties><string name="Name">StarterPlayer/StarterCharacterScripts</string></Properties><Item class="LocalScript" referent="RBX000008"><Properties><string name="Name">Animate</string><ProtectedString name="Source"><![CDATA[-- Replaces Roblox's default Animate script: SPSO characters are animated by the exact animation
-- runtime (ReplicatedStorage.SPSO.Runtime.ExactAnimator) from StarterPlayerScripts.BrawlerClient.
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX000009"><Properties><string name="Name">Health</string><ProtectedString name="Source"><![CDATA[-- Replaces Roblox's default Health regeneration: health is managed by the brawler server.
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000031"><Properties><string name="Name">ServerStorage/SPSO/Setup</string></Properties><Item class="ModuleScript" referent="RBX000010"><Properties><string name="Name">01_world</string><ProtectedString name="Source"><![CDATA[-- SPSO world setup (Studio, Edit mode; idempotent):
--   require(game.ServerStorage.SPSO.Setup["01_world"])()
-- * archives the template baseplate / spawn and old test objects (ServerStorage.SPSO_Archive, nothing deleted)
-- * builds the playable character templates from the uploaded El Rugido model:
--     ServerStorage.SPSO.Characters.Hero_ElRugido / Enemy_Luchador, StarterPlayer.StarterCharacter
-- * configures the arena (workspace.OrbitalArena from the uploaded model: collision, glass, spawns), or builds
--   a simple placeholder arena with the same layout when the map has not been inserted yet
-- * lighting and player settings
return function(): string
	local ServerStorage = game:GetService("ServerStorage")
	local StarterPlayer = game:GetService("StarterPlayer")
	local Lighting = game:GetService("Lighting")
	local log = {}

	local function folder(parent: Instance, name: string): Instance
		local f = parent:FindFirstChild(name)
		if not f then
			f = Instance.new("Folder")
			f.Name = name
			f.Parent = parent
		end
		return f
	end
	local spso = folder(ServerStorage, "SPSO")
	local archive = folder(ServerStorage, "SPSO_Archive")

	for _, n in { "Baseplate", "SpawnLocation", "ElRugido_ExactSkinTest" } do
		local o = workspace:FindFirstChild(n)
		if o then
			o.Parent = archive
			table.insert(log, "archived " .. n)
		end
	end

	-- hero source model (the uploaded El Rugido asset)
	local source = folder(spso, "Source")
	local import = workspace:FindFirstChild("ElRugido_Import") or source:FindFirstChild("ElRugido_Import")
	assert(import, "El Rugido model not found (workspace.ElRugido_Import)")
	import.Parent = source
	local rigSrc = import:FindFirstChild("ElRugido")
	assert(rigSrc and rigSrc:FindFirstChild("RootPart"), "ElRugido_Import.ElRugido.RootPart missing")

	-- playable character: Humanoid + HumanoidRootPart driving the skinned rig (animated by script)
	local HIP, HRP_SIZE = 2.0, Vector3.new(3, 2.6, 2)
	local function buildCharacter(name: string): Model
		local char = Instance.new("Model")
		char.Name = name
		local rig = rigSrc:Clone()
		for _, c in rig:GetChildren() do
			if c:IsA("AnimationController") then
				c:Destroy()
			else
				c.Parent = char
			end
		end
		rig:Destroy()
		local root = char:FindFirstChild("RootPart") :: BasePart
		root.CFrame = CFrame.new(0, 0, 0)
		local hrp = Instance.new("Part")
		hrp.Name = "HumanoidRootPart"
		hrp.Size = HRP_SIZE
		hrp.Transparency = 1
		hrp.CanCollide, hrp.Anchored = true, false
		hrp.TopSurface, hrp.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		hrp.CFrame = CFrame.new(0, HIP + HRP_SIZE.Y / 2, 0)
		hrp.Parent = char
		for _, p in char:GetDescendants() do
			if p:IsA("BasePart") and p ~= hrp then
				p.Anchored, p.CanCollide, p.CanTouch, p.Massless = false, false, false, true
				p.CanQuery = false
				if p == root then p.Transparency = 1 end
			end
		end
		local m6 = Instance.new("Motor6D")
		m6.Name = "RigRoot"
		m6.Part0, m6.Part1 = hrp, root
		m6.C0 = CFrame.new(0, -(HIP + HRP_SIZE.Y / 2), 0)
		m6.Parent = hrp
		local hum = Instance.new("Humanoid")
		hum.RigType = Enum.HumanoidRigType.R15
		hum.HipHeight = HIP
		hum.BreakJointsOnDeath = false
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		hum.Parent = char
		char.PrimaryPart = hrp
		return char
	end
	local chars = folder(spso, "Characters")
	for _, n in { "Hero_ElRugido", "Enemy_Luchador" } do
		local old = chars:FindFirstChild(n)
		if old then old:Destroy() end
		buildCharacter(n).Parent = chars
	end
	local sc = StarterPlayer:FindFirstChild("StarterCharacter")
	if sc then sc:Destroy() end
	local starter = buildCharacter("StarterCharacter")
	starter.Parent = StarterPlayer
	table.insert(log, "characters built")

	-- arena
	local arena = workspace:FindFirstChild("OrbitalArena")
	if arena and arena:GetAttribute("Placeholder") and workspace:FindFirstChild("OrbitalArena_Real") then
		arena:Destroy()
		arena = workspace.OrbitalArena_Real
		arena.Name = "OrbitalArena"
	end
	if not arena then
		-- placeholder with the real arena's footprint (floor radius ~49 studs, back wall at -Z)
		arena = Instance.new("Model")
		arena.Name = "OrbitalArena"
		arena:SetAttribute("Placeholder", true)
		local floor = Instance.new("Part")
		floor.Name = "Floor"
		floor.Shape = Enum.PartType.Cylinder
		floor.Size = Vector3.new(2, 100, 100)
		floor.CFrame = CFrame.new(0, -1, 0) * CFrame.Angles(0, 0, math.rad(90))
		floor.Color = Color3.fromRGB(150, 214, 222)
		floor.Material = Enum.Material.SmoothPlastic
		floor.Anchored = true
		floor.Parent = arena
		for i = 0, 31 do
			local a = i / 32 * math.pi * 2
			local w = Instance.new("Part")
			w.Name = "Wall"
			w.Size = Vector3.new(10.4, 26, 2)
			w.CFrame = CFrame.new(math.sin(a) * 51, 12, math.cos(a) * 51) * CFrame.Angles(0, a, 0)
			w.Color = Color3.fromRGB(38, 120, 150)
			w.Material = Enum.Material.SmoothPlastic
			w.Anchored = true
			w.Transparency = (math.cos(a) > 0.5) and 0.85 or 0
			w.Parent = arena
		end
		arena.Parent = workspace
		table.insert(log, "placeholder arena built")
	else
		-- the FBX import puts the back wall (medallion) at +Z; the game expects it at -Z
		local med = arena:FindFirstChild("OrbitalArena_Medallion", true)
		if med and med.Position.Z > 0 then
			for _, p in arena:GetChildren() do
				if p:IsA("MeshPart") then p.CFrame = CFrame.Angles(0, math.pi, 0) * p.CFrame end
			end
		end
		local door = arena:FindFirstChild("OrbitalArena_IrisDoor_Left", true)
		if door then pcall(function() door.DoubleSided = true end) end -- mirrored in the source scene
		for _, p in arena:GetDescendants() do
			if p:IsA("BasePart") and p.Parent and p.Parent.Name ~= "Collision" then
				p.Anchored = true
				p.CanCollide, p.CanQuery, p.CanTouch = false, false, false
				p.CastShadow = false
				if string.find(p.Name, "_Collision") then p.Transparency = 1 end
				if string.find(p.Name, "Glass") then p.Transparency = 0.55 end
			end
		end
		-- collision from primitives: the original collision mesh is a flat floor inside a 12-sided wall
		-- (a convex decomposition of it fills the bowl, so it is only kept as reference)
		local col = arena:FindFirstChild("Collision")
		if col then col:Destroy() end
		col = Instance.new("Folder")
		col.Name = "Collision"
		local function box(name, cf, size)
			local b = Instance.new("Part")
			b.Name, b.CFrame, b.Size = name, cf, size
			b.Transparency, b.Anchored, b.CanCollide, b.CanQuery, b.CanTouch = 1, true, true, true, false
			b.TopSurface, b.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
			b.Parent = col
		end
		local floorY, wallH = 0, 85
		local floorPart = Instance.new("Part")
		floorPart.Name, floorPart.Shape = "Floor", Enum.PartType.Cylinder
		floorPart.Size = Vector3.new(4, 104, 104)
		floorPart.CFrame = CFrame.new(0, floorY - 2, 0) * CFrame.Angles(0, 0, math.rad(90))
		floorPart.Transparency, floorPart.Anchored, floorPart.CanCollide, floorPart.CanQuery = 1, true, true, true
		floorPart.Parent = col
		local poly = { {49.5, -13.2}, {49.5, 13.3}, {36.3, 36.3}, {13.3, 49.5}, {-13.3, 49.5}, {-36.3, 36.3},
			{-49.5, 13.3}, {-49.5, -13.2}, {-36.3, -36.2}, {-13.3, -49.5}, {13.3, -49.5}, {36.3, -36.2} }
		for i, a in poly do
			local b = poly[i % #poly + 1]
			local pa, pb = Vector3.new(a[1], 0, a[2]), Vector3.new(b[1], 0, b[2])
			local mid, len = (pa + pb) / 2, (pb - pa).Magnitude
			local out = mid.Unit
			local cf = CFrame.lookAt(mid + out * 2 + Vector3.new(0, floorY + wallH / 2, 0), mid + out * 3 + Vector3.new(0, floorY + wallH / 2, 0))
			box("Wall" .. i, cf, Vector3.new(len + 4, wallH, 4))
		end
		col.Parent = arena
		local sf = arena:FindFirstChild("SafetyFloor")
		if sf then sf:Destroy() end
		table.insert(log, "arena configured")
	end
	local spawns = arena:FindFirstChild("Spawns")
	if spawns then spawns:Destroy() end
	spawns = Instance.new("Folder")
	spawns.Name = "Spawns"
	local function marker(name: string, pos: Vector3, face: Vector3)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = Vector3.new(2, 0.2, 2)
		p.CFrame = CFrame.lookAt(pos, pos + face)
		p.Transparency = 1
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
		p.Parent = spawns
	end
	for i, x in { -8, 8, -16, 16 } do marker("Player" .. i, Vector3.new(x, 0.2, 30 - math.abs(x) / 4), Vector3.new(0, 0, -1)) end
	local enemyPts = { Vector3.new(-30, 0.2, -26), Vector3.new(30, 0.2, -26), Vector3.new(0, 0.2, -38), Vector3.new(-42, 0.2, 2),
		Vector3.new(42, 0.2, 2), Vector3.new(-18, 0.2, -40), Vector3.new(18, 0.2, -40), Vector3.new(0, 0.2, -18) }
	for i, p in enemyPts do marker(string.format("Enemy%02d", i), p, Vector3.new(0, 0, 1)) end
	spawns.Parent = arena

	-- settings
	workspace.StreamingEnabled = false
	StarterPlayer.LoadCharacterAppearance = false
	StarterPlayer.CharacterWalkSpeed = 24
	StarterPlayer.CharacterUseJumpPower = true
	StarterPlayer.CharacterJumpPower = 62
	Lighting.Brightness = 2
	Lighting.Ambient = Color3.fromRGB(96, 106, 120)
	Lighting.OutdoorAmbient = Color3.fromRGB(128, 138, 150)
	Lighting.ClockTime = 14.5
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.4
	Lighting.EnvironmentSpecularScale = 0.2
	table.insert(log, "settings applied")
	return table.concat(log, "; ")
end
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000032"><Properties><string name="Name">ServerStorage/SPSO/Tools</string></Properties><Item class="ModuleScript" referent="RBX000011"><Properties><string name="Name">Unpack</string><ProtectedString name="Source"><![CDATA[-- SPSO package unpacker (Studio, Edit mode). Inserts the SPSO_Package model asset (built by
-- tools/build_rbxmx_package.py, uploaded from Blender) and moves every item to its destination,
-- replacing same-named items there. Returns a short report.
--   require(game.ServerStorage.SPSO.Tools.Unpack)(assetId)
return function(source: any): string
	local model = source
	if type(source) == "number" then
		model = game:GetService("InsertService"):LoadAsset(source)
	end
	local pkg = model:FindFirstChild("SPSO_Package", true)
	assert(pkg, "no SPSO_Package in the asset")
	local version = pkg:FindFirstChild("_version")
	local moved = 0
	for _, dest in pkg:GetChildren() do
		if dest:IsA("Folder") then
			local parts = string.split(dest.Name, "/")
			local target: Instance = game:GetService(parts[1])
			for i = 2, #parts do
				local c = target:FindFirstChild(parts[i])
				if not c then
					c = Instance.new("Folder")
					c.Name = parts[i]
					c.Parent = target
				end
				target = c
			end
			for _, it in dest:GetChildren() do
				local meta = it:FindFirstChild("_meta")
				if meta and meta:IsA("StringValue") then
					local m = game:GetService("HttpService"):JSONDecode(meta.Value)
					it:SetAttribute("Chunks", m.chunks)
					it:SetAttribute("Bytes", m.bytes)
					it:SetAttribute("Sha", m.sha)
					meta:Destroy()
				end
				local old = target:FindFirstChild(it.Name)
				if old and old ~= it then old:Destroy() end
				it.Parent = target
				moved += 1
			end
		end
	end
	if model ~= source or type(source) == "number" then model:Destroy() end
	return string.format("unpacked %d items (version %s)", moved, version and version.Value or "?")
end
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000033"><Properties><string name="Name">ReplicatedStorage/SPSO/Heroes/ElRugido</string></Properties><Item class="Folder" referent="RBX000024"><Properties><string name="Name">Pack</string></Properties><Item class="StringValue" referent="RBX000023"><Properties><string name="Name">_meta</string><string name="Value">{"chunks": 11, "bytes": 1959860, "sha": "9e2c489c4be87477"}</string></Properties></Item><Item class="StringValue" referent="RBX000012"><Properties><string name="Name">001</string><string name="Value"></string></Properties></Item><Item class="StringValue" referent="RBX000013"><Properties><string name="Name">002</string><string name="Value"></string></Properties></Item><Item class="StringValue" referent="RBX000014"><Properties><string name="Name">003</string><string name="Value"></string></Properties></Item><Item class="StringValue" referent="RBX000015"><Properties><string name="Name">004</string><string name="Value"></string></Properties></Item><Item class="StringValue" referent="RBX000016"><Properties><string name="Name">005</string><string name="Value"></string></Properties></Item><Item class="StringValue" referent="RBX000017"><Properties><string name="Name">006</string><string name="Value"></string></Properties></Item><Item class="StringValue" referent="RBX000018"><Properties><string name="Name">007</string><string name="Value"></string></Properties></Item><Item class="StringValue" referent="RBX000019"><Properties><string name="Name">008</string><string name="Value"></string></Properties></Item><Item class="StringValue" referent="RBX000020"><Properties><string name="Name">009</string><string name="Value"></string></Properties></Item><Item class="StringValue" referent="RBX000021"><Properties><string name="Name">010</string><string name="Value"></string></Properties></Item><Item class="StringValue" referent="RBX000022"><Properties><string name="Name">011</string><string name="Value"></string></Properties></Item></Item></Item></Item></roblox>