local rays2 = img(results, "bh_stagecomplete_rays", { Size = UDim2.fromOffset(700, 700), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42), ImageTransparency = 0.15 })
img(results, "bh_backstar", { Size = UDim2.fromOffset(330, 330), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.4) })
local sparkles = img(results, "bh_mc_sparkles", { Size = UDim2.fromOffset(360, 360), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.4) })
local bigMedal = img(results, "bh_brawler_points_gold", { Size = UDim2.fromOffset(190, 190), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.4) })
text(results, "MISSION COMPLETE!", { Font = HEADING, TextSize = 72, Size = UDim2.new(1, 0, 0, 80), Position = UDim2.fromScale(0, 0.08),
	TextColor3 = Color3.fromRGB(255, 220, 80), TextStrokeTransparency = 0 })
local medalText = text(results, "", { Font = HEADING, TextSize = 44, Size = UDim2.new(1, 0, 0, 50), Position = UDim2.fromScale(0, 0.58) })
local resPanel = img(results, "bh_background", { Size = UDim2.fromOffset(520, 170), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.66) })
local resText = text(resPanel, "", { TextSize = 22, Size = UDim2.new(0.86, 0, 0.8, 0), Position = UDim2.fromScale(0.07, 0.1),
	TextWrapped = true, TextColor3 = Color3.fromRGB(40, 60, 10), TextStrokeTransparency = 1 })
local MEDAL_COLORS = { Bronze = Color3.fromRGB(205, 127, 50), Silver = Color3.fromRGB(200, 210, 220), Gold = Color3.fromRGB(255, 205, 40),
	Adamantium = Color3.fromRGB(120, 230, 255) }
SPSO:GetAttributeChangedSignal("State"):Connect(function()
	local s = SPSO:GetAttribute("State")
	if s == "results" then
		local medal = SPSO:GetAttribute("Medal") or "Bronze"
		medalText.Text = string.upper(medal) .. " MEDAL"
		medalText.TextColor3 = MEDAL_COLORS[medal] or Color3.new(1, 1, 1)
		bigMedal.Image = G["bh_brawler_points_" .. string.lower(medal)] or ""
		resText.Text = string.format("Team score %d\nKnockouts %d  •  Time %d:%02d\nSilver %d  •  Gold %d  •  Adamantium %d",
			SPSO:GetAttribute("TeamScore") or 0, SPSO:GetAttribute("KOs") or 0, (SPSO:GetAttribute("RunTime") or 0) // 60,
			(SPSO:GetAttribute("RunTime") or 0) % 60, SPSO:GetAttribute("MedalSilver") or 0, SPSO:GetAttribute("MedalGold") or 0,
			SPSO:GetAttribute("MedalAdamantium") or 0)
		results.Enabled = true
		bigMedal.Size = UDim2.fromOffset(40, 40)
		TweenService:Create(bigMedal, TweenInfo.new(0.6, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(190, 190) }):Play()
		Sound.music(Config.Music.complete)
		Sound.play("FX_Brawler_game_Mission_Complete_Fireworks", { channel = "ui" })
		Sound.play("FX_Brawler_Cheer", { channel = "ui" })
		task.delay(5.5, function() if results.Enabled then Sound.music(Config.Music.completeLoop) end end)
		task.delay(Config.ResultsTime - 1, function() results.Enabled = false end)
	elseif s == "playing" then
		results.Enabled = false
	end
end)
RunService.RenderStepped:Connect(function(dt)
	if results.Enabled then
		rays1.Rotation += dt * 8
		rays2.Rotation -= dt * 12
		sparkles.Rotation += dt * 20
	end
end)

-- frame loop -----------------------------------------------------------------------------------------------------------------------
local loadingDone = false
RunService.PreRender:Connect(function(dt)
	if not loadingDone then
		rays.Rotation += dt * 6
		star.Rotation += dt * 180
		barFill.Size = UDim2.new(0.84 * loadProgress, 0, 0.38, 0)
		loadText.Text = string.format("LOADING... %d%%", math.floor(loadProgress * 100))
		if loadProgress >= 1 then
			loadingDone = true
			TweenService:Create(tipText, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
			task.delay(0.3, function()
				loading.Enabled = false
				if not player.Character then showSelect() end
			end)
		end
	end
	if selecting then
		selRays.Rotation += dt * 4
		for _, p in previews do p.anim:Step(dt) end
	end
	for model, ca in animators do
		if type(ca) == "table" then
			if not model.Parent then
				detach(model)
			else
				local ok, err = pcall(ca.Update, ca, dt)
				if not ok then
					warn("[SPSO] " .. tostring(err))
					detach(model)
				end
			end
		end
	end
	FxPlayer.update(dt)
	for id, v in projVisuals do
		if os.clock() > v.expires or not v.part.Parent then
			v.part:Destroy()
			projVisuals[id] = nil
		else
			v.vel += Vector3.new(0, -v.g * dt, 0)
			v.part.Position += v.vel * dt
		end
	end
	updateLocal()
	updateCamera(dt)
	updateHUD(dt)
end)

player.CharacterAdded:Connect(function()
	selecting = false
	selectGui.Enabled = false
	if loadingDone then Sound.music(SPSO:GetAttribute("Music") or Config.Music.loading) end
end)
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000022"><Properties><string name="Name">StarterPlayer/StarterCharacterScripts</string></Properties><Item class="LocalScript" referent="RBX000013"><Properties><string name="Name">Animate</string><ProtectedString name="Source"><![CDATA[-- Replaces Roblox's default Animate script: SPSO characters are animated by the exact animation
-- runtime (ReplicatedStorage.SPSO.Runtime.ExactAnimator) from StarterPlayerScripts.BrawlerClient.
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX000014"><Properties><string name="Name">Health</string><ProtectedString name="Source"><![CDATA[-- Replaces Roblox's default Health regeneration: health is managed by the brawler server.
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000023"><Properties><string name="Name">ServerStorage/SPSO/Setup</string></Properties><Item class="ModuleScript" referent="RBX000015"><Properties><string name="Name">01_world</string><ProtectedString name="Source"><![CDATA[-- SPSO world setup (Studio, Edit mode; idempotent):
--   require(game.ServerStorage.SPSO.Setup["01_world"])()
-- * archives the template baseplate / spawn and old test objects (ServerStorage.SPSO_Archive, nothing deleted)
-- * inserts every hero's uploaded model and data package (Assets.lua) and builds the character templates
--     ServerStorage.SPSO.Characters.Hero_<Hero> plus select-screen previews in ReplicatedStorage.SPSO.Previews
--     (players spawn as the hero they pick: Players.CharacterAutoLoads is off)
-- * configures the arena (workspace.OrbitalArena from the uploaded model: collision, glass, spawns), or builds
--   a simple placeholder arena with the same layout when the map has not been inserted yet
-- * lighting and player settings
return function(): string
	local ServerStorage = game:GetService("ServerStorage")
	local StarterPlayer = game:GetService("StarterPlayer")
	local Lighting = game:GetService("Lighting")
	local log = {}

	local function folder(parent: Instance, name: string): Instance
		local f = parent:FindFirstChild(name)
		if not f then
			f = Instance.new("Folder")
			f.Name = name
			f.Parent = parent
		end
		return f
	end
	local spso = folder(ServerStorage, "SPSO")
	local archive = folder(ServerStorage, "SPSO_Archive")

	for _, n in { "Baseplate", "SpawnLocation", "ElRugido_ExactSkinTest" } do
		local o = workspace:FindFirstChild(n)
		if o then
			o.Parent = archive
			table.insert(log, "archived " .. n)
		end
	end

	-- hero source models (uploaded FBX assets, Assets.Heroes[H].model) and their data packages
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local InsertService = game:GetService("InsertService")
	local Players = game:GetService("Players")
	local Game = ReplicatedStorage:WaitForChild("SPSO"):WaitForChild("Game")
	local Assets = require(Game:WaitForChild("Assets"):Clone())
	local GameData = require(Game:WaitForChild("GameData"):Clone())
	local unpack = require(spso.Tools.Unpack:Clone())
	local source = folder(spso, "Source")
	local legacy = workspace:FindFirstChild("ElRugido_Import")
	if legacy then legacy.Parent = source end
	local heroesFolder = folder(ReplicatedStorage.SPSO, "Heroes")
	for _, hero in GameData.Models do
		local a = Assets.Heroes[hero] or {}
		if not source:FindFirstChild(hero .. "_Import") and a.model then
			local m = InsertService:LoadAsset(a.model)
			m.Name = hero .. "_Import"
			m.Parent = source
			table.insert(log, "inserted " .. hero)
		end
		local hf = heroesFolder:FindFirstChild(hero)
		local pack = hf and hf:FindFirstChild("Pack")
		if a.package and (not pack or pack:GetAttribute("PackageId") ~= a.package) then
			unpack(a.package)
			heroesFolder:WaitForChild(hero):WaitForChild("Pack"):SetAttribute("PackageId", a.package)
			table.insert(log, "hero data " .. hero)
		end
	end

	-- playable characters: Humanoid + HumanoidRootPart driving the skinned rig (animated by script)
	local HIP, HRP_SIZE = 2.0, Vector3.new(3, 2.6, 2)
	local function buildCharacter(rigSrc: Model, name: string): Model
		local char = Instance.new("Model")
		char.Name = name
		local rig = rigSrc:Clone()
		for _, c in rig:GetChildren() do
			if c:IsA("AnimationController") or c.Name == "InitialPoses" then
				c:Destroy()
			else
				c.Parent = char
			end
		end
		rig:Destroy()
		local root = char:FindFirstChild("RootPart") :: BasePart
		root.CFrame = CFrame.new(0, 0, 0)
		local hrp = Instance.new("Part")
		hrp.Name = "HumanoidRootPart"
		hrp.Size = HRP_SIZE
		hrp.Transparency = 1
		hrp.CanCollide, hrp.Anchored = true, false
		hrp.TopSurface, hrp.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		hrp.CFrame = CFrame.new(0, HIP + HRP_SIZE.Y / 2, 0)
		hrp.Parent = char
		for _, p in char:GetDescendants() do
			if p:IsA("BasePart") and p ~= hrp then
				p.Anchored, p.CanCollide, p.CanTouch, p.Massless = false, false, false, true
				p.CanQuery = false
				if p == root then p.Transparency = 1 end
			end
		end
		local m6 = Instance.new("Motor6D")
		m6.Name = "RigRoot"
		m6.Part0, m6.Part1 = hrp, root
		m6.C0 = CFrame.new(0, -(HIP + HRP_SIZE.Y / 2), 0)
		m6.Parent = hrp
		local hum = Instance.new("Humanoid")
		hum.RigType = Enum.HumanoidRigType.R15
		hum.HipHeight = HIP
		hum.BreakJointsOnDeath = false
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		hum.Parent = char
		char.PrimaryPart = hrp
		return char
	end
	local chars = folder(spso, "Characters")
	local previews = folder(ReplicatedStorage.SPSO, "Previews")
	for _, n in { "Enemy_Luchador" } do
		local old = chars:FindFirstChild(n)
		if old then old:Destroy() end
	end
	for _, hero in GameData.Models do
		local import = source:FindFirstChild(hero .. "_Import")
		local rigSrc = import and import:FindFirstChild(hero)
		if rigSrc and rigSrc:FindFirstChild("RootPart") then
			local old = chars:FindFirstChild("Hero_" .. hero)
			if old then old:Destroy() end
			buildCharacter(rigSrc, "Hero_" .. hero).Parent = chars
			-- select-screen preview: the bare rig, posed on the client by its own ExactAnimator
			local pv = previews:FindFirstChild(hero)
			if pv then pv:Destroy() end
			pv = rigSrc:Clone()
			for _, c in pv:GetChildren() do
				if c:IsA("AnimationController") or c.Name == "InitialPoses" then c:Destroy() end
			end
			for _, p in pv:GetDescendants() do
				if p:IsA("BasePart") then p.Anchored = true end
			end
			pv.Name = hero
			pv.Parent = previews
		else
			table.insert(log, "MISSING model for " .. hero)
		end
	end
	local sc = StarterPlayer:FindFirstChild("StarterCharacter")
	if sc then sc.Parent = archive end
	Players.CharacterAutoLoads = false
	table.insert(log, "characters built")

	-- arena
	local arena = workspace:FindFirstChild("OrbitalArena")
	if arena and arena:GetAttribute("Placeholder") and workspace:FindFirstChild("OrbitalArena_Real") then
		arena:Destroy()
		arena = workspace.OrbitalArena_Real
		arena.Name = "OrbitalArena"
	end
	if not arena then
		-- placeholder with the real arena's footprint (floor radius ~49 studs, back wall at -Z)
		arena = Instance.new("Model")
		arena.Name = "OrbitalArena"
		arena:SetAttribute("Placeholder", true)
		local floor = Instance.new("Part")
		floor.Name = "Floor"
		floor.Shape = Enum.PartType.Cylinder
		floor.Size = Vector3.new(2, 100, 100)
		floor.CFrame = CFrame.new(0, -1, 0) * CFrame.Angles(0, 0, math.rad(90))
		floor.Color = Color3.fromRGB(150, 214, 222)
		floor.Material = Enum.Material.SmoothPlastic
		floor.Anchored = true
		floor.Parent = arena
		for i = 0, 31 do
			local a = i / 32 * math.pi * 2
			local w = Instance.new("Part")
			w.Name = "Wall"
			w.Size = Vector3.new(10.4, 26, 2)
			w.CFrame = CFrame.new(math.sin(a) * 51, 12, math.cos(a) * 51) * CFrame.Angles(0, a, 0)
			w.Color = Color3.fromRGB(38, 120, 150)
			w.Material = Enum.Material.SmoothPlastic
			w.Anchored = true
			w.Transparency = (math.cos(a) > 0.5) and 0.85 or 0
			w.Parent = arena
		end
		arena.Parent = workspace
		table.insert(log, "placeholder arena built")
	else
		-- the FBX import puts the back wall (medallion) at +Z; the game expects it at -Z
		local med = arena:FindFirstChild("OrbitalArena_Medallion", true)
		if med and med.Position.Z > 0 then
			for _, p in arena:GetChildren() do
				if p:IsA("MeshPart") then p.CFrame = CFrame.Angles(0, math.pi, 0) * p.CFrame end
			end
		end
		local door = arena:FindFirstChild("OrbitalArena_IrisDoor_Left", true)
		if door then pcall(function() door.DoubleSided = true end) end -- mirrored in the source scene
		for _, p in arena:GetDescendants() do
			if p:IsA("BasePart") and p.Parent and p.Parent.Name ~= "Collision" then
				p.Anchored = true
				p.CanCollide, p.CanQuery, p.CanTouch = false, false, false
				p.CastShadow = false
				if string.find(p.Name, "_Collision") then p.Transparency = 1 end
				if string.find(p.Name, "Glass") then p.Transparency = 0.55 end
			end
		end
		-- collision from primitives: the original collision mesh is a flat floor inside a 12-sided wall
		-- (a convex decomposition of it fills the bowl, so it is only kept as reference)
		local col = arena:FindFirstChild("Collision")
		if col then col:Destroy() end
		col = Instance.new("Folder")
		col.Name = "Collision"
		local function box(name, cf, size)
			local b = Instance.new("Part")
			b.Name, b.CFrame, b.Size = name, cf, size
			b.Transparency, b.Anchored, b.CanCollide, b.CanQuery, b.CanTouch = 1, true, true, true, false
			b.TopSurface, b.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
			b.Parent = col
		end
		local floorY, wallH = 0, 85
		local floorPart = Instance.new("Part")
		floorPart.Name, floorPart.Shape = "Floor", Enum.PartType.Cylinder
		floorPart.Size = Vector3.new(4, 104, 104)
		floorPart.CFrame = CFrame.new(0, floorY - 2, 0) * CFrame.Angles(0, 0, math.rad(90))
		floorPart.Transparency, floorPart.Anchored, floorPart.CanCollide, floorPart.CanQuery = 1, true, true, true
		floorPart.Parent = col
		local poly = { {49.5, -13.2}, {49.5, 13.3}, {36.3, 36.3}, {13.3, 49.5}, {-13.3, 49.5}, {-36.3, 36.3},
			{-49.5, 13.3}, {-49.5, -13.2}, {-36.3, -36.2}, {-13.3, -49.5}, {13.3, -49.5}, {36.3, -36.2} }
		for i, a in poly do
			local b = poly[i % #poly + 1]
			local pa, pb = Vector3.new(a[1], 0, a[2]), Vector3.new(b[1], 0, b[2])
			local mid, len = (pa + pb) / 2, (pb - pa).Magnitude
			local out = mid.Unit
			local cf = CFrame.lookAt(mid + out * 2 + Vector3.new(0, floorY + wallH / 2, 0), mid + out * 3 + Vector3.new(0, floorY + wallH / 2, 0))
			box("Wall" .. i, cf, Vector3.new(len + 4, wallH, 4))
		end
		col.Parent = arena
		local sf = arena:FindFirstChild("SafetyFloor")
		if sf then sf:Destroy() end
		table.insert(log, "arena configured")
	end
	local spawns = arena:FindFirstChild("Spawns")
	if spawns then spawns:Destroy() end
	spawns = Instance.new("Folder")
	spawns.Name = "Spawns"
	local function marker(name: string, pos: Vector3, face: Vector3)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = Vector3.new(2, 0.2, 2)
		p.CFrame = CFrame.lookAt(pos, pos + face)
		p.Transparency = 1
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
		p.Parent = spawns
	end
	for i, x in { -8, 8, -16, 16 } do marker("Player" .. i, Vector3.new(x, 0.2, 30 - math.abs(x) / 4), Vector3.new(0, 0, -1)) end
	local enemyPts = { Vector3.new(-30, 0.2, -26), Vector3.new(30, 0.2, -26), Vector3.new(0, 0.2, -38), Vector3.new(-42, 0.2, 2),
		Vector3.new(42, 0.2, 2), Vector3.new(-18, 0.2, -40), Vector3.new(18, 0.2, -40), Vector3.new(0, 0.2, -18) }
	for i, p in enemyPts do marker(string.format("Enemy%02d", i), p, Vector3.new(0, 0, 1)) end
	spawns.Parent = arena

	-- settings
	workspace.StreamingEnabled = false
	StarterPlayer.LoadCharacterAppearance = false
	StarterPlayer.CharacterUseJumpPower = true
	workspace.Gravity = GameData.Heroes[GameData.HeroOrder[1]].gravity -- the original 20 units/s^2
	Lighting.Brightness = 2
	Lighting.Ambient = Color3.fromRGB(96, 106, 120)
	Lighting.OutdoorAmbient = Color3.fromRGB(128, 138, 150)
	Lighting.ClockTime = 14.5
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.4
	Lighting.EnvironmentSpecularScale = 0.2
	table.insert(log, "settings applied")
	return table.concat(log, "; ")
end
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000024"><Properties><string name="Name">ServerStorage/SPSO/Tools</string></Properties><Item class="ModuleScript" referent="RBX000016"><Properties><string name="Name">Unpack</string><ProtectedString name="Source"><![CDATA[-- SPSO package unpacker (Studio, Edit mode). Inserts the SPSO_Package model asset (built by
-- tools/build_rbxmx_package.py, uploaded from Blender) and moves every item to its destination,
-- replacing same-named items there. Returns a short report.
--   require(game.ServerStorage.SPSO.Tools.Unpack)(assetId)
return function(source: any): string
	local model = source
	if type(source) == "number" then
		model = game:GetService("InsertService"):LoadAsset(source)
	end
	local pkg = model:FindFirstChild("SPSO_Package", true)
	assert(pkg, "no SPSO_Package in the asset")
	local version = pkg:FindFirstChild("_version")
	local moved = 0
	for _, dest in pkg:GetChildren() do
		if dest:IsA("Folder") then
			local parts = string.split(dest.Name, "/")
			local target: Instance = game:GetService(parts[1])
			for i = 2, #parts do
				local c = target:FindFirstChild(parts[i])
				if not c then
					c = Instance.new("Folder")
					c.Name = parts[i]
					c.Parent = target
				end
				target = c
			end
			for _, it in dest:GetChildren() do
				local meta = it:FindFirstChild("_meta")
				if meta and meta:IsA("StringValue") then
					local m = game:GetService("HttpService"):JSONDecode(meta.Value)
					it:SetAttribute("Chunks", m.chunks)
					it:SetAttribute("Bytes", m.bytes)
					it:SetAttribute("Sha", m.sha)
					meta:Destroy()
				end
				local old = target:FindFirstChild(it.Name)
				if old and old ~= it then old:Destroy() end
				it.Parent = target
				moved += 1
			end
		end
	end
	if model ~= source or type(source) == "number" then model:Destroy() end
	return string.format("unpacked %d items (version %s)", moved, version and version.Value or "?")
end
]]></ProtectedString></Properties></Item></Item></Item></roblox>