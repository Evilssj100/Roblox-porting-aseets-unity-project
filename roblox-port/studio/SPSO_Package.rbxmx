]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000006"><Properties><string name="Name">FxPlayer</string><ProtectedString name="Source"><![CDATA[-- Plays the original effect sequences (FxData, generated by tools/build_fx.py from the hero bundles) on a
-- fighter or at a point in the world, client side:
--   ParticleEmitter (legacy particle systems: rate/burst, lifetime, size + growth, 5-key colour and alpha,
--   velocity + spread, force, damping, rotation, additive blending, stretch, flipbooks), Trail, PointLight,
--   animated FX meshes (rings, cylinders, planes, spheres) and the sequence's sounds (Sound sprite).
-- Effects attached to a bone follow it exactly: a holder Bone under the rig root is moved every frame to the
-- node's frame from the fighter's ExactAnimator.
--   FxPlayer.play(hero, seq, model, opts?) -> handle { stop = fn }      opts: { at = Vector3, face = Vector3 }
--   FxPlayer.update(dt)   call every frame        FxPlayer.setAnimatorResolver(fn(model) -> ExactAnimator?)
local Debris = game:GetService("Debris")

local Game = script.Parent
local FxData = require(Game:WaitForChild("FxData"))
local Assets = require(Game:WaitForChild("Assets"))
local Sound = require(Game:WaitForChild("Sound"))

local FxPlayer = {}
local resolver = function(_) return nil end
local holders = {} -- model -> { node -> Bone }
local meshes = {} -- live animated FX meshes
local folder

function FxPlayer.setAnimatorResolver(fn) resolver = fn end
FxPlayer.Enabled = true
FxPlayer.OnShake = nil -- function(strength)

local function fxFolder()
	if not folder or not folder.Parent then
		folder = Instance.new("Folder")
		folder.Name = "SPSO_FX"
		folder.Parent = workspace
	end
	return folder
end

local function cf(el)
	local p, q = el.pos, el.rot
	return CFrame.new(p[1], p[2], p[3], q[1], q[2], q[3], q[4])
end

local function seq5(values, f)
	local kps = {}
	for i, v in values do kps[i] = f((i - 1) / (#values - 1), v) end
	return kps
end

local function colorSeq(cols, tint)
	return ColorSequence.new(seq5(cols, function(t, c)
		return ColorSequenceKeypoint.new(t, Color3.new(math.min(1, c[1] * tint[1]), math.min(1, c[2] * tint[2]), math.min(1, c[3] * tint[3])))
	end))
end

local function alphaSeq(cols, tint)
	return NumberSequence.new(seq5(cols, function(t, c)
		return NumberSequenceKeypoint.new(t, math.clamp(1 - c[4] * (tint[4] or 1), 0, 1))
	end))
end

local function texture(key)
	if not key then return nil end
	local id = Assets.Fx[key] or Assets.Fx[(string.gsub(key, "^fx_", ""))]
	return id ~= "" and id or nil
end

local function holderFor(model: Model?, node: string?)
	local root = model and model:FindFirstChild("RootPart")
	if not root then return nil end
	if not node or node == "" then return root end
	local hs = holders[model]
	if not hs then
		hs = {}
		holders[model] = hs
	end
	local b = hs[node]
	if b and b.Parent then return b end
	b = Instance.new("Bone")
	b.Name = "SPSO_FX_" .. node
	b.Parent = root
	hs[node] = b
	local anim = resolver(model)
	local ncf = anim and anim:NodeCFrame(node)
	if ncf then b.CFrame = ncf end
	return b
end

-- one element -------------------------------------------------------------------------------------------------
local function emitter(el, parent, base: CFrame?, duration: number)
	local tex = texture(el.tex)
	if not tex then return nil end
	local a = Instance.new("Attachment")
	local v = Vector3.new(el.localVel[1], el.localVel[2], el.localVel[3])
	local wv = Vector3.new(el.worldVel[1], el.worldVel[2], el.worldVel[3])
	local rnd = (el.rndVel[1] + el.rndVel[2] + el.rndVel[3]) / 3
	local ecf = cf(el)
	if base then ecf = base * ecf end
	a.CFrame = ecf
	a.Parent = parent
	if wv.Magnitude > 0.01 then v += a.WorldCFrame:VectorToObjectSpace(wv) end
	local speed = v.Magnitude
	if speed > 0.01 then
		a.CFrame = ecf * CFrame.fromRotationBetweenVectors(Vector3.yAxis, v.Unit)
	end
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = tex
	pe.LightEmission = el.blend == "add" and 1 or (el.blend == "premul" and 0.4 or 0)
	pe.LightInfluence = 0
	pe.Brightness = el.blend == "add" and 1.6 or 1
	local e1, e2 = math.max(0.05, el.energy[1]), math.max(0.05, el.energy[2])
	pe.Lifetime = NumberRange.new(e1, e2)
	local life = (e1 + e2) / 2
	local s1, s2 = el.size[1], el.size[2]
	local s0, env = math.min(100, (s1 + s2) / 2), math.abs(s2 - s1) / 2
	local g = el.sizeGrow or 0
	local mid = math.clamp(s0 * math.exp(g * life * 0.5), 0, 100)
	local fin = math.clamp(s0 * math.exp(g * life), 0, 100)
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, s0, math.min(env, s0)),
		NumberSequenceKeypoint.new(0.5, mid, math.min(env, mid)), NumberSequenceKeypoint.new(1, fin, math.min(env, fin)) })
	pe.Color = colorSeq(el.colors, el.tint)
	pe.Transparency = alphaSeq(el.colors, el.tint)
	if speed > 0.01 then
		pe.Speed = NumberRange.new(math.max(0, speed - rnd), speed + rnd)
		local spread = math.deg(math.atan2(rnd, speed))
		pe.SpreadAngle = Vector2.new(spread, spread)
	elseif rnd > 0.01 then
		pe.Speed = NumberRange.new(0, rnd)
		pe.SpreadAngle = Vector2.new(180, 180)
	else
		pe.Speed = NumberRange.new(0)
	end
	pe.Acceleration = Vector3.new(el.force[1], el.force[2], el.force[3])
	if el.damping and el.damping < 0.999 and el.damping > 0 then
		pe.Drag = math.clamp(-math.log(el.damping) / math.log(2), 0, 50)
	end
	pe.Rotation = el.rndRotation and NumberRange.new(0, 360) or NumberRange.new(0)
	local w, rw = el.angularVel or 0, el.rndAngularVel or 0
	pe.RotSpeed = NumberRange.new(w - rw, w + rw)
	pe.LockedToPart = not el.worldSpace
	if el.stretch == 1 then
		pe.Orientation = Enum.ParticleOrientation.VelocityParallel
		local sq = math.clamp((el.lengthScale or 1) - 1, 0, 3)
		if sq > 0 then pe.Squash = NumberSequence.new(sq) end
	elseif el.stretch == 3 then
		pe.Orientation = Enum.ParticleOrientation.VelocityPerpendicular
	elseif el.stretch == 4 then
		pe.Orientation = Enum.ParticleOrientation.FacingCameraWorldUp
	end
	local tx, ty, cycles = el.uvTiles[1], el.uvTiles[2], el.uvTiles[3]
	if tx == ty and (tx == 2 or tx == 4 or tx == 8) then
		pe.FlipbookLayout = Enum.ParticleFlipbookLayout["Grid" .. tx .. "x" .. ty]
		pe.FlipbookMode = cycles > 1 and Enum.ParticleFlipbookMode.Loop or Enum.ParticleFlipbookMode.OneShot
		pe.FlipbookFramerate = NumberRange.new(math.max(1, tx * ty * math.max(1, cycles) / life))
	end
	pe.Parent = a
	local n = math.floor(el.emission[1] + math.random() * (el.emission[2] - el.emission[1]) + 0.5)
	if el.oneShot then
		pe.Enabled = false
		if el.emit then pe:Emit(math.clamp(n, 1, 200)) end
		Debris:AddItem(a, e2 + 0.2)
		return { inst = a, oneShot = true }
	end
	pe.Rate = math.clamp((el.emission[1] + el.emission[2]) / 2, 0, 400)
	pe.Enabled = el.emit
	return { inst = a, pe = pe, life = e2, duration = duration }
end

local function trail(el, parent, base: CFrame?, duration: number)
	local tex = texture(el.tex)
	if not tex then return nil end
	local ecf = cf(el)
	if base then ecf = base * ecf end
	local w = math.max(0.05, el.width[1])
	local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
	a0.CFrame = ecf * CFrame.new(-w / 2, 0, 0)
	a1.CFrame = ecf * CFrame.new(w / 2, 0, 0)
	a0.Parent, a1.Parent = parent, parent
	local t = Instance.new("Trail")
	t.Attachment0, t.Attachment1 = a0, a1
	t.Texture = tex
	t.Lifetime = math.max(0.05, el.time)
	t.LightEmission = el.blend == "add" and 1 or 0
	t.LightInfluence = 0
	t.FaceCamera = true
	t.Color = colorSeq(el.colors, el.tint)
	t.Transparency = alphaSeq(el.colors, el.tint)
	t.WidthScale = NumberSequence.new(1, math.clamp(el.width[2] / w, 0, 4))
	t.Parent = a0
	return { inst = a0, extra = a1, trail = t, life = el.time, duration = duration }
end

local function light(el, parent, base: CFrame?, duration: number)
	local a = Instance.new("Attachment")
	a.CFrame = base and base * cf(el) or cf(el)
	a.Parent = parent
	local l = Instance.new("PointLight")
	l.Color = Color3.new(el.color[1], el.color[2], el.color[3])
	l.Brightness = math.clamp(el.intensity * 2, 0, 8)
	l.Range = math.clamp(el.range, 2, 60)
	l.Shadows = false
	l.Parent = a
	return { inst = a, life = 0, duration = duration }
end

local function mesh(el, parent, base: CFrame?, duration: number, world: CFrame?)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Material = Enum.Material.Neon
	local tint = el.tint
	p.Color = Color3.new(math.min(1, tint[1]), math.min(1, tint[2]), math.min(1, tint[3]))
	local size = Vector3.new(math.max(0.05, el.size[1]), math.max(0.05, el.size[2]), math.max(0.05, el.size[3]))
	local rot = CFrame.identity
	if el.shape == "cylinder" then
		p.Shape = Enum.PartType.Cylinder
		size = Vector3.new(size.Y, size.X, size.Z) -- Roblox cylinders run along X
		rot = CFrame.Angles(0, 0, math.rad(90))
	elseif el.shape == "sphere" then
		p.Shape = Enum.PartType.Ball
	elseif el.shape == "plane" then
		size = Vector3.new(size.X, 0.05, size.Z)
		p.Transparency = 1
		local tex = texture(el.tex)
		for _, face in { Enum.NormalId.Top, Enum.NormalId.Bottom } do
			local d = Instance.new("Decal")
			d.Texture = tex or ""
			d.Face = face
			d.Color3 = p.Color
			d.Parent = p
		end
	end
	p.Size = size
	p.Transparency = el.shape == "plane" and 1 or 0.45
	p.Parent = fxFolder()
	local rec = { inst = p, mesh = true, el = el, base = size, rot = rot, offset = (base or CFrame.identity) * cf(el),
		parent = parent, world = world, t = 0, life = 0, duration = duration }
	table.insert(meshes, rec)
	return rec
end

local MAKERS = { emitter = emitter, trail = trail, light = light, mesh = mesh }

-- sequences ------------------------------------------------------------------------------------------------------
function FxPlayer.has(hero: string, name: string?): boolean
	local h = FxData.Heroes[hero]
	return name ~= nil and h ~= nil and h.sequences[name] ~= nil
end

function FxPlayer.play(hero: string, name: string?, model: Model?, opts)
	if not FxPlayer.Enabled or not name then return nil end
	local h = FxData.Heroes[hero]
	local seq = h and h.sequences[name]
	if not seq then return nil end
	opts = opts or {}
	local handle = { live = {}, stopped = false }
	local total = seq.lifetime and seq.lifetime > 0 and seq.lifetime or 2.5
	local worldBase
	if opts.at then
		local look = opts.face and Vector3.new(opts.face.X, 0, opts.face.Z) or Vector3.zAxis
		worldBase = CFrame.lookAt(opts.at, opts.at + (look.Magnitude > 0.01 and look.Unit or Vector3.zAxis))
	end
	for _, part in seq.particles do
		task.delay(part.t, function()
			if handle.stopped then return end
			local parent, base = nil, nil
			if worldBase or part.detached then
				parent = workspace.Terrain
				if worldBase then
					base = worldBase
				else
					local holder = holderFor(model, part.node)
					base = holder and (holder:IsA("Bone") and holder.WorldCFrame or holder.CFrame) or nil
				end
				if not base then return end
			else
				parent = holderFor(model, part.node)
				if not parent then return end
			end
			local duration = part.life and part.life > 0 and part.life or math.max(0.3, total - part.t)
			for _, el in h.prefabs[part.prefab] or {} do
				local make = MAKERS[el.kind]
				if make then
					local ok, rec = pcall(make, el, parent, base, duration, worldBase)
					if ok and rec then
						rec.stopAt = os.clock() + duration
						table.insert(handle.live, rec)
					end
				end
			end
		end)
	end
	for _, s in seq.sounds do
		if math.random() <= (s.chance or 1) then
			task.delay(s.t, function()
				if handle.stopped then return end
				local key = s.clips[math.random(#s.clips)]
				local at = opts.at or (model and model:FindFirstChild("HumanoidRootPart"))
				Sound.play(key, { at = at, volume = s.volume, pitch = s.pitch, minDist = s.minDist, maxDist = s.maxDist })
			end)
		end
	end
	if seq.shake and FxPlayer.OnShake then
		task.delay(seq.shake.t, function() FxPlayer.OnShake(0.8) end)
	end
	function handle.stop()
		if handle.stopped then return end
		handle.stopped = true
		for _, rec in handle.live do rec.stopAt = math.min(rec.stopAt or 0, os.clock()) end
	end
	handle.model = model
	FxPlayer._handles[handle] = true
	return handle
end
FxPlayer._handles = {}

local function finish(rec)
	if rec.done then return end
	rec.done = true
	if rec.pe then rec.pe.Enabled = false end
	if rec.trail then rec.trail.Enabled = false end
	local keep = (rec.life or 0) + 0.1
	if rec.inst then Debris:AddItem(rec.inst, keep) end
	if rec.extra then Debris:AddItem(rec.extra, keep) end
end

function FxPlayer.update(dt: number)
	local now = os.clock()
	-- holder bones follow their nodes
	for model, hs in holders do
		if not model.Parent then
			holders[model] = nil
		else
			local anim = resolver(model)
			if anim then
				for node, b in hs do
					local ncf = anim:NodeCFrame(node)
					if ncf then b.CFrame = ncf end
				end
			end
		end
	end
	-- timed elements
	for handle in FxPlayer._handles do
		local alive = false
		for _, rec in handle.live do
			if not rec.done then
				if rec.oneShot then
					rec.done = true
				elseif now >= (rec.stopAt or now) then
					finish(rec)
				else
					alive = true
				end
			end
		end
		if not alive and handle.stopped then FxPlayer._handles[handle] = nil end
		if not alive and not handle.stopped and #handle.live > 0 then
			handle.stopped = true
		end
	end
	-- animated meshes
	for i = #meshes, 1, -1 do
		local m = meshes[i]
		m.t += dt
		local p = m.inst
		if not p.Parent or m.done or now >= (m.stopAt or now) + 0.05 then
			p:Destroy()
			table.remove(meshes, i)
		else
			local holderCF
			if m.world then
				holderCF = CFrame.identity
			elseif m.parent:IsA("Bone") then
				holderCF = m.parent.WorldCFrame
			elseif m.parent:IsA("BasePart") then
				holderCF = m.parent.CFrame
			else
				holderCF = CFrame.identity
			end
			local scale, alpha = Vector3.one, 1
			local an = m.el.anim
			if an then
				local n = an.scale and #an.scale or (an.alpha and #an.alpha or 1)
				local k = math.floor(m.t / an.dt) + 1
				if an.wrap == 2 then k = (k - 1) % n + 1 else k = math.min(k, n) end
				if an.scale then
					local s = an.scale[k]
					scale = Vector3.new(s[1], s[2], s[3])
				end
				if an.alpha then alpha = an.alpha[k] end
			end
			local size = m.base * (m.el.shape == "cylinder" and Vector3.new(scale.Y, scale.X, scale.Z) or scale)
			p.Size = Vector3.new(math.max(0.02, size.X), math.max(0.02, size.Y), math.max(0.02, size.Z))
			p.CFrame = holderCF * m.offset * m.rot
			local tr = 1 - math.clamp(alpha * (m.el.tint[4] or 1), 0, 1)
			if m.el.shape == "plane" then
				for _, d in p:GetChildren() do
					if d:IsA("Decal") then d.Transparency = tr end
				end
			else
				p.Transparency = math.max(0.35, tr)
			end
		end
	end
end

function FxPlayer.clear(model: Model)
	for handle in FxPlayer._handles do
		if handle.model == model then handle.stop() end
	end
	local hs = holders[model]
	if hs then
		for _, b in hs do b:Destroy() end
		holders[model] = nil
	end
end

-- a beam between two points with a hero's beam texture (LineRenderer art), for beam impacts
function FxPlayer.beam(hero: string, from: Vector3, to: Vector3, duration: number?)
	local h = FxData.Heroes[hero]
	local tex, color = nil, Color3.fromRGB(255, 230, 140)
	if h then
		for _, els in h.prefabs do
			for _, el in els do
				if el.kind == "line" and el.tex then
					tex = texture(el.tex)
					color = Color3.new(el.colors[1][1], el.colors[1][2], el.colors[1][3])
				end
			end
		end
	end
	local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
	a0.WorldPosition, a1.WorldPosition = from, to
	a0.Parent, a1.Parent = workspace.Terrain, workspace.Terrain
	local b = Instance.new("Beam")
	b.Attachment0, b.Attachment1 = a0, a1
	b.Texture = tex or ""
	b.TextureMode = Enum.TextureMode.Stretch
	b.LightEmission, b.LightInfluence = 1, 0
	b.Color = ColorSequence.new(color)
	b.Width0, b.Width1 = 1.6, 1.2
	b.FaceCamera = true
	b.Parent = a0
	local d = duration or 0.18
	Debris:AddItem(a0, d)
	Debris:AddItem(a1, d)
end

return FxPlayer
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000007"><Properties><string name="Name">GameConfig</string><ProtectedString name="Source"><![CDATA[-- SPSO port tuning. Everything that comes from the original game (stats, motion, attacks, impacts, enemy
-- archetypes, scoring) is in GameData (generated by tools/convert_game_data.py); asset ids are in Assets
-- (generated by tools/record_uploads.py). This file only holds the port's own choices.
local Game = script.Parent
local GameData = require(Game:WaitForChild("GameData"))
local Assets = require(Game:WaitForChild("Assets"))

local WM = { Once = 1, Loop = 2, PingPong = 4, ClampForever = 8 }

local Config = {}
Config.Map = "OrbitalArena"
Config.DefaultHero = "ElRugido"
Config.HeroOrder = GameData.HeroOrder
Config.StudsPerUnit = GameData.studsPerUnit

-- wrap modes the original CharacterMotionController / behaviours set (clips not listed play Once)
Config.WrapModes = {
	movement_idle = WM.Loop, movement_run = WM.Loop, pickup_idle = WM.Loop, pickup_run = WM.Loop,
	jump_fall_loop = WM.Loop, sit_idle = WM.Loop, emote_manipulate_loop = WM.Loop,
	jump_up = WM.ClampForever, jump_run_up = WM.ClampForever, jump_fall = WM.ClampForever,
	jump_run_fall = WM.ClampForever, jump_land = WM.ClampForever, jump_run_land = WM.ClampForever,
	recoil_death = WM.ClampForever, recoil_launch = WM.ClampForever, pickup = WM.ClampForever,
	recoil_stun = WM.Loop,
}

-- hero select: the original hero classes (gui symbols) and a line for each card
Config.HeroInfo = {
	ElRugido = { class = "strength", color = Color3.fromRGB(196, 58, 52), tagline = "Masked brawler with ground-shaking fists" },
	Skyvolt = { class = "speed", color = Color3.fromRGB(40, 160, 170), tagline = "Winged striker with a storm of shards" },
	Aurora = { class = "energy", color = Color3.fromRGB(120, 80, 200), tagline = "Energy flier with light beams and blasts" },
	Magmaul = { class = "strength", color = Color3.fromRGB(230, 110, 30), tagline = "Living lava rock, slow and unstoppable" },
	NightGecko = { class = "animal", color = Color3.fromRGB(60, 190, 90), tagline = "Wall-crawling acrobat with sticky shots" },
}

local function faces(name)
	local a = Assets.Heroes[name]
	if not a or not a.faces then return nil end
	return a.faces -- tile 0 may be "": the model's own head texture is that tile
end

-- every character model (playable heroes and the enemies' own models): pack, template, parts, faces
Config.Models = {}
for _, name in GameData.Models do
	local d = GameData.Heroes[name]
	local speed = d and d.speed or 10
	if not d then
		for _, e in GameData.Enemies do
			if e.model == name then speed = e.speed end
		end
	end
	Config.Models[name] = {
		name = name, pack = name, template = "Hero_" .. name, headPart = name .. "_Head", bodyPart = name .. "_Body",
		faceTextures = faces(name), wrapModes = Config.WrapModes, runAnimSpeed = math.max(4, speed),
	}
end
Config.Heroes = {}
for _, name in GameData.HeroOrder do
	local d = GameData.Heroes[name]
	local m = Config.Models[name]
	Config.Heroes[name] = setmetatable({
		displayName = d.displayName, walkSpeed = d.speed, jumpPower = d.jump, health = d.health, data = d,
	}, { __index = m })
end

-- enemy archetypes: the original enemy data (GameData.Enemies) plus the port's AI tuning
Config.Enemies = {
	Thug = { damageScale = 1, keepDistance = 0, cooldown = { 1.6, 3.0 }, think = 0.12, skins = {} },
	Blaster = { damageScale = 1, keepDistance = 18, cooldown = { 2.2, 3.6 }, think = 0.15, skins = {} },
	Bazooka = { damageScale = 1, keepDistance = 22, cooldown = { 3.2, 4.6 }, think = 0.15, skins = {} },
	Grenadier = { damageScale = 1, keepDistance = 16, cooldown = { 2.6, 4.0 }, think = 0.15, skins = {} },
	Warlord = { damageScale = 1, keepDistance = 0, cooldown = { 1.4, 2.4 }, think = 0.1, skins = {}, boss = true,
		teleport = { "attack_teleport_start", "attack_teleport_end" } },
}
Config.MaxAttackers = 2 -- enemies swinging at the same time
Config.WaitAfterHeroHit = 0.6 -- don't pile onto a hero that was just hit
Config.DespawnAfter = 3.5

-- the run: waves of the original brawler enemies, the warlord last
-- the run, after the original invasion missions on the alien ship: brawlers and gunners first, then heavy
-- weapons, then the warlord in his arena (each wave also names the original stage music)
Config.Waves = {
	{ enemies = { Thug = 3 }, music = "Level_Music_thug_Spaceship_Stage1" },
	{ enemies = { Thug = 3, Blaster = 2 }, music = "Level_Music_thug_Spaceship_Stage1" },
	{ enemies = { Thug = 2, Blaster = 2, Grenadier = 2 }, music = "Level_Music_thug_Spaceship_Stage2" },
	{ enemies = { Thug = 3, Bazooka = 2, Grenadier = 1 }, music = "Level_Music_thug_Spaceship_Stage2" },
	{ enemies = { Warlord = 1, Thug = 2 }, music = "Level_Music_thug_Spaceship_BossArena", boss = true },
}
Config.WaveBreak = 3
Config.RespawnTime = 4
Config.ResultsTime = 12

-- combat rules of the port (the rest is data)
Config.FadeAttack = 0.1
Config.FadeRecoil = 0.05
Config.HeroStunImmunity = 1.0 -- seconds after a hero recoil during which hits only deal damage
Config.RecoilCancel = 0.25 -- a hero can attack out of a small/big recoil after this many seconds
Config.SuperCost = 100
Config.TargetRadius = 1.28 -- body radius when the data has none (0.5 units)
Config.HitRadiusScale = 1.35 -- attack colliders are spheres around bones; a little generous over the network
Config.PickupChance = { star = 0.55, health = 0.18 }
Config.HealthPickup = 0.2 -- of max health

Config.Emotes = { "emote_taunt", "emote_cheer", "emote_laugh", "emote_dance" }
Config.PowerEmotes = { "power_emote_1", "power_emote_2", "power_emote_3" }

-- camera: fixed angle like the original brawler camera, facing the arena's back wall (-Z)
Config.Camera = { offset = Vector3.new(0, 21, 27), lookHeight = 3.5, fov = 55, zoomMin = 0.6, zoomMax = 1.6, maxCameraZ = 47 }

Config.Music = { menu = "Music_game_LoadingPage", select = "Music_game_MainTheme", loading = "Music_game_Mission_Loading",
	complete = "Music_game_Mission_Complete", completeLoop = "Music_game_Mission_Complete_Loop_1" }
Config.Tips = {
	"Chain five left clicks for your full combo: the last hit launches.",
	"Hitting and getting hit both fill your power meter.",
	"Power attacks cost 20, 40 and 60 power. A full meter unleashes your super.",
	"Keep your combo meter hot to multiply the points for every knockout.",
	"Fewer knockouts on your team means a bigger survival bonus.",
	"Blasters shoot from a distance: close in fast.",
	"Stars dropped by defeated rivals are worth points.",
}

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000008"><Properties><string name="Name">GameData</string><ProtectedString name="Source"><![CDATA[-- GENERATED by tools/convert_game_data.py from the original game data. Do not edit by hand:
-- change the converter (or GameConfig for port tuning) and run it again.
return {
	Enemies = {
		Bazooka = {
			attacks = {
				attack_bazooka = {
					anim = "attack_bazooka",
					chainEnd = 0,
					chainStart = 0,
					collisionOff = -1,
					collisionOn = -1,
					cost = 0,
					desired = 17.92,
					duration = 2.8333,
					effect = "thug_bazooka fire sequence",
					events = {
						collision = 0,
						projectile = 1,
