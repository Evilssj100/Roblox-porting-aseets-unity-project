]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000007"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[-- Remote events shared by server and clients (created by the server under ReplicatedStorage.SPSO.Remotes)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}
local folder

local function getFolder()
	if folder then return folder end
	local spso = ReplicatedStorage:WaitForChild("SPSO")
	if RunService:IsServer() then
		folder = spso:FindFirstChild("Remotes")
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = "Remotes"
			folder.Parent = spso
		end
	else
		folder = spso:WaitForChild("Remotes")
	end
	return folder
end

function Net.event(name: string): RemoteEvent
	local f = getFolder()
	local e = f:FindFirstChild(name)
	if not e then
		if RunService:IsServer() then
			e = Instance.new("RemoteEvent")
			e.Name = name
			e.Parent = f
		else
			e = f:WaitForChild(name)
		end
	end
	return e
end

return Net
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000017"><Properties><string name="Name">ServerScriptService/SPSO</string></Properties><Item class="Script" referent="RBX000008"><Properties><string name="Name">Brawler</string><ProtectedString name="Source"><![CDATA[-- SPSO brawler server: heroes and enemies as "fighters", the original attack chains and hit windows
-- (timed by the clips' own AnimationEvents through headless ExactAnimators), hit reactions,
-- enemy AI, waves, power meter. Clients animate every fighter from the replicated "SPSO_Action".
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local SPSO = ReplicatedStorage:WaitForChild("SPSO")
local Config = require(SPSO:WaitForChild("Game"):WaitForChild("GameConfig"))
local Net = require(SPSO.Game:WaitForChild("Net"))
local HeroPack = require(SPSO:WaitForChild("Runtime"):WaitForChild("HeroPack"))
local ExactAnimator = require(SPSO.Runtime:WaitForChild("ExactAnimator"))

local AttackRemote, EmoteRemote, FxRemote = Net.event("Attack"), Net.event("Emote"), Net.event("Fx")
local heroCfg = Config.Heroes[Config.PlayerHero]
local pack = HeroPack.get(heroCfg.pack)
Players.RespawnTime = Config.RespawnTime

local arena = workspace:WaitForChild(Config.Map, 30)
local spawns = arena and arena:FindFirstChild("Spawns")
local enemyFolder = workspace:FindFirstChild("SPSO_Enemies") or Instance.new("Folder")
enemyFolder.Name = "SPSO_Enemies"
enemyFolder.Parent = workspace

local fighters = {}
local seq = 0
local now = os.clock

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function spawnPoint(prefix: string, i: number): CFrame
	local pts = {}
	if spawns then
		for _, p in spawns:GetChildren() do
			if p:IsA("BasePart") and string.sub(p.Name, 1, #prefix) == prefix then table.insert(pts, p) end
		end
		table.sort(pts, function(a, b) return a.Name < b.Name end)
	end
	if #pts == 0 then return CFrame.new(0, 6, prefix == "Player" and 25 or -25) end
	return pts[(i - 1) % #pts + 1].CFrame
end

local Fighter = {}
Fighter.__index = Fighter

function Fighter.new(model: Model, team: string, player: Player?)
	local f = setmetatable({}, Fighter)
	f.model, f.team, f.player = model, team, player
	f.hum = model:FindFirstChildOfClass("Humanoid")
	f.hrp = model:FindFirstChild("HumanoidRootPart")
	f.power = 0
	f.chainKind, f.chainIndex, f.chainOpen, f.buffered, f.rIndex = nil, 0, false, nil, 0
	f.hitOpen, f.hitSet = false, {}
	f.action, f.actionKind = nil, nil
	f.dead = false
	f.nextThink, f.nextAttack, f.launchAt = 0, now() + 1.5, nil
	f.actionStart, f.stunImmuneUntil, f.lastHitAt = 0, 0, 0
	f.anim = ExactAnimator.new(pack, nil, { headless = true, wrapModes = heroCfg.wrapModes })
	f.anim.Event:Connect(function(fn, data, clip) f:onEvent(fn, data, clip) end)
	model:SetAttribute("SPSO_Hero", heroCfg.pack)
	model:SetAttribute("SPSO_Team", team)
	model:SetAttribute("SPSO_Dead", false)
	model:SetAttribute("SPSO_Lock", false)
	CollectionService:AddTag(model, "SPSO_Fighter")
	fighters[model] = f
	return f
end

function Fighter:play(clip: string, fade: number, kind: string)
	seq += 1
	local anim = self.anim
	if anim:IsPlaying(clip) then anim:Stop(clip) end
	anim:CrossFade(clip, fade)
	self.action, self.actionKind = clip, kind
	self.actionStart = now()
	self.hitOpen, self.chainOpen, self.hitSet = false, false, {}
	self.model:SetAttribute("SPSO_Action", string.format("%s|%.4f|%.3f|%d", clip, workspace:GetServerTimeNow(), fade, seq))
	self.model:SetAttribute("SPSO_Lock", kind ~= "emote")
end

function Fighter:clear()
	seq += 1
	self.action, self.actionKind = nil, nil
	self.chainKind, self.chainIndex, self.chainOpen = nil, 0, false
	self.hitOpen, self.launchAt = false, nil
	self.anim:Stop()
	self.model:SetAttribute("SPSO_Action", string.format("none|%.4f|0.2|%d", workspace:GetServerTimeNow(), seq))
	self.model:SetAttribute("SPSO_Lock", false)
end

function Fighter:addPower(n: number)
	self.power = math.clamp(self.power + n, 0, Config.SuperCost)
	if self.player then self.player:SetAttribute("SPSO_Power", self.power) end
end

function Fighter:onEvent(fn: string, _data: string, clip: string)
	if clip ~= self.action then return end
	if fn == "OnCollisionEnableAnimTag" then
		self.hitOpen, self.hitSet = true, {}
	elseif fn == "OnCollisionDisableAnimTag" then
		self.hitOpen = false
	elseif fn == "OnChainAttackAnimTag" and not self.chainOpen then
		self.chainOpen = true
		if self.buffered then
			local k = self.buffered
			self.buffered = nil
			self:tryAttack(k)
		end
	end
end

function Fighter:tryAttack(kind: string)
	if self.dead or self.actionKind == "death" then return end
	if self.actionKind == "recoil" then
		-- heroes can fight out of a small/big recoil (not out of a launch)
		local cancel = self.team == "Hero" and (self.action == "recoil_small" or self.action == "recoil_big")
			and now() - self.actionStart >= Config.RecoilCancel
		if not cancel then return end
		self:clear()
	end
	local busy = self.actionKind == "attack"
	if busy and not self.chainOpen then
		self.buffered = kind
		return
	end
	if kind == "Super" then
		if self.team == "Hero" and self.power < Config.SuperCost then return end
		self:addPower(-Config.SuperCost)
		self.chainKind, self.chainIndex = "Super", 1
		self:play(Config.Chains.Super[1], Config.FadeAttack, "attack")
		return
	end
	local chain = Config.Chains[kind]
	if not chain then return end
	local idx
	if kind == "R" then
		self.rIndex = self.rIndex % #chain + 1
		idx = self.rIndex
	elseif busy and self.chainKind == "L" then
		idx = self.chainIndex + 1
	else
		idx = 1
	end
	if not chain[idx] then return end
	self.chainKind, self.chainIndex = kind, idx
	self:play(chain[idx], Config.FadeAttack, "attack")
end

local function knockback(target, attacker, back: number, up: number)
	if target.team ~= "Enemy" or not target.hrp then return end
	local dir = attacker and attacker.hrp and flat(target.hrp.Position - attacker.hrp.Position) or Vector3.zero
	dir = dir.Magnitude > 0.1 and dir.Unit or -target.hrp.CFrame.LookVector
	target.hum:ChangeState(Enum.HumanoidStateType.Freefall)
	target.hrp.AssemblyLinearVelocity = dir * back + Vector3.new(0, up, 0)
end

local function enemiesLeft(): number
	local n = 0
	for _, f in fighters do
		if f.team == "Enemy" and not f.dead then n += 1 end
	end
	return n
end

function Fighter:die(attacker, data)
	if self.dead then return end
	self.dead = true
	self.buffered = nil
	self.model:SetAttribute("SPSO_Dead", true)
	if self.team == "Enemy" then
		SPSO:SetAttribute("EnemiesLeft", enemiesLeft())
		if data and data.reaction == "launch" then
			knockback(self, attacker, 30, 42)
			self:play("recoil_launch", Config.FadeRecoil, "death")
			task.delay(0.75, function()
				if self.model.Parent then self:play("recoil_launch_land", 0.05, "death") end
			end)
		else
			self:play("recoil_death", Config.FadeRecoil, "death")
		end
		task.delay(Config.Enemy.despawnAfter, function()
			fighters[self.model] = nil
			self.model:Destroy()
		end)
	else
		self:play("recoil_death", Config.FadeRecoil, "death")
		if self.hrp then self.hrp.Anchored = true end
	end
end

function Fighter:takeHit(attacker, data)
	if self.dead then return end
	local dmg = data.damage * (attacker.team == "Enemy" and Config.Enemy.damageScale or 1)
	self.hum.Health = math.max(0, self.hum.Health - dmg)
	if attacker.team == "Hero" then attacker:addPower(Config.PowerPerHit) end
	FxRemote:FireAllClients("hit", {
		pos = self.hrp.Position + Vector3.new(0, 4, 0), amount = math.floor(dmg + 0.5),
		heavy = data.reaction ~= "small", team = self.team,
	})
	if self.team == "Enemy" and attacker.hrp then
		local dir = flat(attacker.hrp.Position - self.hrp.Position)
		if dir.Magnitude > 0.1 then self.hrp.CFrame = CFrame.lookAt(self.hrp.Position, self.hrp.Position + dir) end
	end
	if self.hum.Health <= 0 then
		self:die(attacker, data)
		return
	end
	self.lastHitAt = now()
	if self.team == "Hero" then
		if now() < self.stunImmuneUntil then return end -- damage only while recovering
		self.stunImmuneUntil = now() + Config.HeroStunImmunity
	end
	self.buffered = nil
	local reaction = data.reaction
	if self.team == "Hero" and reaction == "launch" then reaction = "big" end
	if reaction == "launch" then
		self:play("recoil_launch", Config.FadeRecoil, "recoil")
		self.launchAt = now()
		knockback(self, attacker, 26, 38)
	else
		self:play(reaction == "big" and "recoil_big" or "recoil_small", Config.FadeRecoil, "recoil")
	end
	if self.team == "Enemy" then self.nextAttack = math.max(self.nextAttack, now() + 0.9) end
end

function Fighter:checkHits()
	local data = Config.Attacks[self.action]
	if not data or not self.hrp then return end
	local pos, look = self.hrp.Position, flat(self.hrp.CFrame.LookVector).Unit
	local cosArc = math.cos(math.rad(Config.Arc / 2))
	for _, t in fighters do
		if t ~= self and t.team ~= self.team and not t.dead and not self.hitSet[t] and t.hrp and t.hrp.Parent then
			local off = flat(t.hrp.Position - pos)
			local dist = off.Magnitude
			local hit
			if data.radius then
				hit = dist <= data.radius + Config.TargetRadius
			else
				hit = dist <= Config.Reach + Config.TargetRadius and (dist < 3 or look:Dot(off.Unit) >= cosArc)
			end
			if hit and math.abs(t.hrp.Position.Y - pos.Y) < 9 then
				self.hitSet[t] = true
				t:takeHit(self, data)
			end
		end
	end
end

function Fighter:onActionEnd()
	local clip, kind = self.action, self.actionKind
	if kind == "death" then return end
	if clip == "recoil_launch_land" then
		self:play("recoil_getup", 0.1, "recoil")
		return
	end
	local b = self.buffered
	self.buffered = nil
	self:clear()
	if b then self:tryAttack(b) end
end

function Fighter:think()
	local t = now()
	if self.dead or t < self.nextThink then return end
	self.nextThink = t + Config.Enemy.thinkRate
	if self.action then
		self.hum.WalkSpeed = 0
		return
	end
	self.hum.WalkSpeed = Config.Enemy.walkSpeed
	local best, bd
	for _, o in fighters do
		if o.team == "Hero" and not o.dead and o.hrp and o.hrp.Parent then
			local d = flat(o.hrp.Position - self.hrp.Position).Magnitude
			if not bd or d < bd then best, bd = o, d end
		end
	end
	if not best then
		self.hum:Move(Vector3.zero)
		return
	end
	local dir = flat(best.hrp.Position - self.hrp.Position)
	if bd > Config.Enemy.attackRange then
		-- keep a little spacing between enemies
		local push = Vector3.zero
		for _, o in fighters do
			if o ~= self and o.team == "Enemy" and not o.dead and o.hrp then
				local away = flat(self.hrp.Position - o.hrp.Position)
				if away.Magnitude < 6 and away.Magnitude > 0.01 then push += away.Unit * (6 - away.Magnitude) end
			end
		end
		self.hum:MoveTo(best.hrp.Position - dir.Unit * (Config.Enemy.attackRange * 0.7) + push)
	else
		self.hum:Move(Vector3.zero)
		self.hrp.CFrame = CFrame.lookAt(self.hrp.Position, self.hrp.Position + dir)
		local swinging = 0
		for _, o in fighters do
			if o.team == "Enemy" and o.actionKind == "attack" then swinging += 1 end
		end
		if t >= self.nextAttack and swinging < Config.Enemy.maxAttackers and t - best.lastHitAt > Config.Enemy.waitAfterHeroHit then
			local list = Config.Enemy.attacks
			self:play(list[math.random(#list)], Config.FadeAttack, "attack")
			local c = Config.Enemy.cooldown
			self.nextAttack = t + c[1] + math.random() * (c[2] - c[1])
		end
	end
end

RunService.Heartbeat:Connect(function(dt)
	for model, f in fighters do
		if not model.Parent then
			fighters[model] = nil
			continue
		end
		f.anim:Step(dt)
		local d = f.anim:ConsumeRootMotion()
		if f.team == "Enemy" and f.action and d ~= 0 and f.hrp then
			local clip = pack.clips[f.action]
			if clip and clip.rootMotion then f.hrp.CFrame += f.hrp.CFrame.LookVector * d end
		end
		if f.action == "recoil_launch" and f.launchAt and not f.dead and now() - f.launchAt > 0.75 then
			f.launchAt = nil
			f:play("recoil_launch_land", 0.05, "recoil")
		elseif f.action and not f.anim:IsPlaying(f.action) then
			f:onActionEnd()
		end
		if f.hitOpen then f:checkHits() end
		if f.team == "Enemy" then f:think() end
	end
end)

-- players ---------------------------------------------------------------------------------------------
local function setupCharacter(player: Player, char: Model)
	local hum = char:WaitForChild("Humanoid") :: Humanoid
	char:WaitForChild("HumanoidRootPart")
	hum.MaxHealth, hum.Health = heroCfg.health, heroCfg.health
	hum.BreakJointsOnDeath = false
	hum.WalkSpeed = heroCfg.walkSpeed
	hum.UseJumpPower = true
	hum.JumpPower = heroCfg.jumpPower
	char:PivotTo(spawnPoint("Player", player.UserId % 4 + 1) + Vector3.new(0, 4, 0))
	local f = Fighter.new(char, "Hero", player)
	f.power = player:GetAttribute("SPSO_Power") or 0
	hum.Died:Connect(function() f:die(nil, nil) end)
end

local function onPlayer(player: Player)
	player:SetAttribute("SPSO_Power", player:GetAttribute("SPSO_Power") or 0)
	player.CharacterAdded:Connect(function(c) setupCharacter(player, c) end)
	if player.Character then setupCharacter(player, player.Character) end
end
Players.PlayerAdded:Connect(onPlayer)
for _, p in Players:GetPlayers() do task.spawn(onPlayer, p) end

AttackRemote.OnServerEvent:Connect(function(player, kind)
	local f = player.Character and fighters[player.Character]
	if f and (kind == "L" or kind == "R" or kind == "Super") then f:tryAttack(kind) end
end)

EmoteRemote.OnServerEvent:Connect(function(player, idx)
	local f = player.Character and fighters[player.Character]
	if not f or f.dead or type(idx) ~= "number" then return end
	if idx == 0 then
		if f.actionKind == "emote" then f:clear() end
	elseif not f.action and Config.Emotes[idx] then
		f:play(Config.Emotes[idx], 0.25, "emote")
	end
end)

-- enemies and waves ---------------------------------------------------------------------------------
local function spawnEnemy(i: number)
	local template = ServerStorage.SPSO.Characters:FindFirstChild("Enemy_Luchador")
	if not template then return end
	local e = template:Clone()
	local variant = Config.Variants[(i - 1) % #Config.Variants + 1]
	e.Name = Config.Enemy.name .. " " .. variant.name
	e:SetAttribute("SPSO_Variant", variant.name)
	local body = e:FindFirstChild(heroCfg.bodyPart, true)
	local head = e:FindFirstChild(heroCfg.headPart, true)
	if body and variant.body then body.TextureID = variant.body end
	if head and variant.head then head.TextureID = variant.head end
	local hum = e:FindFirstChildOfClass("Humanoid")
	hum.MaxHealth, hum.Health = Config.Enemy.health, Config.Enemy.health
	hum.BreakJointsOnDeath = false
	hum.WalkSpeed = Config.Enemy.walkSpeed
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	e:PivotTo(spawnPoint("Enemy", i) + Vector3.new(math.random() * 4 - 2, 4, math.random() * 4 - 2))
	e.Parent = enemyFolder
	e.HumanoidRootPart:SetNetworkOwner(nil)
	local f = Fighter.new(e, "Enemy", nil)
	f.nextAttack = now() + 1.2 + math.random() * 1.5
	hum.Died:Connect(function() f:die(nil, nil) end)
end

local function banner(text: string)
	SPSO:SetAttribute("Banner", text)
	SPSO:SetAttribute("BannerSeq", (SPSO:GetAttribute("BannerSeq") or 0) + 1)
end

local function heroAlive(): boolean
	for _, f in fighters do
		if f.team == "Hero" and not f.dead then return true end
	end
	return false
end

task.spawn(function()
	SPSO:SetAttribute("Waves", #Config.Waves)
	while true do
		repeat task.wait(1) until heroAlive()
		for w, count in Config.Waves do
			SPSO:SetAttribute("Wave", w)
			banner("WAVE " .. w)
			task.wait(2.5)
			for i = 1, count do
				spawnEnemy(i + w)
				task.wait(0.35)
			end
			SPSO:SetAttribute("EnemiesLeft", enemiesLeft())
			repeat task.wait(0.5) until enemiesLeft() == 0
			task.wait(Config.WaveBreak)
		end
		banner("VICTORY!")
		for _, f in fighters do
			if f.team == "Hero" and not f.dead and not f.action then f:play("emote_victory", 0.25, "emote") end
		end
		task.wait(8)
		for _, f in fighters do
			if f.team == "Hero" and not f.dead then f.hum.Health = f.hum.MaxHealth end
		end
	end
end)
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000018"><Properties><string name="Name">StarterPlayer/StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX000009"><Properties><string name="Name">BrawlerClient</string><ProtectedString name="Source"><![CDATA[-- SPSO brawler client: animates every fighter with the exact animation runtime, the original
-- brawler-style fixed camera, input (attacks, super, emotes), HUD, hit effects.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local SPSO = ReplicatedStorage:WaitForChild("SPSO")
local Game = SPSO:WaitForChild("Game")
local Config = require(Game:WaitForChild("GameConfig"))
local Net = require(Game:WaitForChild("Net"))
local CharacterAnimator = require(Game:WaitForChild("CharacterAnimator"))

local player = Players.LocalPlayer
local AttackRemote, EmoteRemote, FxRemote = Net.event("Attack"), Net.event("Emote"), Net.event("Fx")
local heroCfg = Config.Heroes[Config.PlayerHero]

-- animators for every fighter ----------------------------------------------------------------------------
local animators = {}
local healthBars = {}

local function makeHealthBar(model: Model)
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local bb = Instance.new("BillboardGui")
	bb.Name = "SPSO_Health"
	bb.Size = UDim2.fromOffset(90, 10)
	bb.StudsOffset = Vector3.new(0, 5.6, 0)
	bb.AlwaysOnTop = true
	bb.Adornee = hrp
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.fromRGB(25, 20, 30)
	bg.BorderSizePixel = 0
	bg.Parent = bb
	Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 4)
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(235, 70, 70)
	fill.BorderSizePixel = 0
	fill.Parent = bg
	Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 4)
	bb.Parent = player:WaitForChild("PlayerGui")
	healthBars[model] = { gui = bb, fill = fill }
end

local function attach(model: Instance)
	if not model:IsA("Model") or animators[model] then return end
	animators[model] = "pending"
	task.spawn(function()
		local root = model:WaitForChild("RootPart", 10)
		local hrp = model:WaitForChild("HumanoidRootPart", 10)
		if not root or not hrp then
			animators[model] = nil
			return
		end
		local t0 = os.clock()
		while #root:GetDescendants() < 39 and os.clock() - t0 < 10 do task.wait() end
		local isLocal = model == player.Character
		local variant = model:GetAttribute("SPSO_Variant")
		local enemy = model:GetAttribute("SPSO_Team") == "Enemy"
		local ok, ca = pcall(CharacterAnimator.new, model, {
			-- exact bone-scale skinning (EditableMesh) for the local hero; others use the bones (memory budget)
			isLocal = isLocal, skin = isLocal, prebuildSkin = isLocal,
			faces = not (variant and variant ~= ""), lodDistance = 300,
		})
		if not ok then
			warn("[SPSO] animator failed for " .. model:GetFullName() .. ": " .. tostring(ca))
			animators[model] = nil
			return
		end
		if not model.Parent then
			ca:Destroy()
			animators[model] = nil
			return
		end
		animators[model] = ca
		if enemy then makeHealthBar(model) end
	end)
end

local function detach(model: Instance)
	local ca = animators[model]
	if type(ca) == "table" then ca:Destroy() end
	animators[model] = nil
	local hb = healthBars[model]
	if hb then hb.gui:Destroy() end
	healthBars[model] = nil
end

CollectionService:GetInstanceAddedSignal("SPSO_Fighter"):Connect(attach)
CollectionService:GetInstanceRemovedSignal("SPSO_Fighter"):Connect(detach)
for _, m in CollectionService:GetTagged("SPSO_Fighter") do attach(m) end

-- camera ----------------------------------------------------------------------------------------------------
local camera = workspace.CurrentCamera
local zoom, camFocus, shake = 1, nil, 0
UserInputService.InputChanged:Connect(function(input, gp)
	if not gp and input.UserInputType == Enum.UserInputType.MouseWheel then
		zoom = math.clamp(zoom - input.Position.Z * 0.08, Config.Camera.zoomMin, Config.Camera.zoomMax)
	end
end)

local function updateCamera(dt: number)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	camera.CameraType = Enum.CameraType.Scriptable
	local focus = hrp.Position * Vector3.new(1, 0, 1) + Vector3.new(0, hrp.Position.Y - 3.3 + Config.Camera.lookHeight, 0)
	camFocus = camFocus and camFocus:Lerp(focus, 1 - math.exp(-7 * dt)) or focus
	local jitter = Vector3.zero
	if shake > 0 then
		shake = math.max(0, shake - dt * 2.5)
		jitter = Vector3.new(math.random() - 0.5, math.random() - 0.5, 0) * shake
	end
	camera.FieldOfView = Config.Camera.fov
	camera.CFrame = CFrame.lookAt(camFocus + Config.Camera.offset * zoom + jitter, camFocus + jitter * 0.5)
end

-- movement lock during actions, emote cancel by moving ------------------------------------------------------
local function updateLocal()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	local locked = char:GetAttribute("SPSO_Lock") == true or char:GetAttribute("SPSO_Dead") == true
	hum.WalkSpeed = locked and 0 or heroCfg.walkSpeed
	hum.UseJumpPower = true
	hum.JumpPower = locked and 0 or heroCfg.jumpPower
	hum.AutoRotate = not locked
	local ca = animators[char]
	if type(ca) == "table" and ca:Current() and string.sub(ca:Current(), 1, 6) == "emote_" and hum.MoveDirection.Magnitude > 0.1 then
		EmoteRemote:FireServer(0)
	end
end

-- input ----------------------------------------------------------------------------------------------------
local function faceNearestEnemy()
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp or char:GetAttribute("SPSO_Lock") then return end
	local best, bd = nil, 16
	for m in animators do
		if m:GetAttribute("SPSO_Team") == "Enemy" and not m:GetAttribute("SPSO_Dead") and m.PrimaryPart then
			local d = (m.PrimaryPart.Position - hrp.Position).Magnitude
			if d < bd then best, bd = m.PrimaryPart, d end
		end
	end
	if best then
		local dir = (best.Position - hrp.Position) * Vector3.new(1, 0, 1)
		if dir.Magnitude > 0.1 then hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + dir) end
	end
end

local function bind(name: string, kind: string, ...)
	ContextActionService:BindAction(name, function(_, state)
		if state == Enum.UserInputState.Begin then
			faceNearestEnemy()
			AttackRemote:FireServer(kind)
		end
		return Enum.ContextActionResult.Sink
	end, true, ...)
	ContextActionService:SetTitle(name, kind == "Super" and "SUPER" or kind)
end
bind("SPSO_L", "L", Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonX)
bind("SPSO_R", "R", Enum.UserInputType.MouseButton2, Enum.KeyCode.ButtonY)
bind("SPSO_Super", "Super", Enum.KeyCode.F, Enum.KeyCode.ButtonB)
UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	local keys = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four }
	local i = table.find(keys, input.KeyCode)
	if i then EmoteRemote:FireServer(i) end
end)

-- HUD ------------------------------------------------------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "SPSO_HUD"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = player:WaitForChild("PlayerGui")

local function label(parent, text, size, pos, ts, color)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size, l.Position = size, pos
	l.Font = Enum.Font.FredokaOne
	l.Text, l.TextSize = text, ts
	l.TextColor3 = color or Color3.new(1, 1, 1)
	l.TextStrokeTransparency = 0.4
	l.Parent = parent
	return l
end

local function bar(parent, y, color)
	local bg = Instance.new("Frame")
	bg.Size, bg.Position = UDim2.new(1, -24, 0, 16), UDim2.fromOffset(12, y)
	bg.BackgroundColor3 = Color3.fromRGB(20, 24, 40)
	bg.BorderSizePixel = 0
	bg.Parent = parent
	Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 6)
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = color
	fill.BorderSizePixel = 0
	fill.Parent = bg
	Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 6)
	return fill
end

local panel = Instance.new("Frame")
panel.Size, panel.Position = UDim2.fromOffset(300, 104), UDim2.fromOffset(16, 16)
panel.BackgroundColor3 = Color3.fromRGB(14, 40, 62)
panel.BackgroundTransparency = 0.2
panel.Parent = gui
Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 12)
local stroke = Instance.new("UIStroke", panel)
stroke.Color, stroke.Thickness = Color3.fromRGB(120, 220, 235), 2
local nameLabel = label(panel, string.upper(heroCfg.displayName), UDim2.new(1, -24, 0, 28), UDim2.fromOffset(12, 6), 24)
nameLabel.TextXAlignment = Enum.TextXAlignment.Left
local hpFill = bar(panel, 40, Color3.fromRGB(235, 70, 70))
local pwFill = bar(panel, 64, Color3.fromRGB(255, 200, 60))
local pwLabel = label(panel, "", UDim2.new(1, -24, 0, 16), UDim2.fromOffset(12, 83), 14, Color3.fromRGB(255, 225, 140))
pwLabel.TextXAlignment = Enum.TextXAlignment.Left

local waveLabel = label(gui, "", UDim2.fromOffset(400, 34), UDim2.new(0.5, -200, 0, 18), 28)
local bannerLabel = label(gui, "", UDim2.fromOffset(900, 120), UDim2.new(0.5, -450, 0.32, 0), 96, Color3.fromRGB(255, 230, 120))
bannerLabel.TextTransparency, bannerLabel.TextStrokeTransparency = 1, 1
local hint = label(gui, "WASD move  •  Space jump  •  Left click combo  •  Right click heavy  •  F super  •  1-4 emotes",
	UDim2.new(1, -32, 0, 22), UDim2.new(0, 16, 1, -34), 18, Color3.fromRGB(210, 240, 245))
hint.TextXAlignment = Enum.TextXAlignment.Left

local lastBanner = SPSO:GetAttribute("BannerSeq")
local function showBanner()
	bannerLabel.Text = SPSO:GetAttribute("Banner") or ""
	bannerLabel.TextTransparency, bannerLabel.TextStrokeTransparency = 0, 0.2
	bannerLabel.TextSize = 120
	TweenService:Create(bannerLabel, TweenInfo.new(0.35, Enum.EasingStyle.Back), { TextSize = 96 }):Play()
	task.delay(1.8, function()
		TweenService:Create(bannerLabel, TweenInfo.new(0.6), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	end)
end
SPSO:GetAttributeChangedSignal("BannerSeq"):Connect(function()
	if SPSO:GetAttribute("BannerSeq") ~= lastBanner then
		lastBanner = SPSO:GetAttribute("BannerSeq")
		showBanner()
	end
end)

local function updateHUD()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then hpFill.Size = UDim2.fromScale(math.clamp(hum.Health / math.max(1, hum.MaxHealth), 0, 1), 1) end
	local power = player:GetAttribute("SPSO_Power") or 0
	pwFill.Size = UDim2.fromScale(math.clamp(power / Config.SuperCost, 0, 1), 1)
	pwLabel.Text = power >= Config.SuperCost and "SUPER READY — press F" or "POWER"
	local w = SPSO:GetAttribute("Wave")
	waveLabel.Text = w and string.format("WAVE %d / %d   •   RIVALS LEFT %d", w, SPSO:GetAttribute("Waves") or 0, SPSO:GetAttribute("EnemiesLeft") or 0) or ""
	for model, hb in healthBars do
		local h = model:FindFirstChildOfClass("Humanoid")
		if h then
			hb.fill.Size = UDim2.fromScale(math.clamp(h.Health / math.max(1, h.MaxHealth), 0, 1), 1)
			hb.gui.Enabled = h.Health > 0
		end
	end
end

-- hit effects ------------------------------------------------------------------------------------------------
FxRemote.OnClientEvent:Connect(function(kind, data)
	if kind ~= "hit" then return end
	local spark = Instance.new("Part")
	spark.Shape = Enum.PartType.Ball
	spark.Material = Enum.Material.Neon
	spark.Color = data.team == "Hero" and Color3.fromRGB(255, 90, 90) or Color3.fromRGB(255, 230, 120)
	spark.Anchored, spark.CanCollide, spark.CanQuery, spark.CanTouch, spark.CastShadow = true, false, false, false, false
	spark.Size = Vector3.one * 1.5
	spark.Position = data.pos
	spark.Parent = workspace
	TweenService:Create(spark, TweenInfo.new(0.25), { Size = Vector3.one * (data.heavy and 7 or 4.5), Transparency = 1 }):Play()
	game:GetService("Debris"):AddItem(spark, 0.3)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(120, 50)
	bb.StudsOffsetWorldSpace = Vector3.new(math.random() * 2 - 1, 1, 0)
	bb.AlwaysOnTop = true
	local holder = Instance.new("Attachment")
	holder.WorldPosition = data.pos
	holder.Parent = workspace.Terrain
	bb.Adornee = holder
	local t = label(bb, tostring(data.amount), UDim2.fromScale(1, 1), UDim2.new(), data.heavy and 40 or 30,
		data.team == "Hero" and Color3.fromRGB(255, 110, 110) or Color3.fromRGB(255, 240, 150))
	bb.Parent = gui
	TweenService:Create(bb, TweenInfo.new(0.8), { StudsOffsetWorldSpace = bb.StudsOffsetWorldSpace + Vector3.new(0, 4, 0) }):Play()
	TweenService:Create(t, TweenInfo.new(0.8), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	task.delay(0.85, function()
		bb:Destroy()
		holder:Destroy()
	end)
	if data.heavy then shake = math.max(shake, 0.9) end
end)

-- frame loop -------------------------------------------------------------------------------------------------
RunService.PreRender:Connect(function(dt)
	for model, ca in animators do
		if type(ca) == "table" then
			if not model.Parent then
				detach(model)
			else
				local ok, err = pcall(ca.Update, ca, dt)
				if not ok then
					warn("[SPSO] " .. tostring(err))
					detach(model)
				end
			end
		end
	end
	updateLocal()
	updateCamera(dt)
	updateHUD()
end)
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000019"><Properties><string name="Name">StarterPlayer/StarterCharacterScripts</string></Properties><Item class="LocalScript" referent="RBX000010"><Properties><string name="Name">Animate</string><ProtectedString name="Source"><![CDATA[-- Replaces Roblox's default Animate script: SPSO characters are animated by the exact animation
-- runtime (ReplicatedStorage.SPSO.Runtime.ExactAnimator) from StarterPlayerScripts.BrawlerClient.
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX000011"><Properties><string name="Name">Health</string><ProtectedString name="Source"><![CDATA[-- Replaces Roblox's default Health regeneration: health is managed by the brawler server.
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000020"><Properties><string name="Name">ServerStorage/SPSO/Setup</string></Properties><Item class="ModuleScript" referent="RBX000012"><Properties><string name="Name">01_world</string><ProtectedString name="Source"><![CDATA[-- SPSO world setup (Studio, Edit mode; idempotent):
--   require(game.ServerStorage.SPSO.Setup["01_world"])()
-- * archives the template baseplate / spawn and old test objects (ServerStorage.SPSO_Archive, nothing deleted)
-- * builds the playable character templates from the uploaded El Rugido model:
--     ServerStorage.SPSO.Characters.Hero_ElRugido / Enemy_Luchador, StarterPlayer.StarterCharacter
-- * configures the arena (workspace.OrbitalArena from the uploaded model: collision, glass, spawns), or builds
--   a simple placeholder arena with the same layout when the map has not been inserted yet
-- * lighting and player settings
return function(): string
	local ServerStorage = game:GetService("ServerStorage")
	local StarterPlayer = game:GetService("StarterPlayer")
	local Lighting = game:GetService("Lighting")
	local log = {}

	local function folder(parent: Instance, name: string): Instance
		local f = parent:FindFirstChild(name)
		if not f then
			f = Instance.new("Folder")
			f.Name = name
			f.Parent = parent
		end
		return f
	end
	local spso = folder(ServerStorage, "SPSO")
	local archive = folder(ServerStorage, "SPSO_Archive")

	for _, n in { "Baseplate", "SpawnLocation", "ElRugido_ExactSkinTest" } do
		local o = workspace:FindFirstChild(n)
		if o then
			o.Parent = archive
			table.insert(log, "archived " .. n)
		end
	end

	-- hero source model (the uploaded El Rugido asset)
	local source = folder(spso, "Source")
	local import = workspace:FindFirstChild("ElRugido_Import") or source:FindFirstChild("ElRugido_Import")
	assert(import, "El Rugido model not found (workspace.ElRugido_Import)")
	import.Parent = source
	local rigSrc = import:FindFirstChild("ElRugido")
	assert(rigSrc and rigSrc:FindFirstChild("RootPart"), "ElRugido_Import.ElRugido.RootPart missing")

	-- playable character: Humanoid + HumanoidRootPart driving the skinned rig (animated by script)
	local HIP, HRP_SIZE = 2.0, Vector3.new(3, 2.6, 2)
	local function buildCharacter(name: string): Model
		local char = Instance.new("Model")
		char.Name = name
		local rig = rigSrc:Clone()
		for _, c in rig:GetChildren() do
			if c:IsA("AnimationController") then
				c:Destroy()
			else
				c.Parent = char
			end
		end
		rig:Destroy()
		local root = char:FindFirstChild("RootPart") :: BasePart
		root.CFrame = CFrame.new(0, 0, 0)
		local hrp = Instance.new("Part")
		hrp.Name = "HumanoidRootPart"
		hrp.Size = HRP_SIZE
		hrp.Transparency = 1
		hrp.CanCollide, hrp.Anchored = true, false
		hrp.TopSurface, hrp.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		hrp.CFrame = CFrame.new(0, HIP + HRP_SIZE.Y / 2, 0)
		hrp.Parent = char
		for _, p in char:GetDescendants() do
			if p:IsA("BasePart") and p ~= hrp then
				p.Anchored, p.CanCollide, p.CanTouch, p.Massless = false, false, false, true
				p.CanQuery = false
				if p == root then p.Transparency = 1 end
			end
		end
		local m6 = Instance.new("Motor6D")
		m6.Name = "RigRoot"
		m6.Part0, m6.Part1 = hrp, root
		m6.C0 = CFrame.new(0, -(HIP + HRP_SIZE.Y / 2), 0)
		m6.Parent = hrp
		local hum = Instance.new("Humanoid")
		hum.RigType = Enum.HumanoidRigType.R15
		hum.HipHeight = HIP
		hum.BreakJointsOnDeath = false
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		hum.Parent = char
		char.PrimaryPart = hrp
		return char
	end
	local chars = folder(spso, "Characters")
	for _, n in { "Hero_ElRugido", "Enemy_Luchador" } do
		local old = chars:FindFirstChild(n)
		if old then old:Destroy() end
		buildCharacter(n).Parent = chars
	end
	local sc = StarterPlayer:FindFirstChild("StarterCharacter")
	if sc then sc:Destroy() end
	local starter = buildCharacter("StarterCharacter")
	starter.Parent = StarterPlayer
	table.insert(log, "characters built")

	-- arena
	local arena = workspace:FindFirstChild("OrbitalArena")
	if arena and arena:GetAttribute("Placeholder") and workspace:FindFirstChild("OrbitalArena_Real") then
		arena:Destroy()
		arena = workspace.OrbitalArena_Real
		arena.Name = "OrbitalArena"
	end
	if not arena then
		-- placeholder with the real arena's footprint (floor radius ~49 studs, back wall at -Z)
		arena = Instance.new("Model")
		arena.Name = "OrbitalArena"
		arena:SetAttribute("Placeholder", true)
		local floor = Instance.new("Part")
		floor.Name = "Floor"
		floor.Shape = Enum.PartType.Cylinder
		floor.Size = Vector3.new(2, 100, 100)
		floor.CFrame = CFrame.new(0, -1, 0) * CFrame.Angles(0, 0, math.rad(90))
		floor.Color = Color3.fromRGB(150, 214, 222)
		floor.Material = Enum.Material.SmoothPlastic
		floor.Anchored = true
		floor.Parent = arena
		for i = 0, 31 do
			local a = i / 32 * math.pi * 2
			local w = Instance.new("Part")
			w.Name = "Wall"
			w.Size = Vector3.new(10.4, 26, 2)
			w.CFrame = CFrame.new(math.sin(a) * 51, 12, math.cos(a) * 51) * CFrame.Angles(0, a, 0)
			w.Color = Color3.fromRGB(38, 120, 150)
			w.Material = Enum.Material.SmoothPlastic
			w.Anchored = true
			w.Transparency = (math.cos(a) > 0.5) and 0.85 or 0
			w.Parent = arena
		end
		arena.Parent = workspace
		table.insert(log, "placeholder arena built")
	else
		-- the FBX import puts the back wall (medallion) at +Z; the game expects it at -Z
		local med = arena:FindFirstChild("OrbitalArena_Medallion", true)
		if med and med.Position.Z > 0 then
			for _, p in arena:GetChildren() do
				if p:IsA("MeshPart") then p.CFrame = CFrame.Angles(0, math.pi, 0) * p.CFrame end
			end
		end
		local door = arena:FindFirstChild("OrbitalArena_IrisDoor_Left", true)
		if door then pcall(function() door.DoubleSided = true end) end -- mirrored in the source scene
		for _, p in arena:GetDescendants() do
			if p:IsA("BasePart") and p.Parent and p.Parent.Name ~= "Collision" then
				p.Anchored = true
				p.CanCollide, p.CanQuery, p.CanTouch = false, false, false
				p.CastShadow = false
				if string.find(p.Name, "_Collision") then p.Transparency = 1 end
				if string.find(p.Name, "Glass") then p.Transparency = 0.55 end
			end
		end
		-- collision from primitives: the original collision mesh is a flat floor inside a 12-sided wall
		-- (a convex decomposition of it fills the bowl, so it is only kept as reference)
		local col = arena:FindFirstChild("Collision")
		if col then col:Destroy() end
		col = Instance.new("Folder")
		col.Name = "Collision"
		local function box(name, cf, size)
			local b = Instance.new("Part")
			b.Name, b.CFrame, b.Size = name, cf, size
			b.Transparency, b.Anchored, b.CanCollide, b.CanQuery, b.CanTouch = 1, true, true, true, false
			b.TopSurface, b.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
			b.Parent = col
		end
		local floorY, wallH = 0, 85
		local floorPart = Instance.new("Part")
		floorPart.Name, floorPart.Shape = "Floor", Enum.PartType.Cylinder
		floorPart.Size = Vector3.new(4, 104, 104)
		floorPart.CFrame = CFrame.new(0, floorY - 2, 0) * CFrame.Angles(0, 0, math.rad(90))
		floorPart.Transparency, floorPart.Anchored, floorPart.CanCollide, floorPart.CanQuery = 1, true, true, true
		floorPart.Parent = col
		local poly = { {49.5, -13.2}, {49.5, 13.3}, {36.3, 36.3}, {13.3, 49.5}, {-13.3, 49.5}, {-36.3, 36.3},
			{-49.5, 13.3}, {-49.5, -13.2}, {-36.3, -36.2}, {-13.3, -49.5}, {13.3, -49.5}, {36.3, -36.2} }
		for i, a in poly do
			local b = poly[i % #poly + 1]
			local pa, pb = Vector3.new(a[1], 0, a[2]), Vector3.new(b[1], 0, b[2])
			local mid, len = (pa + pb) / 2, (pb - pa).Magnitude
			local out = mid.Unit
			local cf = CFrame.lookAt(mid + out * 2 + Vector3.new(0, floorY + wallH / 2, 0), mid + out * 3 + Vector3.new(0, floorY + wallH / 2, 0))
			box("Wall" .. i, cf, Vector3.new(len + 4, wallH, 4))
		end
		col.Parent = arena
		local sf = arena:FindFirstChild("SafetyFloor")
		if sf then sf:Destroy() end
		table.insert(log, "arena configured")
	end
	local spawns = arena:FindFirstChild("Spawns")
	if spawns then spawns:Destroy() end
	spawns = Instance.new("Folder")
	spawns.Name = "Spawns"
	local function marker(name: string, pos: Vector3, face: Vector3)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = Vector3.new(2, 0.2, 2)
		p.CFrame = CFrame.lookAt(pos, pos + face)
		p.Transparency = 1
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
		p.Parent = spawns
	end
	for i, x in { -8, 8, -16, 16 } do marker("Player" .. i, Vector3.new(x, 0.2, 30 - math.abs(x) / 4), Vector3.new(0, 0, -1)) end
	local enemyPts = { Vector3.new(-30, 0.2, -26), Vector3.new(30, 0.2, -26), Vector3.new(0, 0.2, -38), Vector3.new(-42, 0.2, 2),
		Vector3.new(42, 0.2, 2), Vector3.new(-18, 0.2, -40), Vector3.new(18, 0.2, -40), Vector3.new(0, 0.2, -18) }
	for i, p in enemyPts do marker(string.format("Enemy%02d", i), p, Vector3.new(0, 0, 1)) end
	spawns.Parent = arena

	-- settings
	workspace.StreamingEnabled = false
	StarterPlayer.LoadCharacterAppearance = false
	StarterPlayer.CharacterWalkSpeed = 24
	StarterPlayer.CharacterUseJumpPower = true
	StarterPlayer.CharacterJumpPower = 62
	Lighting.Brightness = 2
	Lighting.Ambient = Color3.fromRGB(96, 106, 120)
	Lighting.OutdoorAmbient = Color3.fromRGB(128, 138, 150)
	Lighting.ClockTime = 14.5
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.4
	Lighting.EnvironmentSpecularScale = 0.2
	table.insert(log, "settings applied")
	return table.concat(log, "; ")
end
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000021"><Properties><string name="Name">ServerStorage/SPSO/Tools</string></Properties><Item class="ModuleScript" referent="RBX000013"><Properties><string name="Name">Unpack</string><ProtectedString name="Source"><![CDATA[-- SPSO package unpacker (Studio, Edit mode). Inserts the SPSO_Package model asset (built by
-- tools/build_rbxmx_package.py, uploaded from Blender) and moves every item to its destination,
-- replacing same-named items there. Returns a short report.
--   require(game.ServerStorage.SPSO.Tools.Unpack)(assetId)
return function(source: any): string
	local model = source
	if type(source) == "number" then
		model = game:GetService("InsertService"):LoadAsset(source)
	end
	local pkg = model:FindFirstChild("SPSO_Package", true)
	assert(pkg, "no SPSO_Package in the asset")
	local version = pkg:FindFirstChild("_version")
	local moved = 0
	for _, dest in pkg:GetChildren() do
		if dest:IsA("Folder") then
			local parts = string.split(dest.Name, "/")
			local target: Instance = game:GetService(parts[1])
			for i = 2, #parts do
				local c = target:FindFirstChild(parts[i])
				if not c then
					c = Instance.new("Folder")
					c.Name = parts[i]
					c.Parent = target
				end
				target = c
			end
			for _, it in dest:GetChildren() do
				local meta = it:FindFirstChild("_meta")
				if meta and meta:IsA("StringValue") then
					local m = game:GetService("HttpService"):JSONDecode(meta.Value)
					it:SetAttribute("Chunks", m.chunks)
					it:SetAttribute("Bytes", m.bytes)
					it:SetAttribute("Sha", m.sha)
					meta:Destroy()
				end
				local old = target:FindFirstChild(it.Name)
				if old and old ~= it then old:Destroy() end
				it.Parent = target
				moved += 1
			end
		end
	end
	if model ~= source or type(source) == "number" then model:Destroy() end
	return string.format("unpacked %d items (version %s)", moved, version and version.Value or "?")
end
]]></ProtectedString></Properties></Item></Item></Item></roblox>