img(results, "bh_backstar", { Size = UDim2.fromOffset(330, 330), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.4) })
local sparkles = img(results, "bh_mc_sparkles", { Size = UDim2.fromOffset(360, 360), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.4) })
local bigMedal = img(results, "bh_brawler_points_gold", { Size = UDim2.fromOffset(190, 190), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.4) })
text(results, "MISSION COMPLETE!", { Font = HEADING, TextSize = 72, Size = UDim2.new(1, 0, 0, 80), Position = UDim2.fromScale(0, 0.08),
	TextColor3 = Color3.fromRGB(255, 220, 80), TextStrokeTransparency = 0 })
local medalText = text(results, "", { Font = HEADING, TextSize = 44, Size = UDim2.new(1, 0, 0, 50), Position = UDim2.fromScale(0, 0.58) })
local resPanel = img(results, "bh_background", { Size = UDim2.fromOffset(520, 170), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.66) })
local resText = text(resPanel, "", { TextSize = 22, Size = UDim2.new(0.86, 0, 0.8, 0), Position = UDim2.fromScale(0.07, 0.1),
	TextWrapped = true, TextColor3 = Color3.fromRGB(40, 60, 10), TextStrokeTransparency = 1 })
local MEDAL_COLORS = { Bronze = Color3.fromRGB(205, 127, 50), Silver = Color3.fromRGB(200, 210, 220), Gold = Color3.fromRGB(255, 205, 40),
	Adamantium = Color3.fromRGB(120, 230, 255) }
SPSO:GetAttributeChangedSignal("State"):Connect(function()
	local s = SPSO:GetAttribute("State")
	if s == "results" then
		local medal = SPSO:GetAttribute("Medal") or "Bronze"
		medalText.Text = string.upper(medal) .. " MEDAL"
		medalText.TextColor3 = MEDAL_COLORS[medal] or Color3.new(1, 1, 1)
		bigMedal.Image = G["bh_brawler_points_" .. string.lower(medal)] or ""
		resText.Text = string.format("Team score %d\nKnockouts %d  •  Time %d:%02d\nSilver %d  •  Gold %d  •  Adamantium %d",
			SPSO:GetAttribute("TeamScore") or 0, SPSO:GetAttribute("KOs") or 0, (SPSO:GetAttribute("RunTime") or 0) // 60,
			(SPSO:GetAttribute("RunTime") or 0) % 60, SPSO:GetAttribute("MedalSilver") or 0, SPSO:GetAttribute("MedalGold") or 0,
			SPSO:GetAttribute("MedalAdamantium") or 0)
		results.Enabled = true
		bigMedal.Size = UDim2.fromOffset(40, 40)
		TweenService:Create(bigMedal, TweenInfo.new(0.6, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(190, 190) }):Play()
		Sound.music(Config.Music.complete)
		Sound.play("FX_Brawler_game_Mission_Complete_Fireworks", { channel = "ui" })
		Sound.play("FX_Brawler_Cheer", { channel = "ui" })
		task.delay(5.5, function() if results.Enabled then Sound.music(Config.Music.completeLoop) end end)
		task.delay(Config.ResultsTime - 1, function() results.Enabled = false end)
	elseif s == "playing" then
		results.Enabled = false
	end
end)
RunService.RenderStepped:Connect(function(dt)
	if results.Enabled then
		rays1.Rotation += dt * 8
		rays2.Rotation -= dt * 12
		sparkles.Rotation += dt * 20
	end
end)

-- frame loop -----------------------------------------------------------------------------------------------------------------------
local loadingDone = false
RunService.PreRender:Connect(function(dt)
	if not loadingDone then
		rays.Rotation += dt * 6
		star.Rotation += dt * 180
		barFill.Size = UDim2.new(0.84 * loadProgress, 0, 0.38, 0)
		loadText.Text = string.format("LOADING... %d%%", math.floor(loadProgress * 100))
		if loadProgress >= 1 then
			loadingDone = true
			TweenService:Create(tipText, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
			task.delay(0.3, function()
				loading.Enabled = false
				if not player.Character then showSelect() end
			end)
		end
	end
	if selecting then
		selRays.Rotation += dt * 4
		for _, p in previews do p.anim:Step(dt) end
	end
	for model, ca in animators do
		if type(ca) == "table" then
			if not model.Parent then
				detach(model)
			else
				local ok, err = pcall(ca.Update, ca, dt)
				if not ok then
					warn("[SPSO] " .. tostring(err))
					detach(model)
				end
			end
		end
	end
	FxPlayer.update(dt)
	for id, v in projVisuals do
		if os.clock() > v.expires or not v.part.Parent then
			v.part:Destroy()
			projVisuals[id] = nil
		else
			v.vel += Vector3.new(0, -v.g * dt, 0)
			v.part.Position += v.vel * dt
		end
	end
	updateLocal()
	updateCamera(dt)
	updateHUD(dt)
end)

player.CharacterAdded:Connect(function(char)
	task.spawn(function() -- the original heroes never climb walls (wall-crawlers have their own movement)
		local hum = char:WaitForChild("Humanoid", 10)
		if hum then hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, false) end
	end)
	selecting = false
	selectGui.Enabled = false
	if loadingDone and not inHub() then Sound.music(SPSO:GetAttribute("Music") or Config.Music.loading) end
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX000017"><Properties><string name="Name">HubClient</string><ProtectedString name="Source"><![CDATA[-- SPSO social zones, client: the original social camera (a fixed boom behind the hero, zoom between the zone's
-- "zoom" and "forward" booms), the zone's ambient light, the hub HUD (zone name, fractals, hero tokens, stars,
-- zone travel), collectible spin and pickup pops. Active while the player's zone is a hub zone.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local SPSO = ReplicatedStorage:WaitForChild("SPSO")
local Game = SPSO:WaitForChild("Game")
local Config = require(Game:WaitForChild("GameConfig"))
local Net = require(Game:WaitForChild("Net"))
local Sound = require(Game:WaitForChild("Sound"))
local HubData = Config.HubData
if not HubData or Config.Mode ~= "Hub" then return end
local HubRemote = Net.event("Hub")
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local function zone()
	local z = player:GetAttribute("SPSO_Zone")
	return z and HubData.Zones[z] and z or nil
end

-- HUD -----------------------------------------------------------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "SPSO_Hub"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Enabled = false
gui.Parent = player:WaitForChild("PlayerGui")
local function label(parent, text, size, pos, color)
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size, t.Position = size, pos
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.TextColor3 = color or Color3.new(1, 1, 1)
	t.TextStrokeTransparency = 0.25
	t.Text = text
	t.Parent = parent
	return t
end
local title = label(gui, "", UDim2.new(0.4, 0, 0.055, 0), UDim2.new(0.3, 0, 0.02, 0), Color3.fromRGB(255, 236, 140))
local bar = Instance.new("Frame")
bar.Size, bar.Position = UDim2.new(0, 330, 0, 54), UDim2.new(0, 16, 1, -70)
bar.BackgroundColor3 = Color3.fromRGB(28, 40, 74)
bar.BackgroundTransparency = 0.15
bar.Parent = gui
Instance.new("UICorner", bar).CornerRadius = UDim.new(0, 14)
local counts = {}
for i, k in { "Fractals", "Tokens", "Stars" } do
	local icon = Instance.new("Frame")
	icon.Size, icon.Position = UDim2.new(0, 26, 0, 26), UDim2.new(0, 14 + (i - 1) * 105, 0.5, -13)
	icon.BackgroundColor3 = ({ Color3.fromRGB(176, 104, 255), Color3.fromRGB(255, 205, 60), Color3.fromRGB(150, 230, 255) })[i]
	icon.Rotation = i == 1 and 45 or 0
	icon.Parent = bar
	Instance.new("UICorner", icon).CornerRadius = UDim.new(i == 1 and 0 or 1, 0)
	counts[k] = label(bar, "0", UDim2.new(0, 60, 0, 32), UDim2.new(0, 46 + (i - 1) * 105, 0.5, -16))
	counts[k].TextXAlignment = Enum.TextXAlignment.Left
end
local zonesBtn = Instance.new("TextButton")
zonesBtn.Size, zonesBtn.Position = UDim2.new(0, 120, 0, 44), UDim2.new(1, -136, 1, -64)
zonesBtn.BackgroundColor3 = Color3.fromRGB(240, 150, 40)
zonesBtn.Font, zonesBtn.TextScaled = Enum.Font.FredokaOne, true
zonesBtn.TextColor3, zonesBtn.Text = Color3.new(1, 1, 1), "ZONES"
zonesBtn.Parent = gui
Instance.new("UICorner", zonesBtn).CornerRadius = UDim.new(0, 12)
local msg = label(gui, "", UDim2.new(0.5, 0, 0.05, 0), UDim2.new(0.25, 0, 0.8, 0))
msg.TextTransparency, msg.TextStrokeTransparency = 1, 1

local menu = Instance.new("Frame")
menu.Size, menu.Position = UDim2.new(0, 300, 0, 60), UDim2.new(1, -316, 1, -140)
menu.BackgroundColor3 = Color3.fromRGB(28, 40, 74)
menu.Visible = false
menu.Parent = gui
Instance.new("UICorner", menu).CornerRadius = UDim.new(0, 14)
local list = Instance.new("UIListLayout")
list.Padding = UDim.new(0, 6)
list.Parent = menu
local order = {}
for name, z in HubData.Zones do table.insert(order, { name = name, z = z }) end
table.sort(order, function(a, b) return a.z.order < b.z.order end)
table.insert(order, { name = "Brawler", z = { title = "Mission: Invader Ship" } })
menu.Size = UDim2.new(0, 300, 0, #order * 50 + 10)
menu.Position = UDim2.new(1, -316, 1, -76 - #order * 50 - 10)
for _, e in order do
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, -12, 0, 44)
	b.BackgroundColor3 = Color3.fromRGB(58, 96, 170)
	b.Font, b.TextScaled, b.TextColor3 = Enum.Font.FredokaOne, true, Color3.new(1, 1, 1)
	b.Text = e.z.title
	b.Parent = menu
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 10)
	b.Activated:Connect(function()
		menu.Visible = false
		HubRemote:FireServer("travel", { zone = e.name })
	end)
end
zonesBtn.Activated:Connect(function() menu.Visible = not menu.Visible end)

local function flash(text: string)
	msg.Text = text
	msg.TextTransparency, msg.TextStrokeTransparency = 0, 0.3
	task.delay(2.5, function()
		if msg.Text == text then
			TweenService:Create(msg, TweenInfo.new(0.5), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		end
	end)
end

HubRemote.OnClientEvent:Connect(function(kind, data)
	if kind == "collect" then
		Sound.ui(data.kind == "Token" and "coins" or "star")
		local tpl = SPSO:FindFirstChild("HubPickups") and SPSO.HubPickups:FindFirstChild(data.kind == "Token" and "HeroToken" or data.kind)
		if tpl and data.kind == "Star" then -- a star pops out of the prop and fades
			local star = tpl:Clone()
			star.Anchored, star.CanCollide, star.CanQuery, star.CanTouch = true, false, false, false
			star.TextureID, star.Material, star.Color = "", Enum.Material.Neon, Color3.fromRGB(150, 230, 255)
			star.CFrame = CFrame.new(data.pos)
			star.Parent = workspace
			TweenService:Create(star, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ CFrame = CFrame.new(data.pos + Vector3.new(0, 5, 0)) * CFrame.Angles(0, math.pi * 3, 0), Transparency = 1 }):Play()
			task.delay(1, function() star:Destroy() end)
			return
		end
		local pop = Instance.new("Part")
		pop.Anchored, pop.CanCollide, pop.CanQuery = true, false, false
		pop.Material, pop.Shape = Enum.Material.Neon, Enum.PartType.Ball
		pop.Size, pop.Position = Vector3.one * 1.5, data.pos
		pop.Color = data.kind == "Fractal" and Color3.fromRGB(176, 104, 255) or Color3.fromRGB(255, 205, 60)
		pop.Parent = workspace
		TweenService:Create(pop, TweenInfo.new(0.45), { Size = Vector3.one * 5, Transparency = 1, Position = data.pos + Vector3.new(0, 3, 0) }):Play()
		task.delay(0.5, function() pop:Destroy() end)
	elseif kind == "zones" then
		menu.Visible = true
	elseif kind == "message" then
		flash(data.text)
	elseif kind == "zone" then
		local z = HubData.Zones[data.zone]
		if z then flash(z.title) end
	end
end)

-- light and music per zone ---------------------------------------------------------------------------------------------------
local applied
local function applyZone(z, name)
	if applied == name then return end
	applied = name
	if not z then return end
	local a = z.ambient or { 0.6, 0.55, 0.75 }
	Lighting.Ambient = Color3.new(a[1], a[2], a[3]):Lerp(Color3.new(1, 1, 1), 0.35)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 165)
	Lighting.Brightness = 2.4
	Lighting.ClockTime = 14
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.5
	title.Text = z.title
	Sound.music(Config.Music.select)
end

-- social camera -----------------------------------------------------------------------------------------------------------------
local zoom, focus = 1, nil
UserInputService.InputChanged:Connect(function(input, gp)
	if not gp and input.UserInputType == Enum.UserInputType.MouseWheel and zone() then
		zoom = math.clamp(zoom - input.Position.Z * 0.1, Config.Hub.cameraZoom[1], Config.Hub.cameraZoom[2])
	end
end)

RunService:BindToRenderStep("SPSO_HubCamera", Enum.RenderPriority.Camera.Value + 2, function(dt)
	local zn = zone()
	gui.Enabled = zn ~= nil and player.Character ~= nil
	if not zn then
		applied = nil
		return
	end
	local z = HubData.Zones[zn]
	applyZone(z, zn)
	for k, l in counts do l.Text = tostring(player:GetAttribute("SPSO_" .. k) or 0) end
	local t = os.clock()
	for i, c in CollectionService:GetTagged("SPSO_Collectible") do
		local base = c:GetAttribute("Base") or c.Position
		if c:IsA("MeshPart") then -- the pickup models stand upright: spin and bob
			c.CFrame = CFrame.new(base + Vector3.new(0, math.sin(t * 2 + i) * 0.3, 0)) * CFrame.Angles(0, t * 2.2, 0)
		else
			c.CFrame = CFrame.new(base) * CFrame.Angles(0, t * 2.2, c.Name == "Fractal" and 0.6 or math.pi / 2)
		end
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local cam = z.camera or {}
	local fwd = cam.boomForward or { dir = { 0, 0.5, -0.86 }, distance = 36 }
	local zm = cam.boomZoom or fwd
	local dir = Vector3.new(fwd.dir[1], fwd.dir[2], fwd.dir[3]):Lerp(Vector3.new(zm.dir[1], zm.dir[2], zm.dir[3]), math.clamp(1 - zoom, 0, 1)).Unit
	local dist = fwd.distance * zoom
	local target = hrp.Position + Vector3.new(0, 2.5, 0)
	focus = focus and focus:Lerp(target, 1 - math.exp(-8 * dt)) or target
	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = cam.fov or 45
	camera.CFrame = CFrame.lookAt(focus + dir * dist, focus)
end)
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000028"><Properties><string name="Name">StarterPlayer/StarterCharacterScripts</string></Properties><Item class="LocalScript" referent="RBX000018"><Properties><string name="Name">Animate</string><ProtectedString name="Source"><![CDATA[-- Replaces Roblox's default Animate script: SPSO characters are animated by the exact animation
-- runtime (ReplicatedStorage.SPSO.Runtime.ExactAnimator) from StarterPlayerScripts.BrawlerClient.
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX000019"><Properties><string name="Name">Health</string><ProtectedString name="Source"><![CDATA[-- Replaces Roblox's default Health regeneration: health is managed by the brawler server.
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000029"><Properties><string name="Name">ServerStorage/SPSO/Setup</string></Properties><Item class="ModuleScript" referent="RBX000020"><Properties><string name="Name">01_world</string><ProtectedString name="Source"><![CDATA[-- SPSO world setup (Studio, Edit mode; idempotent):
--   require(game.ServerStorage.SPSO.Setup["01_world"])()
-- * archives the template baseplate / spawn and old test objects (ServerStorage.SPSO_Archive, nothing deleted)
-- * inserts every hero's uploaded model and data package (Assets.lua) and builds the character templates
--     ServerStorage.SPSO.Characters.Hero_<Hero> plus select-screen previews in ReplicatedStorage.SPSO.Previews
--     (players spawn as the hero they pick: Players.CharacterAutoLoads is off)
-- * configures the arena (workspace.OrbitalArena from the uploaded model: collision, glass, spawns), or builds
--   a simple placeholder arena with the same layout when the map has not been inserted yet
-- * lighting and player settings
return function(): string
	local ServerStorage = game:GetService("ServerStorage")
	local StarterPlayer = game:GetService("StarterPlayer")
	local Lighting = game:GetService("Lighting")
	local log = {}

	local function folder(parent: Instance, name: string): Instance
		local f = parent:FindFirstChild(name)
		if not f then
			f = Instance.new("Folder")
			f.Name = name
			f.Parent = parent
		end
		return f
	end
	local spso = folder(ServerStorage, "SPSO")
	local archive = folder(ServerStorage, "SPSO_Archive")

	for _, n in { "Baseplate", "SpawnLocation", "ElRugido_ExactSkinTest" } do
		local o = workspace:FindFirstChild(n)
		if o then
			o.Parent = archive
			table.insert(log, "archived " .. n)
		end
	end

	-- hero source models (uploaded FBX assets, Assets.Heroes[H].model) and their data packages
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local InsertService = game:GetService("InsertService")
	local Players = game:GetService("Players")
	local Game = ReplicatedStorage:WaitForChild("SPSO"):WaitForChild("Game")
	local Assets = require(Game:WaitForChild("Assets"):Clone())
	local GameData = require(Game:WaitForChild("GameData"):Clone())
	local allModels = table.clone(GameData.Models)
	local hubOk, HubData = pcall(function() return require(Game:WaitForChild("HubData", 5):Clone()) end)
	for _, name in (hubOk and HubData.Characters) or {} do table.insert(allModels, name) end
	local unpack = require(spso.Tools.Unpack:Clone())
	local source = folder(spso, "Source")
	local legacy = workspace:FindFirstChild("ElRugido_Import")
	if legacy then legacy.Parent = source end
	local heroesFolder = folder(ReplicatedStorage.SPSO, "Heroes")
	for _, hero in allModels do
		local a = Assets.Heroes[hero] or {}
		if not source:FindFirstChild(hero .. "_Import") and a.model then
			local m = InsertService:LoadAsset(a.model)
			m.Name = hero .. "_Import"
			m.Parent = source
			table.insert(log, "inserted " .. hero)
		end
		local hf = heroesFolder:FindFirstChild(hero)
		local pack = hf and hf:FindFirstChild("Pack")
		if a.package and (not pack or pack:GetAttribute("PackageId") ~= a.package) then
			unpack(a.package)
			heroesFolder:WaitForChild(hero):WaitForChild("Pack"):SetAttribute("PackageId", a.package)
			table.insert(log, "hero data " .. hero)
		end
	end

	-- playable characters: Humanoid + HumanoidRootPart driving the skinned rig (animated by script)
	local HIP, HRP_SIZE = 2.0, Vector3.new(3, 2.6, 2)
	local function buildCharacter(rigSrc: Model, name: string): Model
		local char = Instance.new("Model")
		char.Name = name
		local rig = rigSrc:Clone()
		for _, c in rig:GetChildren() do
			if c:IsA("AnimationController") or c.Name == "InitialPoses" then
				c:Destroy()
			else
				c.Parent = char
			end
		end
		rig:Destroy()
		local root = char:FindFirstChild("RootPart") :: BasePart
		root.CFrame = CFrame.new(0, 0, 0)
		local hrp = Instance.new("Part")
		hrp.Name = "HumanoidRootPart"
		hrp.Size = HRP_SIZE
		hrp.Transparency = 1
		hrp.CanCollide, hrp.Anchored = true, false
		hrp.TopSurface, hrp.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		hrp.CFrame = CFrame.new(0, HIP + HRP_SIZE.Y / 2, 0)
		hrp.Parent = char
		for _, p in char:GetDescendants() do
			if p:IsA("BasePart") and p ~= hrp then
				p.Anchored, p.CanCollide, p.CanTouch, p.Massless = false, false, false, true
				p.CanQuery = false
				if p == root then p.Transparency = 1 end
			end
		end
		local m6 = Instance.new("Motor6D")
		m6.Name = "RigRoot"
		m6.Part0, m6.Part1 = hrp, root
		m6.C0 = CFrame.new(0, -(HIP + HRP_SIZE.Y / 2), 0)
		m6.Parent = hrp
		local hum = Instance.new("Humanoid")
		hum.RigType = Enum.HumanoidRigType.R15
		hum.HipHeight = HIP
		hum.BreakJointsOnDeath = false
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		hum.Parent = char
		char.PrimaryPart = hrp
		return char
	end
	local chars = folder(spso, "Characters")
	local previews = folder(ReplicatedStorage.SPSO, "Previews")
	for _, n in { "Enemy_Luchador" } do
		local old = chars:FindFirstChild(n)
		if old then old:Destroy() end
	end
	-- a single skinned mesh imports with its bones inside the MeshPart (several meshes get a RootPart holding the
	-- bones): give it the same layout, a RootPart at the rig origin with the bones and a Motor6D to the mesh
	local function ensureRootPart(rigSrc: Model)
		if rigSrc:FindFirstChild("RootPart") then return end
		local mesh = rigSrc:FindFirstChildWhichIsA("MeshPart")
		if not mesh then return end
		local tops = {}
		for _, b in mesh:GetChildren() do
			if b:IsA("Bone") then table.insert(tops, b) end
		end
		if #tops == 0 then return end
		local root = Instance.new("Part")
		root.Name = "RootPart"
		root.Size, root.Transparency = Vector3.new(2, 2, 1), 1
		root.Anchored, root.CanCollide = true, false
		root.CFrame = CFrame.identity -- the importer puts the armature origin at the model origin
		root.Parent = rigSrc
		for _, b in tops do
			local w = b.WorldCFrame
			b.Parent = root
			b.WorldCFrame = w
		end
		local m6 = Instance.new("Motor6D")
		m6.Name = mesh.Name .. "Motor6D"
		m6.Part0, m6.Part1 = root, mesh
		m6.C0 = root.CFrame:ToObjectSpace(mesh.CFrame)
		m6.Parent = mesh
		table.insert(log, "root part added for " .. rigSrc.Name)
	end
	for _, hero in allModels do
		local import = source:FindFirstChild(hero .. "_Import")
		local rigSrc = import and import:FindFirstChild(hero)
		if rigSrc then ensureRootPart(rigSrc) end
		if rigSrc and rigSrc:FindFirstChild("RootPart") then
			local old = chars:FindFirstChild("Hero_" .. hero)
			if old then old:Destroy() end
			buildCharacter(rigSrc, "Hero_" .. hero).Parent = chars
			-- select-screen preview: the bare rig, posed on the client by its own ExactAnimator
			local pv = previews:FindFirstChild(hero)
			if pv then pv:Destroy() end
			pv = rigSrc:Clone()
			for _, c in pv:GetChildren() do
				if c:IsA("AnimationController") or c.Name == "InitialPoses" then c:Destroy() end
			end
			for _, p in pv:GetDescendants() do
				if p:IsA("BasePart") then p.Anchored = true end
			end
			pv.Name = hero
			pv.Parent = previews
		else
			table.insert(log, "MISSING model for " .. hero)
		end
	end
	local sc = StarterPlayer:FindFirstChild("StarterCharacter")
	if sc then sc.Parent = archive end
	Players.CharacterAutoLoads = false
	table.insert(log, "characters built")

	-- arena
	local arena = workspace:FindFirstChild("OrbitalArena")
	if arena and arena:GetAttribute("Placeholder") and workspace:FindFirstChild("OrbitalArena_Real") then
		arena:Destroy()
		arena = workspace.OrbitalArena_Real
		arena.Name = "OrbitalArena"
	end
	if not arena then
		-- placeholder with the real arena's footprint (floor radius ~49 studs, back wall at -Z)
		arena = Instance.new("Model")
		arena.Name = "OrbitalArena"
		arena:SetAttribute("Placeholder", true)
		local floor = Instance.new("Part")
		floor.Name = "Floor"
		floor.Shape = Enum.PartType.Cylinder
		floor.Size = Vector3.new(2, 100, 100)
		floor.CFrame = CFrame.new(0, -1, 0) * CFrame.Angles(0, 0, math.rad(90))
		floor.Color = Color3.fromRGB(150, 214, 222)
		floor.Material = Enum.Material.SmoothPlastic
		floor.Anchored = true
		floor.Parent = arena
		for i = 0, 31 do
			local a = i / 32 * math.pi * 2
			local w = Instance.new("Part")
			w.Name = "Wall"
			w.Size = Vector3.new(10.4, 26, 2)
			w.CFrame = CFrame.new(math.sin(a) * 51, 12, math.cos(a) * 51) * CFrame.Angles(0, a, 0)
			w.Color = Color3.fromRGB(38, 120, 150)
			w.Material = Enum.Material.SmoothPlastic
			w.Anchored = true
			w.Transparency = (math.cos(a) > 0.5) and 0.85 or 0
			w.Parent = arena
		end
		arena.Parent = workspace
		table.insert(log, "placeholder arena built")
	else
		-- the FBX import puts the back wall (medallion) at +Z; the game expects it at -Z
		local med = arena:FindFirstChild("OrbitalArena_Medallion", true)
		if med and med.Position.Z > 0 then
			for _, p in arena:GetChildren() do
				if p:IsA("MeshPart") then p.CFrame = CFrame.Angles(0, math.pi, 0) * p.CFrame end
			end
		end
		local door = arena:FindFirstChild("OrbitalArena_IrisDoor_Left", true)
		if door then pcall(function() door.DoubleSided = true end) end -- mirrored in the source scene
		for _, p in arena:GetDescendants() do
			if p:IsA("BasePart") and p.Parent and p.Parent.Name ~= "Collision" then
				p.Anchored = true
				p.CanCollide, p.CanQuery, p.CanTouch = false, false, false
				p.CastShadow = false
				if string.find(p.Name, "_Collision") then p.Transparency = 1 end
				if string.find(p.Name, "Glass") then p.Transparency = 0.55 end
			end
		end
		-- collision from primitives: the original collision mesh is a flat floor inside a 12-sided wall
		-- (a convex decomposition of it fills the bowl, so it is only kept as reference)
		local col = arena:FindFirstChild("Collision")
		if col then col:Destroy() end
		col = Instance.new("Folder")
		col.Name = "Collision"
		local function box(name, cf, size)
			local b = Instance.new("Part")
			b.Name, b.CFrame, b.Size = name, cf, size
			b.Transparency, b.Anchored, b.CanCollide, b.CanQuery, b.CanTouch = 1, true, true, true, false
			b.TopSurface, b.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
			b.Parent = col
		end
		local floorY, wallH = 0, 85
		local floorPart = Instance.new("Part")
		floorPart.Name, floorPart.Shape = "Floor", Enum.PartType.Cylinder
		floorPart.Size = Vector3.new(4, 104, 104)
		floorPart.CFrame = CFrame.new(0, floorY - 2, 0) * CFrame.Angles(0, 0, math.rad(90))
		floorPart.Transparency, floorPart.Anchored, floorPart.CanCollide, floorPart.CanQuery = 1, true, true, true
		floorPart.Parent = col
		local poly = { {49.5, -13.2}, {49.5, 13.3}, {36.3, 36.3}, {13.3, 49.5}, {-13.3, 49.5}, {-36.3, 36.3},
			{-49.5, 13.3}, {-49.5, -13.2}, {-36.3, -36.2}, {-13.3, -49.5}, {13.3, -49.5}, {36.3, -36.2} }
		for i, a in poly do
			local b = poly[i % #poly + 1]
			local pa, pb = Vector3.new(a[1], 0, a[2]), Vector3.new(b[1], 0, b[2])
			local mid, len = (pa + pb) / 2, (pb - pa).Magnitude
			local out = mid.Unit
			local cf = CFrame.lookAt(mid + out * 2 + Vector3.new(0, floorY + wallH / 2, 0), mid + out * 3 + Vector3.new(0, floorY + wallH / 2, 0))
			box("Wall" .. i, cf, Vector3.new(len + 4, wallH, 4))
		end
		col.Parent = arena
		local sf = arena:FindFirstChild("SafetyFloor")
		if sf then sf:Destroy() end
		table.insert(log, "arena configured")
	end
	local spawns = arena:FindFirstChild("Spawns")
	if spawns then spawns:Destroy() end
	spawns = Instance.new("Folder")
	spawns.Name = "Spawns"
	local function marker(name: string, pos: Vector3, face: Vector3)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = Vector3.new(2, 0.2, 2)
		p.CFrame = CFrame.lookAt(pos, pos + face)
		p.Transparency = 1
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
		p.Parent = spawns
	end
	for i, x in { -8, 8, -16, 16 } do marker("Player" .. i, Vector3.new(x, 0.2, 30 - math.abs(x) / 4), Vector3.new(0, 0, -1)) end
	local enemyPts = { Vector3.new(-30, 0.2, -26), Vector3.new(30, 0.2, -26), Vector3.new(0, 0.2, -38), Vector3.new(-42, 0.2, 2),
		Vector3.new(42, 0.2, 2), Vector3.new(-18, 0.2, -40), Vector3.new(18, 0.2, -40), Vector3.new(0, 0.2, -18) }
	for i, p in enemyPts do marker(string.format("Enemy%02d", i), p, Vector3.new(0, 0, 1)) end
	spawns.Parent = arena

	-- settings
	workspace.StreamingEnabled = false
	StarterPlayer.LoadCharacterAppearance = false
	StarterPlayer.CharacterUseJumpPower = true
	workspace.Gravity = GameData.Heroes[GameData.HeroOrder[1]].gravity -- the original 20 units/s^2
	Lighting.Brightness = 2
	Lighting.Ambient = Color3.fromRGB(96, 106, 120)
	Lighting.OutdoorAmbient = Color3.fromRGB(128, 138, 150)
	Lighting.ClockTime = 14.5
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.4
	Lighting.EnvironmentSpecularScale = 0.2
	table.insert(log, "settings applied")
	return table.concat(log, "; ")
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000021"><Properties><string name="Name">02_hub</string><ProtectedString name="Source"><![CDATA[-- Setup step: builds the social zones (HubData, tools/convert_hub.py) into workspace.SPSO_Hub, in edit mode:
--   * inserts each zone's geometry files and merged props (Assets.Hub) into ServerStorage.SPSO.HubSource
--   * places every part at the zone's world offset (parts arrive at their bounding-box centres: the zone origin
--     is recovered from any part listed in HubData), Neon glow parts, the zone's box colliders, the replacement signs
--   * collision: the original MeshColliders arrive as invisible mesh chunks; their triangles are read back
--     (EditableMesh) and rebuilt as exact primitives (a convex decomposition would fill streets, domes and bowls):
--     rectangles -> one box, right triangles -> one wedge, other triangles -> two wedges, all behind the surface
--   * props: one template per model, placed at every instance (uniform scale), their own boxes and triangles
-- Idempotent: a zone is rebuilt only when its HubData signature changes. Pass a zone name to build only that zone
-- (each zone takes a while: one per call keeps the Studio MCP call short).
return function(only: string?)
	local InsertService = game:GetService("InsertService")
	local AssetService = game:GetService("AssetService")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local ServerStorage = game:GetService("ServerStorage")
	local Game = ReplicatedStorage:WaitForChild("SPSO"):WaitForChild("Game")
	local Assets = require(Game:WaitForChild("Assets"):Clone())
	local HubData = require(Game:WaitForChild("HubData"):Clone())
	local log = {}
	local VERSION = "c2" -- bump to rebuild every zone

	local function folder(parent: Instance, name: string): Instance
		local f = parent:FindFirstChild(name)
		if not f then
			f = Instance.new("Folder")
			f.Name = name
			f.Parent = parent
		end
		return f
	end
	local spso = folder(ServerStorage, "SPSO")
	local src = folder(spso, "HubSource")
	local hubRoot = folder(workspace, "SPSO_Hub")

	local function cfOf(t)
		return CFrame.new(t[1], t[2], t[3], t[4], t[5], t[6], t[7], t[8], t[9], t[10], t[11], t[12])
	end
	local function insert(key: string)
		local m = src:FindFirstChild(key)
		if m then return m end
		local id = Assets.Hub[key]
		if not id then
			table.insert(log, "no asset id for " .. key)
			return nil
		end
		local ok, res = pcall(InsertService.LoadAsset, InsertService, id)
		if not ok then
			table.insert(log, "insert failed " .. key .. ": " .. tostring(res))
			return nil
		end
		res.Name = key
		res.Parent = src
		table.insert(log, "inserted " .. key)
		return res
	end
	local function look(p: BasePart, info)
		p.Anchored, p.CanCollide, p.CanTouch = true, false, false
		p.CanQuery = true
		p.CastShadow = info == nil or info.kind ~= "glow"
		p.Material = Enum.Material.SmoothPlastic
		if info and info.kind == "glow" then
			p.Material = Enum.Material.Neon
			p.Color = Color3.new(info.color[1], info.color[2], info.color[3])
			if p:IsA("MeshPart") then p.TextureID = "" end
		elseif info and info.kind == "color" then
			p.Color = Color3.new(info.color[1], info.color[2], info.color[3])
		else
			p.Color = Color3.new(1, 1, 1)
		end
		if info and info.alpha then p.Transparency = 0.02 end
	end

	-- collision primitives -------------------------------------------------------------------------------------------
	local THICK = 1.2
	local made = 0
	local sink -- current batch folder (flushed into the zone every 800 parts)
	local sinkInto
	local function flush()
		if sink and #sink:GetChildren() > 0 then
			sink.Parent = sinkInto
			task.wait()
		end
		sink = Instance.new("Folder")
		sink.Name = "C" .. made
	end
	local function prim(class: string, parent: Instance?, cf: CFrame, size: Vector3)
		local w = Instance.new(class)
		w.Name = class == "Part" and "Box" or "Wedge"
		w.Anchored, w.CanCollide, w.CanQuery, w.CanTouch = true, true, true, false
		w.Transparency, w.CastShadow = 1, false
		w.Size, w.CFrame = size, cf
		w.Parent = parent or sink
		made += 1
		if not parent and #sink:GetChildren() >= 800 then flush() end
	end
	local function twoWedges(parent, a: Vector3, b: Vector3, c: Vector3, back: Vector3)
		local ab, ac, bc = b - a, c - a, c - b
		local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
		if abd > acd and abd > bcd then c, a = a, c elseif acd > bcd and acd > abd then a, b = b, a end
		ab, ac, bc = b - a, c - a, c - b
		local right = ac:Cross(ab)
		if right.Magnitude < 1e-6 or bc.Magnitude < 1e-6 then return end
		right = right.Unit
		local up, fwd = bc:Cross(right).Unit, bc.Unit
		local h = math.abs(ab:Dot(up))
		if h < 0.01 then return end
		local d1, d2 = math.abs(ab:Dot(fwd)), math.abs(ac:Dot(fwd))
		if d1 > 0.01 then prim("WedgePart", parent, CFrame.fromMatrix((a + b) / 2 + back, right, up, fwd), Vector3.new(THICK, h, d1)) end
		if d2 > 0.01 then prim("WedgePart", parent, CFrame.fromMatrix((a + c) / 2 + back, -right, up, -fwd), Vector3.new(THICK, h, d2)) end
	end
	local function key(v: Vector3) return string.format("%.2f,%.2f,%.2f", v.X, v.Y, v.Z) end
	-- tris: { {a, b, c}, ... } in world space; windings are made consistent (most floor faces point up)
	local function primitives(parent: Instance?, tris)
		local up, down = 0, 0
		for _, t in tris do
			local n = (t[2] - t[1]):Cross(t[3] - t[1])
			if n.Magnitude > 1e-6 then
				local y = n.Unit.Y
				if y > 0.7 then up += 1 elseif y < -0.7 then down += 1 end
			end
		end
		local flip = down > up
		local info, byHyp = {}, {}
		for _, t in tris do
			local a, b, c = t[1], t[2], t[3]
			if flip then b, c = c, b end
			local n = (b - a):Cross(c - a)
			if n.Magnitude < 2e-3 then continue end
			local e = { a = a, b = b, c = c, n = n.Unit }
			for k = 1, 3 do -- a right angle: the vertex r and the hypotenuse p-q
				local r, p, q = e[({ "a", "b", "c" })[k]], e[({ "b", "c", "a" })[k]], e[({ "c", "a", "b" })[k]]
				local u, v = p - r, q - r
				if u.Magnitude > 0.01 and v.Magnitude > 0.01 and math.abs(u.Unit:Dot(v.Unit)) < 0.01 then
					e.r, e.p, e.q = r, p, q
					break
				end
			end
			table.insert(info, e)
			if e.r then
				local h = key(e.p) < key(e.q) and key(e.p) .. "|" .. key(e.q) or key(e.q) .. "|" .. key(e.p)
				local o = byHyp[h]
				if o and not o.used and o.n:Dot(e.n) > 0.999 and ((o.r + e.r) - (e.p + e.q)).Magnitude < 0.02 then
					o.used, e.used = true, true -- a rectangle: one box
					local x, y = e.p - e.r, e.q - e.r
					prim("Part", parent, CFrame.fromMatrix((e.p + e.q) / 2 - e.n * (THICK / 2), x.Unit, y.Unit), Vector3.new(x.Magnitude, y.Magnitude, THICK))
				else
					byHyp[h] = e
				end
			end
		end
		for _, e in info do
			if e.used then continue end
			local back = -e.n * (THICK / 2)
			if e.r then -- a right triangle: one wedge, right angle at the bottom-back edge
				local Z, Y = (e.r - e.q).Unit, (e.p - e.r).Unit
				prim("WedgePart", parent, CFrame.fromMatrix((e.p + e.q) / 2 + back, Y:Cross(Z), Y, Z),
					Vector3.new(THICK, (e.p - e.r).Magnitude, (e.r - e.q).Magnitude))
			else
				twoWedges(parent, e.a, e.b, e.c, back)
			end
		end
	end
	-- the triangles of an uploaded mesh part, in world space
	local function meshTriangles(p: MeshPart, out)
		local ok, em = pcall(function() return AssetService:CreateEditableMeshAsync(Content.fromUri(p.MeshId)) end)
		if not ok or not em then
			table.insert(log, "collision mesh unreadable " .. p.Name .. ": " .. tostring(em))
			return false
		end
		local pos, lo, hi = {}, Vector3.one * math.huge, -Vector3.one * math.huge
		for _, v in em:GetVertices() do
			local q = em:GetPosition(v)
			pos[v] = q
			lo, hi = lo:Min(q), hi:Max(q)
		end
		local ctr, s, cf = (lo + hi) / 2, p.Size / p.MeshSize, p.CFrame
		for _, f in em:GetFaces() do
			local vs = em:GetFaceVertices(f)
			table.insert(out, { cf * ((pos[vs[1]] - ctr) * s), cf * ((pos[vs[2]] - ctr) * s), cf * ((pos[vs[3]] - ctr) * s) })
		end
		em:Destroy()
		return true
	end
	local function box(parent, b, name)
		local p = Instance.new("Part")
		p.Name = name or "Box"
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, true, true, false
		p.Transparency, p.CastShadow = 1, false
		p.Size = Vector3.new(math.max(b.size[1], 0.05), math.max(b.size[2], 0.05), math.max(b.size[3], 0.05))
		p.CFrame = cfOf(b.cf)
		p.Parent = parent
		return p
	end

	insert("Hub_Pickups") -- fractal, token and star models (Hub.server clones them)

	-- prop templates: the merged props file keeps every model's parts as "<Model>__<n>"
	local templates = {}
	local function propTemplates(key_: string)
		if templates[key_] then return templates[key_] end
		local m = insert(key_)
		local out = {}
		if m then
			local origin
			for _, p in m:GetDescendants() do
				if p:IsA("BasePart") then
					local model = string.match(p.Name, "^(.-)__%d+$")
					local info = model and HubData.Props[model] and HubData.Props[model].parts[p.Name]
					if info then
						origin = origin or (p.Position - Vector3.new(info.center[1], info.center[2], info.center[3]))
						out[model] = out[model] or {}
						table.insert(out[model], p)
					end
				end
			end
			out._origin = origin
		end
		templates[key_] = out
		return out
	end

	for zoneName, z in HubData.Zones do
		if only and zoneName ~= only then continue end
		local sig = VERSION .. ":" .. #z.geometry.files .. ":" .. #z.props .. ":" .. #z.geometry.collision .. ":" .. tostring(z.offset[1])
		local zf = hubRoot:FindFirstChild(zoneName)
		if zf and zf:GetAttribute("Signature") == sig then
			table.insert(log, zoneName .. " up to date")
			continue
		end
		if zf then
			zf:Destroy()
			task.wait()
		end
		local t0 = os.clock()
		zf = Instance.new("Model")
		zf.Name = zoneName
		zf:SetAttribute("Offset", Vector3.new(z.offset[1], z.offset[2], z.offset[3]))
		zf.Parent = hubRoot -- filled in small batches (one big insert freezes Studio)
		local geo, col, propsF = folder(zf, "Geometry"), folder(zf, "Collision"), folder(zf, "Props")
		local off = Vector3.new(z.offset[1], z.offset[2], z.offset[3])
		local placed, missing = 0, 0
		local chunks = {}
		for _, file in z.geometry.files do
			local m = insert((string.gsub(file, "%.fbx$", "")))
			if not m then
				missing += 1
				continue
			end
			local copy = m:Clone()
			local origin
			for _, p in copy:GetDescendants() do
				if p:IsA("BasePart") then
					local info = z.geometry.parts[p.Name]
					if info then
						origin = p.Position - Vector3.new(info.center[1], info.center[2], info.center[3])
						break
					end
				end
			end
			if not origin then
				origin = Vector3.zero
				table.insert(log, file .. ": no reference part, origin assumed")
			end
			local batch = Instance.new("Folder")
			for _, p in copy:GetDescendants() do
				if p:IsA("BasePart") then
					p.CFrame = CFrame.new(off - origin) * p.CFrame
					if table.find(z.geometry.collision, p.Name) then
						table.insert(chunks, p)
					else
						look(p, z.geometry.parts[p.Name])
						p.Parent = batch
					end
					placed += 1
				end
			end
			for _, p in batch:GetChildren() do
				p.Parent = geo
			end
			batch:Destroy()
			copy:Destroy()
			task.wait()
		end
		for _, b in z.geometry.boxes do box(col, b, "Box") end
		-- collision chunks -> exact primitives
		local tris = {}
		for _, p in chunks do
			meshTriangles(p, tris)
			p:Destroy()
		end
		sinkInto = col
		flush()
		primitives(nil, tris)
		flush()
		table.insert(log, string.format("%s collision: %d triangles -> %d primitives", zoneName, #tris, made))
		-- replacement signs (the original lettering is a licensed name)
		for i, s in z.signs do
			local p = Instance.new("Part")
			p.Name = "Sign_" .. i
			p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
			p.Size = Vector3.new(s.size[1], s.size[2], 0.2)
			p.CFrame = cfOf(s.cf) * CFrame.new(0, 0, -0.35)
			p.Color, p.Material = Color3.fromRGB(46, 44, 40), Enum.Material.SmoothPlastic
			local g = Instance.new("SurfaceGui")
			g.Face = Enum.NormalId.Front
			g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
			g.PixelsPerStud = 40
			g.LightInfluence = 0.3
			g.Parent = p
			local t = Instance.new("TextLabel")
			t.Size = UDim2.fromScale(1, 1)
			t.BackgroundTransparency = 1
			t.Text = s.text
			t.TextScaled = true
			t.Font = Enum.Font.Merriweather
			t.TextColor3 = Color3.fromRGB(236, 196, 74)
			t.TextStrokeColor3 = Color3.fromRGB(90, 62, 10)
			t.TextStrokeTransparency = 0.2
			t.Parent = g
			p.Parent = geo
		end
		-- props
		local tpl = propTemplates(zoneName .. "_Props")
		local o = tpl._origin and CFrame.new(tpl._origin) or CFrame.new()
		for i, inst in z.props do
			local parts = tpl[inst.model]
			local data = HubData.Props[inst.model]
			if not parts or not data then
				missing += 1
				continue
			end
			local cf = cfOf(inst.cf)
			if cf.Position.Y < off.Y - 200 then continue end -- unused originals parked far under the map
			local m = Instance.new("Model")
			m.Name = inst.name .. "_" .. i
			m:SetAttribute("Prop", inst.model)
			m:SetAttribute("Kind", inst.kind)
			for _, tp in parts do
				local p = tp:Clone()
				local rel = o:ToObjectSpace(tp.CFrame)
				p.Size *= inst.scale
				p.CFrame = cf * (rel - rel.Position + rel.Position * inst.scale)
				look(p, data.parts[p.Name])
				p.Parent = m
			end
			for _, b in data.boxes do
				local bp = box(m, { cf = { 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1 }, size = { b.size[1] * inst.scale, b.size[2] * inst.scale, b.size[3] * inst.scale } }, "Collider")
				local lb = cfOf(b.cf)
				bp.CFrame = cf * (lb - lb.Position + lb.Position * inst.scale)
			end
			if #data.collision > 0 and #data.collision <= 2000 then
				local mirror = string.sub(inst.model, -2) == "_M"
				local pt = {}
				for _, t in data.collision do
					local a, b, c = Vector3.new(t[1], t[2], t[3]), Vector3.new(t[4], t[5], t[6]), Vector3.new(t[7], t[8], t[9])
					if mirror then a, b, c = Vector3.new(-a.X, a.Y, a.Z), Vector3.new(-c.X, c.Y, c.Z), Vector3.new(-b.X, b.Y, b.Z) end
					table.insert(pt, { cf * (a * inst.scale), cf * (b * inst.scale), cf * (c * inst.scale) })
				end
				primitives(m, pt)
			end
			if m.PrimaryPart == nil then
				m.PrimaryPart = m:FindFirstChildWhichIsA("BasePart")
			end
			m.Parent = propsF
			if i % 20 == 0 then task.wait() end
		end
		zf:SetAttribute("Signature", sig)
		table.insert(log, string.format("%s: %d parts, %d props, %d missing, %.1fs", zoneName, placed, #z.props, missing, os.clock() - t0))
		made = 0
	end
	return table.concat(log, "\n")
end
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000030"><Properties><string name="Name">ServerStorage/SPSO/Tools</string></Properties><Item class="ModuleScript" referent="RBX000022"><Properties><string name="Name">Unpack</string><ProtectedString name="Source"><![CDATA[-- SPSO package unpacker (Studio, Edit mode). Inserts the SPSO_Package model asset (built by
-- tools/build_rbxmx_package.py, uploaded from Blender) and moves every item to its destination,
-- replacing same-named items there. Returns a short report.
--   require(game.ServerStorage.SPSO.Tools.Unpack)(assetId)
return function(source: any): string
	local model = source
	if type(source) == "number" then
		model = game:GetService("InsertService"):LoadAsset(source)
	end
	local pkg = model:FindFirstChild("SPSO_Package", true)
	assert(pkg, "no SPSO_Package in the asset")
	local version = pkg:FindFirstChild("_version")
	local moved = 0
	for _, dest in pkg:GetChildren() do
		if dest:IsA("Folder") then
			local parts = string.split(dest.Name, "/")
			local target: Instance = game:GetService(parts[1])
			for i = 2, #parts do
				local c = target:FindFirstChild(parts[i])
				if not c then
					c = Instance.new("Folder")
					c.Name = parts[i]
					c.Parent = target
				end
				target = c
			end
			for _, it in dest:GetChildren() do
				local meta = it:FindFirstChild("_meta")
				if meta and meta:IsA("StringValue") then
					local m = game:GetService("HttpService"):JSONDecode(meta.Value)
					it:SetAttribute("Chunks", m.chunks)
					it:SetAttribute("Bytes", m.bytes)
					it:SetAttribute("Sha", m.sha)
					meta:Destroy()
				end
				local old = target:FindFirstChild(it.Name)
				if old and old ~= it then old:Destroy() end
				it.Parent = target
				moved += 1
			end
		end
	end
	if model ~= source or type(source) == "number" then model:Destroy() end
	return string.format("unpacked %d items (version %s)", moved, version and version.Value or "?")
end
]]></ProtectedString></Properties></Item></Item></Item></roblox>