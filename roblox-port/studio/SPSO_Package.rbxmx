]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000011"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[-- Remote events shared by server and clients (created by the server under ReplicatedStorage.SPSO.Remotes)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}
local folder

local function getFolder()
	if folder then return folder end
	local spso = ReplicatedStorage:WaitForChild("SPSO")
	if RunService:IsServer() then
		folder = spso:FindFirstChild("Remotes")
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = "Remotes"
			folder.Parent = spso
		end
	else
		folder = spso:WaitForChild("Remotes")
	end
	return folder
end

function Net.event(name: string): RemoteEvent
	local f = getFolder()
	local e = f:FindFirstChild(name)
	if not e then
		if RunService:IsServer() then
			e = Instance.new("RemoteEvent")
			e.Name = name
			e.Parent = f
		else
			e = f:WaitForChild(name)
		end
	end
	return e
end

return Net
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000012"><Properties><string name="Name">Sound</string><ProtectedString name="Source"><![CDATA[-- Plays the original game's sounds from the uploaded sound sprites (tools/build_fx.py packs every hero sound,
-- UI sound and music track into a few files; FxData.Sounds holds each clip's [start, length, sprite]).
--   Sound.play(key, { at = Instance | Vector3 | nil, volume, pitch, minDist, maxDist })  -> Sound?
--   Sound.music(key)  loops a track (nil stops the music)
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")

local Game = script.Parent
local FxData = require(Game:WaitForChild("FxData"))
local Assets = require(Game:WaitForChild("Assets"))

local Sound = {}
local SEGMENTS = FxData.Sounds or {}
Sound.Volume = { sfx = 0.8, ui = 0.6, music = 0.35 }

local function make(key: string, opts)
	local seg = SEGMENTS[key]
	local sprite = seg and ((Assets.SoundSprites and Assets.SoundSprites[seg[3] or 1]) or Assets.SoundSprite)
	if not seg or not sprite or sprite == "" then return nil end
	local s = Instance.new("Sound")
	s.Name = key
	s.SoundId = sprite
	s.PlaybackRegionsEnabled = true
	s.PlaybackRegion = NumberRange.new(seg[1], seg[1] + seg[2])
	s.PlaybackSpeed = opts.pitch or 1
	s.Volume = (opts.volume or 1) * (opts.channel and Sound.Volume[opts.channel] or Sound.Volume.sfx)
	s.RollOffMode = Enum.RollOffMode.InverseTapered
	s.RollOffMinDistance = opts.minDist or 10
	s.RollOffMaxDistance = math.max(opts.maxDist or 200, (opts.minDist or 10) + 1)
	return s, seg[2] / (opts.pitch or 1)
end

function Sound.has(key: string): boolean
	return SEGMENTS[key] ~= nil
end

function Sound.play(key: string, opts)
	opts = opts or {}
	local s, length = make(key, opts)
	if not s then return nil end
	local at = opts.at
	if typeof(at) == "Vector3" then
		local a = Instance.new("Attachment")
		a.WorldPosition = at
		a.Parent = workspace.Terrain
		s.Parent = a
		Debris:AddItem(a, length + 0.3)
	elseif typeof(at) == "Instance" then
		s.Parent = at
		Debris:AddItem(s, length + 0.3)
	else
		s.Parent = SoundService
		Debris:AddItem(s, length + 0.3)
	end
	s:Play()
	return s
end

local current
function Sound.music(key: string?)
	if current then
		current:Stop()
		current:Destroy()
		current = nil
	end
	if not key then return end
	local s = make(key, { channel = "music" })
	if not s then return end
	s.Looped = true
	s.LoopRegion = s.PlaybackRegion
	s.Parent = SoundService
	s:Play()
	current = s
end

-- UI helpers: the original HUD sounds
function Sound.ui(name: string)
	local map = {
		click = "HUD_UI_Button_Press_Small", clickBig = "HUD_UI_Button_Press_Large",
		hover = "HUD_UI_Button_Rollover_Small_" .. math.random(1, 4), windowIn = "HUD_UI_GlobalWindowIn",
		windowOut = "HUD_UI_GlobalWindowOut", alert = "HUD_UI_Popup_Alert", achievement = "HUD_UI_EarnAchievement",
		levelUp = "HUD_UI_LevelUp", coins = "HUD_UI_EarnCoins", xp = "HUD_UI_EarnXP", star = "FX_Pickups_Star_Collect10",
		whoosh = "HUD_UI_CameraWhoosh", tab = "HUD_UI_Shop_Tab", win = "HUD_UI_PrizeWheel_Win", lose = "HUD_UI_PrizeWheel_Lose",
		spawn = "Fx_Spawn_Char_SpawnIn_1",
	}
	return Sound.play(map[name] or name, { channel = "ui" })
end

return Sound
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000013"><Properties><string name="Name">StageBuilder</string><ProtectedString name="Source"><![CDATA[-- Builds one original brawler stage in the workspace from MissionData (tools/convert_scenario.py):
--   * every tile at its ObjectPlaceholder placement (mirrored placements use the tile's mirrored model),
--     scaled like the original; parts keep the baked lighting textures, glow parts are Neon
--   * collision: the tiles' own collision meshes rebuilt as wedge pairs (precise, no convex filling),
--     the scenario's invisible walls as boxes
--   * static props (laser holders, power-up crates, parked fighter craft) and the laser gate beams
-- Tile and prop models come from ServerStorage.SPSO.Tiles (inserted by setup/02_tiles).
local MissionData = require(script.Parent:WaitForChild("MissionData"))

local StageBuilder = {}
local THICK = 1.5 -- collision wedge thickness (behind the surface)

local function cfOf(t)
	return CFrame.new(t[1], t[2], t[3], t[4], t[5], t[6], t[7], t[8], t[9], t[10], t[11], t[12])
end
StageBuilder.cf = cfOf

local function wedge(parent, cf, size)
	local w = Instance.new("WedgePart")
	w.Anchored, w.CanCollide, w.CanQuery, w.CanTouch = true, true, true, false
	w.Transparency = 1
	w.CastShadow = false
	w.Size = size
	w.CFrame = cf
	w.Parent = parent
	return w
end

-- triangle (outward winding) -> two wedges, the surface on the triangle, thickness behind it
local function triangle(parent, a: Vector3, b: Vector3, c: Vector3)
	local n = (b - a):Cross(c - a)
	if n.Magnitude < 1e-4 then return end
	local back = -n.Unit * (THICK / 2)
	local ab, ac, bc = b - a, c - a, c - b
	local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
	if abd > acd and abd > bcd then
		c, a = a, c
	elseif acd > bcd and acd > abd then
		a, b = b, a
	end
	ab, ac, bc = b - a, c - a, c - b
	local right = ac:Cross(ab)
	if right.Magnitude < 1e-6 or bc.Magnitude < 1e-6 then return end
	right = right.Unit
	local up = bc:Cross(right).Unit
	local fwd = bc.Unit
	local h = math.abs(ab:Dot(up))
	if h < 0.01 then return end
	local d1, d2 = math.abs(ab:Dot(fwd)), math.abs(ac:Dot(fwd))
	if d1 > 0.01 then
		wedge(parent, CFrame.fromMatrix((a + b) / 2 + back, right, up, fwd), Vector3.new(THICK, h, d1))
	end
	if d2 > 0.01 then
		wedge(parent, CFrame.fromMatrix((a + c) / 2 + back, -right, up, -fwd), Vector3.new(THICK, h, d2))
	end
end

-- one tile / prop model placed like the game's ObjectPlaceholder: world CFrame, uniform scale
function StageBuilder.place(templates: Instance, name: string, cf: CFrame, scale: number, parent: Instance, collisionParent: Instance?)
	local info = MissionData.Tiles[name]
	local tpl = templates:FindFirstChild(name)
	if not info or not tpl then
		warn("[SPSO] stage model missing: " .. name)
		return nil
	end
	local m = tpl:Clone()
	-- the imported parts sit at their bounding-box centres: recover the tile origin from any known part
	local origin
	for _, p in m:GetDescendants() do
		local pi = p:IsA("BasePart") and info.parts[p.Name]
		if pi then
			origin = p.Position - Vector3.new(pi.center[1], pi.center[2], pi.center[3])
			break
		end
	end
	if not origin then
		m:Destroy()
		warn("[SPSO] no known parts in " .. name)
		return nil
	end
	local o = CFrame.new(origin)
	for _, p in m:GetDescendants() do
		if p:IsA("BasePart") then
			local rel = o:ToObjectSpace(p.CFrame)
			p.Size *= scale
			p.CFrame = cf * (rel - rel.Position + rel.Position * scale)
			p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
			p.CastShadow = false
			local pi = info.parts[p.Name]
			if pi and pi.kind == "glow" then
				p.Material = Enum.Material.Neon
				p.Color = Color3.new(pi.color[1], pi.color[2], pi.color[3])
				if p:IsA("MeshPart") then p.TextureID = "" end
			elseif pi and pi.kind == "color" then
				p.Material = Enum.Material.SmoothPlastic
				p.Color = Color3.new(pi.color[1], pi.color[2], pi.color[3])
			else
				p.Material = Enum.Material.SmoothPlastic
				p.Color = Color3.new(1, 1, 1)
			end
			if pi and pi.alpha then p.Transparency = 0.25 end
		end
	end
	m.Name = name
	m.Parent = parent
	if collisionParent and info.collision and #info.collision > 0 then
		local mirror = string.sub(name, -2) == "_M"
		local folder = Instance.new("Folder")
		folder.Name = name
		for _, t in info.collision do
			local a = Vector3.new(t[1], t[2], t[3])
			local b = Vector3.new(t[4], t[5], t[6])
			local c = Vector3.new(t[7], t[8], t[9])
			if mirror then -- collision is stored for the un-mirrored tile
				a, b, c = Vector3.new(-a.X, a.Y, a.Z), Vector3.new(-c.X, c.Y, c.Z), Vector3.new(-b.X, b.Y, b.Z)
			end
			triangle(folder, cf * (a * scale), cf * (b * scale), cf * (c * scale))
		end
		folder.Parent = collisionParent
	end
	return m
end

local function box(parent, b, name: string, transparency: number?)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, true, true, false
	p.Transparency = transparency or 1
	p.CastShadow = false
	p.Size = Vector3.new(math.max(b.size[1], 0.05), math.max(b.size[2], 0.05), math.max(b.size[3], 0.05))
	p.CFrame = cfOf(b.cf)
	p.Parent = parent
	return p
end

-- the whole stage; returns the folder and the crate models (breakable power-up crates)
function StageBuilder.build(stage, templates: Instance, parent: Instance)
	local folder = Instance.new("Folder")
	folder.Name = "SPSO_Stage"
	local geo = Instance.new("Folder")
	geo.Name = "Geometry"
	geo.Parent = folder
	local col = Instance.new("Folder")
	col.Name = "Collision"
	col.Parent = folder
	for _, t in stage.tiles do
		StageBuilder.place(templates, t.tile, cfOf(t.cf), t.scale, geo, col)
	end
	local crates = {}
	for i, p in stage.props do
		local m = StageBuilder.place(templates, p.model, cfOf(p.cf), p.scale, geo, not p.crate and col or nil)
		if m and p.crate then
			m.Name = "Crate_" .. i
			table.insert(crates, m)
		end
	end
	for _, w in stage.walls do
		box(col, w, "Wall")
	end
	local lasers = Instance.new("Folder")
	lasers.Name = "Lasers"
	lasers.Parent = geo
	for _, l in stage.lasers do
		local p = Instance.new("Part")
		p.Name = "LaserGate"
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
		p.Material = Enum.Material.Neon
		p.Color = Color3.fromRGB(255, 60, 140)
		p.Transparency = 0.35
		p.CastShadow = false
		local dir = Vector3.new(l.dir[1], l.dir[2], l.dir[3]).Unit
		local base = cfOf(l.cf)
		p.Size = Vector3.new(math.max(l.width * 0.5, 0.15), math.max(l.width * 0.5, 0.15), l.length)
		p.CFrame = CFrame.lookAt(base.Position, base.Position + dir)
		p.Parent = lasers
	end
	folder.Parent = parent
	return folder, crates
end

return StageBuilder
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000026"><Properties><string name="Name">ServerScriptService/SPSO</string></Properties><Item class="Script" referent="RBX000014"><Properties><string name="Name">Brawler</string><ProtectedString name="Source"><![CDATA[-- SPSO brawler server. Heroes and enemies are "fighters" driven by the original game data (GameData):
--   * every hero's L1-L5 chain, R1-R3 power attacks (power cost) and super; the clips' own AnimationEvents
--     (OnCollisionEnable/Disable, OnProjectileFire, OnChainAttack) time each impact, through a headless
--     ExactAnimator per fighter that also gives the exact bone positions of the attack colliders
--   * impact types: melee colliders (spheres on bones), projectiles (speed, lifespan, gravity, explosion),
--     beams, target impacts; damage, recoil type (small/big/getup/knockdown/launch/stun), pushback, launch
--   * power gain from damage dealt and received, combo heat, KO scoring, survival bonus, medals
--   * enemy archetypes (melee thugs, ranged blasters, the warlord boss) with their original stats
--   * hero select, waves, pickups
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local SPSO = ReplicatedStorage:WaitForChild("SPSO")
local Game = SPSO:WaitForChild("Game")
local Config = require(Game:WaitForChild("GameConfig"))
local GameData = require(Game:WaitForChild("GameData"))
local Assets = require(Game:WaitForChild("Assets"))
local Net = require(Game:WaitForChild("Net"))
local HeroPack = require(SPSO:WaitForChild("Runtime"):WaitForChild("HeroPack"))
local ExactAnimator = require(SPSO.Runtime:WaitForChild("ExactAnimator"))

local MissionData = Config.Mission and require(Game:WaitForChild("MissionData")) or nil
local StageBuilder = Config.Mission and require(Game:WaitForChild("StageBuilder")) or nil

local AttackRemote, EmoteRemote, FxRemote = Net.event("Attack"), Net.event("Emote"), Net.event("Fx")
local SelectRemote = Net.event("SelectHero")
local S = GameData.Scoring

Players.CharacterAutoLoads = false
Players.RespawnTime = Config.RespawnTime
workspace.Gravity = GameData.Heroes[Config.DefaultHero].gravity

local arena = workspace:WaitForChild(Config.Map, 30)
local spawns = arena and arena:FindFirstChild("Spawns")
local enemyFolder = workspace:FindFirstChild("SPSO_Enemies") or Instance.new("Folder")
enemyFolder.Name = "SPSO_Enemies"
enemyFolder.Parent = workspace
local pickupFolder = workspace:FindFirstChild("SPSO_Pickups") or Instance.new("Folder")
pickupFolder.Name = "SPSO_Pickups"
pickupFolder.Parent = workspace

local fighters = {}
local projectiles = {}
local pickups = {}
local seq, projSeq = 0, 0
local now = os.clock
local Score = { team = 0, deaths = 0, kos = 0, running = false }
local Stats = { attacks = 0, opens = 0, checks = 0, hits = 0, projectiles = 0, beams = 0 }
_G.SPSO_Stats, _G.SPSO_Fighters = Stats, fighters -- for playtest tooling

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local Mission = { stage = nil, folder = nil, crates = {} } -- the running original mission (Config.Mission)

local function spawnPoint(prefix: string, i: number): CFrame
	if Mission.stage and prefix == "Player" and #Mission.stage.players > 0 then
		local pl = Mission.stage.players
		return StageBuilder.cf(pl[(i - 1) % #pl + 1])
	end
	local pts = {}
	if spawns then
		for _, p in spawns:GetChildren() do
			if p:IsA("BasePart") and string.sub(p.Name, 1, #prefix) == prefix then table.insert(pts, p) end
		end
		table.sort(pts, function(a, b) return a.Name < b.Name end)
	end
	if #pts == 0 then return CFrame.new(0, 6, prefix == "Player" and 25 or -25) end
	return pts[(i - 1) % #pts + 1].CFrame
end

local wallParams = RaycastParams.new()
wallParams.FilterType = Enum.RaycastFilterType.Include
wallParams.FilterDescendantsInstances = { arena and arena:FindFirstChild("Collision") or workspace.Terrain }
local function setWalls(folder)
	wallParams.FilterDescendantsInstances = { folder or workspace.Terrain }
end

-- fighters ------------------------------------------------------------------------------------------------------
local Fighter = {}
Fighter.__index = Fighter

function Fighter.new(model: Model, team: string, player: Player?, hero: string, archetype: string?)
	local f = setmetatable({}, Fighter)
	f.model, f.team, f.player, f.hero, f.arch = model, team, player, hero, archetype
	f.data = archetype and GameData.Enemies[archetype] or GameData.Heroes[hero]
	f.ai = archetype and Config.Enemies[archetype] or nil
	f.damageScale = f.ai and f.ai.damageScale or 1
	f.radius = (f.data.radius and f.data.radius > 0) and f.data.radius or Config.TargetRadius
	f.hum = model:FindFirstChildOfClass("Humanoid")
	f.hrp = model:FindFirstChild("HumanoidRootPart")
	local m6 = f.hrp and f.hrp:FindFirstChild("RigRoot")
	f.rigC0 = m6 and m6.C0 or CFrame.new(0, -3.3, 0)
	f.power, f.heat = 0, 0
	f.chainKind, f.chainIndex, f.chainOpen, f.buffered = nil, 0, false, nil
	f.action, f.actionKind, f.atk = nil, nil, nil
	f.dead = false
	f.nextThink, f.nextAttack, f.launchAt, f.stunUntil, f.nextSuper = 0, now() + 1.5, nil, nil, now() + 8
	f.actionStart, f.stunImmuneUntil, f.lastHitAt = 0, 0, 0
	f.anim = ExactAnimator.new(HeroPack.get(hero), nil, { headless = true, wrapModes = Config.WrapModes })
	f.anim.Event:Connect(function(fn, data, clip) f:onEvent(fn, data, clip) end)
	model:SetAttribute("SPSO_Hero", hero)
	model:SetAttribute("SPSO_Archetype", archetype)
	model:SetAttribute("SPSO_Team", team)
	model:SetAttribute("SPSO_Dead", false)
	model:SetAttribute("SPSO_Lock", false)
	CollectionService:AddTag(model, "SPSO_Fighter")
	fighters[model] = f
	return f
end

function Fighter:rigCF(): CFrame
	return self.hrp.CFrame * self.rigC0
end

function Fighter:nodePos(node: string?, offset): Vector3
	local root = self:rigCF()
	local ncf = node and self.anim:NodeCFrame(node)
	if not ncf then return (root * CFrame.new(0, 3.5, -1.5)).Position end
	local o = offset and Vector3.new(offset[1], offset[2], offset[3]) or Vector3.zero
	return (root * ncf * CFrame.new(o)).Position
end

function Fighter:colliderPos(imp): Vector3
	local col = self.data.colliders and self.data.colliders[imp.collider]
	return self:nodePos(col and col.node or "fx_Rpalm", col and col.offset)
end

function Fighter:chest(): Vector3
	return self.hrp.Position + Vector3.new(0, 0.6, 0)
end

function Fighter:play(clip: string, fade: number, kind: string, attackKey: string?)
	seq += 1
	local anim = self.anim
	if anim:IsPlaying(clip) then anim:Stop(clip) end
	anim:CrossFade(clip, fade)
	self.action, self.actionKind = clip, kind
	self.actionStart = now()
	self.chainOpen = false
	self.atk = nil
	if attackKey then
		local def = self.data.attacks[attackKey]
		self.atk = { key = attackKey, def = def, open = {}, hits = {}, count = {}, fired = {}, timed = {}, nextProj = 1 }
	end
	self.model:SetAttribute("SPSO_Action", string.format("%s|%.4f|%.3f|%d", clip, workspace:GetServerTimeNow(), fade, seq))
	self.model:SetAttribute("SPSO_Lock", kind ~= "emote")
end

function Fighter:clear()
	seq += 1
	self.action, self.actionKind, self.atk = nil, nil, nil
	self.chainKind, self.chainIndex, self.chainOpen = nil, 0, false
	self.launchAt, self.stunUntil = nil, nil
	self.anim:Stop()
	self.model:SetAttribute("SPSO_Action", string.format("none|%.4f|0.2|%d", workspace:GetServerTimeNow(), seq))
	self.model:SetAttribute("SPSO_Lock", false)
end

function Fighter:addPower(n: number)
	self.power = math.clamp(self.power + n, 0, Config.SuperCost)
	if self.player then self.player:SetAttribute("SPSO_Power", self.power) end
end

function Fighter:addHeat(n: number)
	self.heat = math.clamp(self.heat + n, 0, S.comboMax)
	if self.player then self.player:SetAttribute("SPSO_Combo", self.heat) end
end

-- impacts --------------------------------------------------------------------------------------------------------
local function inBrawler(f): boolean -- heroes in a social zone are out of the fight
	return not f.player or Config.Mode ~= "Hub" or f.player:GetAttribute("SPSO_Zone") == "Brawler"
end
local function opponents(f)
	local out = {}
	for _, t in fighters do
		if t ~= f and t.team ~= f.team and not t.dead and t.hrp and t.hrp.Parent and inBrawler(t) then table.insert(out, t) end
	end
	return out
end

function Fighter:nearestOpponent(maxDist: number?, inFront: boolean?)
	local best, bd = nil, maxDist or math.huge
	local look = flat(self.hrp.CFrame.LookVector)
	for _, t in opponents(self) do
		local off = flat(t.hrp.Position - self.hrp.Position)
		local d = off.Magnitude
		if d < bd and (not inFront or d < 4 or look:Dot(off.Unit) > 0.2) then best, bd = t, d end
	end
	return best, bd
end

local function bodyDistance(t, p: Vector3): number
	local base = t.hrp.Position
	local y = math.clamp(p.Y, base.Y - 3.3, base.Y + 2.2)
	return (Vector3.new(base.X, y, base.Z) - p).Magnitude
end

function Fighter:canHit(i: number, imp, t): boolean
	local a = self.atk
	a.hits[i] = a.hits[i] or {}
	a.count[i] = a.count[i] or 0
	if (a.hits[i][t] or 0) >= math.max(1, imp.maxHits) then return false end
	if imp.maxTargets > 0 and a.count[i] >= imp.maxTargets then return false end
	return true
end

function Fighter:registerHit(i: number, t)
	local a = self.atk
	a.hits[i][t] = (a.hits[i][t] or 0) + 1
	a.count[i] += 1
end

local breakCrate -- mission crates (defined with the mission code)
function Fighter:meleeCheck(i: number, imp)
	local pos = self:colliderPos(imp)
	if self.team == "Hero" then Stats.checks += 1 end
	local r = math.max(1.2, imp.radius) * Config.HitRadiusScale
	for _, t in opponents(self) do
		if self:canHit(i, imp, t) and bodyDistance(t, pos) <= r + t.radius then
			self:registerHit(i, t)
			t:takeHit(self, imp, pos)
		end
	end
	if self.team == "Hero" and breakCrate then
		for crate, c in Mission.crates do
			if not c.broken and (c.pos - pos).Magnitude <= r + c.radius then breakCrate(crate, self) end
		end
	end
end

function Fighter:aimDir(from: Vector3, range: number): Vector3
	local tgt = self:nearestOpponent(range + 6, true)
	if tgt then
		local d = tgt:chest() - from
		if d.Magnitude > 0.1 then return d.Unit end
	end
	return flat(self.hrp.CFrame.LookVector).Unit
end

function Fighter:fireBeam(i: number, imp)
	local def = self.atk.def
	local from = self:colliderPos(imp)
	local range = math.max(def.range, 20)
	local dir = self:aimDir(from, range)
	local hitT, hitAt, best = nil, nil, range
	local r = math.max(1, imp.radius) * Config.HitRadiusScale
	for _, t in opponents(self) do
		local rel = t:chest() - from
		local along = rel:Dot(dir)
		if along > 0 and along < best and (rel - dir * along).Magnitude <= r + t.radius then
			hitT, best, hitAt = t, along, from + dir * along
		end
	end
	local to = hitAt or (from + dir * range)
	local wall = workspace:Raycast(from, to - from, wallParams)
	if wall and (not hitAt or (wall.Position - from).Magnitude < best) then
		to, hitT = wall.Position, nil
	end
	FxRemote:FireAllClients("beam", { hero = self.hero, from = from, to = to })
	if hitT and self:canHit(i, imp, hitT) then
		self:registerHit(i, hitT)
		hitT:takeHit(self, imp, to)
	end
end

function Fighter:fireProjectile(i: number, imp)
	local from = self:colliderPos(imp)
	local speed = imp.speed > 0 and imp.speed or 38
	local life = imp.life > 0 and imp.life or 3
	local dir = imp.aimed ~= false and self:aimDir(from, speed * life) or flat(self.hrp.CFrame.LookVector).Unit
	projSeq += 1
	local p = { id = projSeq, owner = self, imp = imp, idx = i, pos = from, vel = dir * speed,
		g = imp.gravity or 0, expires = now() + life, hit = {}, atkRef = self.atk }
	projectiles[p.id] = p
	FxRemote:FireAllClients("proj", { id = p.id, from = from, vel = p.vel, life = life, g = p.g, kind = imp.visual or "orb",
		hero = self.arch and "Shared" or self.hero, team = self.team })
end

function Fighter:targetImpact(i: number, imp)
	local tgt = self:nearestOpponent((self.atk.def.range or 10) + 4, true)
	if tgt and self:canHit(i, imp, tgt) then
		self:registerHit(i, tgt)
		tgt:takeHit(self, imp, tgt:chest())
	end
end

function Fighter:triggerImpact(i: number, open: boolean)
	local imp = self.atk.def.impacts[i]
	if not imp then return end
	if imp.type == 2 then
		if open then self:fireBeam(i, imp) end
	elseif imp.type == 3 then
		if open then self:targetImpact(i, imp) end
	elseif imp.type ~= 1 then
		self.atk.open[i] = open or nil
		if open and self.team == "Hero" then Stats.opens += 1 end
		if open then self:meleeCheck(i, imp) end
	end
end

function Fighter:onEvent(fn: string, data: string, clip: string)
	if clip ~= self.action or not self.model.Parent then return end
	local a = self.atk
	if fn == "OnChainAttackAnimTag" then
		if not self.chainOpen then
			self.chainOpen = true
			if self.buffered then
				local k = self.buffered
				self.buffered = nil
				self:tryAttack(k)
			end
		end
		return
	end
	if not a then return end
	local idx = tonumber(data)
	if fn == "OnCollisionEnableAnimTag" or fn == "OnCollisionDisableAnimTag" then
		local open = fn == "OnCollisionEnableAnimTag"
		if idx then
			self:triggerImpact(idx, open)
		else
			for i, imp in a.def.impacts do
				if imp.type ~= 1 then self:triggerImpact(i, open) end
			end
		end
	elseif fn == "OnProjectileFireAnimTag" then
		local i
		if a.def.repeatFire then
			i = 1
		elseif idx and a.def.impacts[idx] and a.def.impacts[idx].type == 1 then
			i = idx
		else
			for k = a.nextProj, #a.def.impacts do
				if a.def.impacts[k].type == 1 then i = k break end
			end
			a.nextProj = (i or #a.def.impacts) + 1
		end
		if i and a.def.impacts[i] then self:fireProjectile(i, a.def.impacts[i]) end
	end
end

-- impacts the clip has no AnimationEvents for: the data's own timings, else the middle of the clip
function Fighter:timedImpacts()
	local a = self.atk
	local st = self.anim:GetState(self.action)
	local t, dur = st and st.time or 0, math.max(0.1, a.def.duration or (st and st.length) or 1)
	for i, imp in a.def.impacts do
		if imp.type == 1 then
			if a.def.events.projectile == 0 and not a.timed[i] then
				local at = imp.fire > 0 and imp.fire or dur * 0.4
				if t >= at then
					a.timed[i] = true
					self:fireProjectile(i, imp)
				end
			end
		elseif a.def.events.collision == 0 then
			local t0, t1 = imp.start, imp.stop
			if not (t1 > t0 and t0 >= 0) then t0, t1 = dur * 0.35, dur * 0.6 end
			if not a.timed[i] and t >= t0 then
				a.timed[i] = 1
				self:triggerImpact(i, true)
			elseif a.timed[i] == 1 and t >= t1 then
				a.timed[i] = 2
				self:triggerImpact(i, false)
			end
		end
	end
end

-- attacks -------------------------------------------------------------------------------------------------------
local CHAIN_L = { "L1", "L2", "L3", "L4", "L5" }

function Fighter:startAttack(key: string): boolean
	local def = self.data.attacks[key]
	if not def or not self.anim:HasClip(def.anim) then return false end
	if self.team == "Hero" and def.cost > 0 then
		if self.power + 1e-6 < def.cost then
			if self.player then FxRemote:FireClient(self.player, "denied", { need = def.cost }) end
			return false
		end
		self:addPower(-def.cost)
	end
	self:play(def.anim, Config.FadeAttack, "attack", key)
	Stats.attacks += 1
	return true
end

function Fighter:tryAttack(kind: string)
	if self.dead or self.actionKind == "death" then return end
	if self.actionKind == "recoil" then
		local cancel = self.team == "Hero" and (self.action == "recoil_small" or self.action == "recoil_big")
			and now() - self.actionStart >= Config.RecoilCancel
		if not cancel then return end
		self:clear()
	end
	local busy = self.actionKind == "attack"
	if busy and not self.chainOpen then
		self.buffered = kind
		return
	end
	if kind == "L" then
		local idx = (busy and self.chainKind == "L") and self.chainIndex + 1 or 1
		if not CHAIN_L[idx] then idx = 1 end
		if self:startAttack(CHAIN_L[idx]) then self.chainKind, self.chainIndex = "L", idx end
	elseif kind == "R" or kind == "R1" or kind == "R2" or kind == "R3" or kind == "Super" then
		local key = kind == "R" and "R1" or kind
		if self:startAttack(key) then self.chainKind, self.chainIndex = key, 1 end
	end
end

-- hits ------------------------------------------------------------------------------------------------------------
local function enemiesLeft(): number
	local n = 0
	for _, f in fighters do
		if f.team == "Enemy" and not f.dead then n += 1 end
	end
	return n
end

local function publishScore()
	local bonus = S.survivalBonus[math.min(Score.deaths, 3) + 1] or 1
	SPSO:SetAttribute("TeamScore", math.floor(Score.team * bonus + 0.5))
	SPSO:SetAttribute("SurvivalBonus", bonus)
end

local function dropPickups(pos: Vector3)
	local function drop(kind)
		local p = Instance.new("Part")
		p.Name = "Pickup_" .. kind
		p.Shape = Enum.PartType.Ball
		p.Size = Vector3.one * 1.6
		p.Material = Enum.Material.Neon
		p.Color = kind == "star" and Color3.fromRGB(255, 214, 64) or Color3.fromRGB(255, 80, 110)
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
		p.Position = pos + Vector3.new(math.random() * 4 - 2, 1.5, math.random() * 4 - 2)
		p:SetAttribute("Kind", kind)
		p.Parent = pickupFolder
		pickups[p] = now() + 14
	end
	if math.random() < Config.PickupChance.star then drop("star") end
	if math.random() < Config.PickupChance.health then drop("health") end
end

function Fighter:die(attacker, imp)
	if self.dead then return end
	self.dead = true
	self.buffered = nil
	self.model:SetAttribute("SPSO_Dead", true)
	if self.team == "Enemy" then
		SPSO:SetAttribute("EnemiesLeft", enemiesLeft())
		if attacker and attacker.team == "Hero" then
			local rank = math.clamp(self.data.rank or 1, 0, 5)
			local mult = math.floor(math.max(0, math.min(attacker.heat, S.comboMax - 1))) + 1
			local pts = (S.koValues[rank + 1] or 100) * mult
			Score.team += pts
			Score.kos += 1
			publishScore()
			FxRemote:FireAllClients("score", { pos = self:chest() + Vector3.new(0, 3, 0), points = pts, mult = mult })
		end
		if not Mission.stage then dropPickups(self.hrp.Position) end
		if self.ai and self.ai.boss then FxRemote:FireAllClients("bossKO", { pos = self:chest() }) end
		if self.onKilled then task.spawn(self.onKilled, self) end
		if imp and (imp.recoil == 5 or imp.recoil == 4) then
			self.hum:ChangeState(Enum.HumanoidStateType.Freefall)
			local dir = attacker and flat(self.hrp.Position - attacker.hrp.Position) or Vector3.zero
			dir = dir.Magnitude > 0.1 and dir.Unit or -self.hrp.CFrame.LookVector
			self.hrp.AssemblyLinearVelocity = dir * math.max(12, imp.pushback) + Vector3.new(0, math.max(20, imp.launch), 0)
			self:play("recoil_launch", Config.FadeRecoil, "death")
			task.delay(0.75, function()
				if self.model.Parent then self:play("recoil_launch_land", 0.05, "death") end
			end)
		else
			self:play("recoil_death", Config.FadeRecoil, "death")
		end
		task.delay(Config.DespawnAfter, function()
			fighters[self.model] = nil
			self.model:Destroy()
			if self.onDespawn then self.onDespawn(self) end
		end)
	else
		Score.deaths += 1
		publishScore()
		self:addHeat(-S.comboMax)
		self:play("recoil_death", Config.FadeRecoil, "death")
		if self.hrp then self.hrp.Anchored = true end
	end
end

local RECOIL = { [1] = "small", [2] = "big", [3] = "getup", [4] = "knockdown", [5] = "launch", [6] = "small", [7] = "stun", [8] = "small" }

local fireEvent -- scenario events (mission code)
function Fighter:takeHit(attacker, imp, src: Vector3?)
	if self.dead then return end
	if self.asleep and self.wakeOnHit ~= false then self.asleep = false end
	if imp.event and fireEvent and attacker.team == "Enemy" then fireEvent(imp.event) end
	if attacker.team == "Hero" then Stats.hits += 1 end
	local dmg = imp.damage * (attacker.damageScale or 1)
	self.hum.Health = math.max(0, self.hum.Health - dmg)
	if attacker.team == "Hero" then
		attacker:addPower(dmg * (attacker.data.powerDealt or 0.5))
		attacker:addHeat(dmg * S.comboGainPerDamage)
	end
	if self.team == "Hero" then
		self:addPower(dmg * (self.data.powerReceived or 0.5))
		self:addHeat(-dmg * S.comboLossPerDamage)
	end
	local recoil = imp.recoil or 1
	local limit = self.data.recoilLimit or 0
	if limit > 0 and recoil > limit then recoil = limit end
	FxRemote:FireAllClients("hit", {
		pos = src or self:chest(), amount = math.floor(dmg + 0.5), heavy = recoil >= 2, team = self.team,
		hero = attacker.arch and "Shared" or attacker.hero, effect = imp.effect, victim = self.model,
	})
	if self.team == "Enemy" and attacker.hrp then
		local dir = flat(attacker.hrp.Position - self.hrp.Position)
		if dir.Magnitude > 0.1 then self.hrp.CFrame = CFrame.lookAt(self.hrp.Position, self.hrp.Position + dir) end
	end
	if self.hum.Health <= 0 then
		self:die(attacker, imp)
		return
	end
	self.lastHitAt = now()
	local reaction = RECOIL[recoil]
	if not reaction then return end -- 0 none, 9 uninterruptible: damage only
	if self.ai and self.ai.boss and (reaction == "small") and self.actionKind == "attack" then return end
	if self.team == "Hero" then
		if now() < self.stunImmuneUntil then return end
		self.stunImmuneUntil = now() + Config.HeroStunImmunity
		if reaction == "launch" or reaction == "knockdown" or reaction == "getup" then reaction = "big" end
	end
	self.buffered = nil
	-- pushback away from the attacker (or from the collider), launch upward
	local from = (imp.fromCollider and src) or attacker.hrp.Position
	local dir = flat(self.hrp.Position - from)
	dir = dir.Magnitude > 0.05 and dir.Unit or -self.hrp.CFrame.LookVector
	local push = dir * (imp.pushback or 0) * (1 - math.clamp(self.data.pushbackResist or 0, 0, 1))
	local up = (reaction == "launch" or reaction == "knockdown") and math.max(imp.launch or 0, reaction == "knockdown" and 8 or 18) or 0
	if self.team == "Hero" then
		if self.player and push.Magnitude > 0.1 then FxRemote:FireClient(self.player, "push", { vel = push, time = imp.pushTime }) end
	else
		if up > 0 then self.hum:ChangeState(Enum.HumanoidStateType.Freefall) end
		self.hrp.AssemblyLinearVelocity = push + Vector3.new(0, up, 0)
	end
	if reaction == "launch" or reaction == "knockdown" then
		self:play("recoil_launch", Config.FadeRecoil, "recoil")
		self.launchAt = now()
	elseif reaction == "getup" then
		self:play("recoil_getup", Config.FadeRecoil, "recoil")
	elseif reaction == "stun" then
		self:play("recoil_stun", Config.FadeRecoil, "recoil")
		self.stunUntil = now() + math.max(1.2, imp.recoilTime or 0)
	else
		self:play(reaction == "big" and "recoil_big" or "recoil_small", Config.FadeRecoil, "recoil")
	end
	if self.team == "Enemy" then self.nextAttack = math.max(self.nextAttack, now() + 0.9) end
end

function Fighter:onActionEnd()
	local clip, kind = self.action, self.actionKind
	if kind == "death" then return end
	local tp = self.ai and self.ai.teleport
	if tp and clip == tp[1] then -- the warlord reappears next to a hero and strikes
		local t = self:nearestOpponent()
		if t then
			local dir = flat(self.hrp.Position - t.hrp.Position)
			dir = dir.Magnitude > 0.1 and dir.Unit or Vector3.zAxis
			local pos = t.hrp.Position + dir * 6
			self.hrp.CFrame = CFrame.lookAt(pos, Vector3.new(t.hrp.Position.X, pos.Y, t.hrp.Position.Z))
		end
		self:play(tp[2], Config.FadeAttack, "attack", self.data.attacks[tp[2]] and tp[2] or nil)
		return
	end
	if clip == "recoil_launch_land" then
		self:play("recoil_getup", 0.1, "recoil")
		return
	end
	local b = self.buffered
	self.buffered = nil
	self:clear()
	if b then self:tryAttack(b) end
end

-- enemy AI --------------------------------------------------------------------------------------------------------
local function attackersNow(): number
	local n = 0
	for _, o in fighters do
		if o.team == "Enemy" and o.actionKind == "attack" then n += 1 end
	end
	return n
end

function Fighter:pickAttack(dist: number)
	local keys = {}
	local tp = self.ai.teleport
	for k, a in self.data.attacks do
		if k ~= "Super" and not (tp and k == tp[2]) and not (self.ai.noAttacks and self.ai.noAttacks[k])
			and (dist <= a.range + 6 or self.ai.keepDistance > 0) then table.insert(keys, k) end
	end
	if self.ai.boss and now() >= self.nextSuper and self.data.attacks.Super then
		self.nextSuper = now() + self.ai.superEvery
		return "Super"
	end
	if #keys == 0 then return nil end
	return keys[math.random(#keys)]
end

local shapeshift -- mission code
function Fighter:think()
	local t = now()
	if self.dead or t < self.nextThink or self.spawningIn then return end
	self.nextThink = t + self.ai.think
	if self.action then
		self.hum.WalkSpeed = 0
		return
	end
	self.hum.WalkSpeed = self.data.speed * (self.speedScale or 1)
	local best, bd = self:nearestOpponent()
	if self.asleep then
		if best and bd <= (self.aggro or 50) then self.asleep = false else best = nil end
	end
	if not best then
		self.hum:Move(Vector3.zero)
		return
	end
	if self.ai.shifter and shapeshift and not self.shifted and t >= (self.shiftAt or math.huge) then
		self.shifted = true
		shapeshift(self)
		return
	end
	local dir = flat(best.hrp.Position - self.hrp.Position)
	local reach = 0
	for _, a in self.data.attacks do reach = math.max(reach, a.range) end
	local keep = self.ai.keepDistance
	local engage = keep > 0 and math.max(keep + 6, reach) or math.max(4.5, math.min(reach, 8) + self.radius + best.radius)
	if keep > 0 and bd < keep - 4 then
		self.hum:MoveTo(self.hrp.Position - dir.Unit * 8)
		return
	end
	if bd > engage then
		local push = Vector3.zero
		for _, o in fighters do
			if o ~= self and o.team == "Enemy" and not o.dead and o.hrp then
				local away = flat(self.hrp.Position - o.hrp.Position)
				if away.Magnitude < 6 and away.Magnitude > 0.01 then push += away.Unit * (6 - away.Magnitude) end
			end
		end
		self.hum:MoveTo(best.hrp.Position - dir.Unit * (engage * 0.75) + push)
		return
	end
	self.hum:Move(Vector3.zero)
	self.hrp.CFrame = CFrame.lookAt(self.hrp.Position, self.hrp.Position + dir)
	if t >= self.nextAttack and (self.ai.boss or attackersNow() < Config.MaxAttackers)
		and t - best.lastHitAt > Config.WaitAfterHeroHit then
		local key = self:pickAttack(bd)
		if key then
			self:play(self.data.attacks[key].anim, Config.FadeAttack, "attack", key)
			local c = self.ai.cooldown
			self.nextAttack = t + c[1] + math.random() * (c[2] - c[1])
		end
	end
end

-- frame loop ---------------------------------------------------------------------------------------------------------
local function stepProjectiles(dt: number)
	for id, p in projectiles do
		local owner = p.owner
		local from = p.pos
		p.vel += Vector3.new(0, -p.g * dt, 0)
		local to = from + p.vel * dt
		local done = now() >= p.expires
		local hitPos
		if not done then
			local wall = workspace:Raycast(from, to - from, wallParams)
			if wall then done, hitPos = true, wall.Position end
		end
		if not done and owner.team == "Hero" and breakCrate then
			for crate, c in Mission.crates do
				if not c.broken and (c.pos - to).Magnitude <= math.max(0.8, p.imp.radius) + c.radius then
					breakCrate(crate, owner)
					done, hitPos = true, to
				end
			end
		end
		if not done and owner.model.Parent then
			local r = math.max(0.8, p.imp.radius)
			for _, t in opponents(owner) do
				if not p.hit[t] and bodyDistance(t, to) <= r + t.radius then
					p.hit[t] = true
					hitPos = to
					t:takeHit(owner, p.imp, to)
					if (p.imp.explode or 0) > 0 then
						for _, o in opponents(owner) do
							if o ~= t and not p.hit[o] and bodyDistance(o, to) <= p.imp.explode + o.radius then
								p.hit[o] = true
								o:takeHit(owner, p.imp, to)
							end
						end
					end
					if p.imp.destroyOnImpact ~= false then done = true end
					break
				end
			end
		end
		p.pos = to
		if done then
			projectiles[id] = nil
			FxRemote:FireAllClients("projEnd", { id = id, pos = hitPos or to, hit = hitPos ~= nil, hero = owner.hero })
		end
	end
end

local function stepPickups()
	for p, expires in pickups do
		if not p.Parent or now() > expires then
			pickups[p] = nil
			p:Destroy()
		else
			for _, f in fighters do
				if f.team == "Hero" and not f.dead and f.hrp and (f.hrp.Position - p.Position).Magnitude < 4.5 then
					local kind = p:GetAttribute("Kind")
					if kind == "star" then
						Score.team += S.pickupBonus
						publishScore()
					else
						f.hum.Health = math.min(f.hum.MaxHealth, f.hum.Health + f.hum.MaxHealth * Config.HealthPickup)
					end
					if f.player then FxRemote:FireClient(f.player, "pickup", { kind = kind, pos = p.Position }) end
					pickups[p] = nil
					p:Destroy()
					break
				end
			end
		end
	end
end

RunService.Heartbeat:Connect(function(dt)
	for model, f in fighters do
		if not model.Parent then
			fighters[model] = nil
			continue
		end
		f.anim:Step(dt)
		local d = f.anim:ConsumeRootMotion()
		if f.team == "Enemy" and f.action and d ~= 0 and f.hrp then
			local clip = f.anim.pack.clips[f.action]
			if clip and clip.rootMotion then f.hrp.CFrame += f.hrp.CFrame.LookVector * d end
		end
		if f.player and f.heat > 0 then f:addHeat(-S.comboLossRate * dt) end
		if f.action == "recoil_launch" and f.launchAt and not f.dead and now() - f.launchAt > 0.75 then
			f.launchAt = nil
			f:play("recoil_launch_land", 0.05, "recoil")
		elseif f.action == "recoil_stun" and f.stunUntil and now() >= f.stunUntil then
			f:clear()
		elseif f.action and not f.anim:IsPlaying(f.action) then
			f:onActionEnd()
		end
		if f.atk and f.action then
			f:timedImpacts()
			for i in f.atk.open do
				local imp = f.atk.def.impacts[i]
				if imp then f:meleeCheck(i, imp) end
			end
		end
		if f.team == "Enemy" then f:think() end
	end
	stepProjectiles(dt)
	stepPickups()
end)

-- players and hero select ------------------------------------------------------------------------------------------------
local function setupCharacter(player: Player, char: Model, hero: string)
	local cfg = Config.Heroes[hero]
	local hum = char:FindFirstChildOfClass("Humanoid")
	hum.MaxHealth, hum.Health = cfg.health, cfg.health
	hum.BreakJointsOnDeath = false
	hum.WalkSpeed = cfg.walkSpeed
	hum.UseJumpPower = true
	hum.JumpPower = cfg.jumpPower
	local f = Fighter.new(char, "Hero", player, hero, nil)
	f.power = player:GetAttribute("SPSO_Power") or 0
	hum.Died:Connect(function()
		f:die(nil, nil)
		task.delay(Config.RespawnTime, function()
			if player.Parent and player.Character == char then
				_G.SPSO_SpawnHero(player)
			end
		end)
	end)
end

local function spawnHero(player: Player)
	local hero = player:GetAttribute("SPSO_Hero")
	local cfg = hero and Config.Heroes[hero]
	if not cfg then return end
	local template = ServerStorage.SPSO.Characters:FindFirstChild(cfg.template)
	if not template then
		warn("[SPSO] no character template " .. cfg.template)
		return
	end
	local old = player.Character
	if old then
		fighters[old] = nil
		old:Destroy()
	end
	local char = template:Clone()
	char.Name = player.Name
	local hubCF = _G.SPSO_SpawnCF and _G.SPSO_SpawnCF(player)
	char:PivotTo(hubCF or (spawnPoint("Player", (#Players:GetPlayers() + player.UserId) % 4 + 1) + Vector3.new(0, 3, 0)))
	char.Parent = workspace
	player.Character = char
	pcall(function() char.HumanoidRootPart:SetNetworkOwner(player) end)
	setupCharacter(player, char, hero)
	FxRemote:FireAllClients("spawn", { model = char })
end
_G.SPSO_SpawnHero = spawnHero

local function onPlayer(player: Player)
	player:SetAttribute("SPSO_Power", player:GetAttribute("SPSO_Power") or 0)
	player:SetAttribute("SPSO_Combo", 0)
end
Players.PlayerAdded:Connect(onPlayer)
for _, p in Players:GetPlayers() do task.spawn(onPlayer, p) end
Players.PlayerRemoving:Connect(function(p)
	if p.Character then
		fighters[p.Character] = nil
		p.Character:Destroy()
	end
end)

SelectRemote.OnServerEvent:Connect(function(player, hero)
	if type(hero) ~= "string" or not Config.Heroes[hero] then return end
	local f = player.Character and fighters[player.Character]
	if f and f.actionKind == "attack" then return end
	player:SetAttribute("SPSO_Hero", hero)
	spawnHero(player)
end)

AttackRemote.OnServerEvent:Connect(function(player, kind)
	if Config.Mode == "Hub" and player:GetAttribute("SPSO_Zone") ~= "Brawler" then return end
	local f = player.Character and fighters[player.Character]
	if f and type(kind) == "string" then f:tryAttack(kind) end
end)

EmoteRemote.OnServerEvent:Connect(function(player, idx)
	local f = player.Character and fighters[player.Character]
	if not f or f.dead or type(idx) ~= "number" then return end
	if idx == 0 then
		if f.actionKind == "emote" then f:clear() end
	elseif not f.action then
		local clip = Config.Emotes[idx] or Config.PowerEmotes[idx - #Config.Emotes]
		if clip and f.anim:HasClip(clip) then f:play(clip, 0.25, "emote") end
	end
end)

-- enemies, waves, scoring ---------------------------------------------------------------------------------------------
local skinCount = {}
local function spawnEnemy(arch: string, i: number, at: CFrame?)
	local spec = GameData.Enemies[arch]
	local ai = Config.Enemies[arch]
	local cfg = Config.Models[spec.model]
	local template = cfg and ServerStorage.SPSO.Characters:FindFirstChild(cfg.template)
	if not template then
		warn("[SPSO] no template for enemy model " .. tostring(spec.model))
		return
	end
	local e = template:Clone()
	e.Name = spec.displayName
	if #ai.skins > 0 then -- optional costume recolours
		skinCount[arch] = (skinCount[arch] or 0) + 1
		local skin = ai.skins[(skinCount[arch] - 1) % #ai.skins + 1]
		e:SetAttribute("SPSO_Variant", skin)
		local body = e:FindFirstChild(cfg.bodyPart, true)
		local head = e:FindFirstChild(cfg.headPart, true)
		local b, h = Assets.Skins[spec.model .. "_" .. skin .. "_Body"], Assets.Skins[spec.model .. "_" .. skin .. "_Head"]
		if body and b and b ~= "" then body.TextureID = b end
		if head and h and h ~= "" then head.TextureID = h end
	end
	local hum = e:FindFirstChildOfClass("Humanoid")
	hum.MaxHealth, hum.Health = spec.health, spec.health
	hum.BreakJointsOnDeath = false
	hum.WalkSpeed = spec.speed
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	e:PivotTo(at or (spawnPoint("Enemy", i) + Vector3.new(math.random() * 4 - 2, 3, math.random() * 4 - 2)))
	e.Parent = enemyFolder
	e.HumanoidRootPart:SetNetworkOwner(nil)
	local f = Fighter.new(e, "Enemy", nil, spec.model, arch)
	f.nextAttack = now() + 1.2 + math.random() * 1.5
	if ai.boss then e:SetAttribute("SPSO_Boss", true) end
	hum.Died:Connect(function() f:die(nil, nil) end)
	FxRemote:FireAllClients("spawn", { model = e })
	return f
end

local function banner(text: string)
	SPSO:SetAttribute("Banner", text)
	SPSO:SetAttribute("BannerSeq", (SPSO:GetAttribute("BannerSeq") or 0) + 1)
end

local function heroAlive(): boolean
	for _, f in fighters do
		if f.team == "Hero" and not f.dead and inBrawler(f) then return true end
	end
	return false
end

-- medal thresholds: the original ScoreCalculator over this run's waves, for the current player count
local function medals(playerCount: number)
	playerCount = math.max(1, playerCount)
	local num2, num3, combo = 0, 0, 0
	for _, wave in Config.Waves do
		for arch, n in wave.enemies do
			local spec = GameData.Enemies[arch]
			for _ = 1, n do
				combo = math.min(combo + spec.health / (40 * playerCount), 2.99)
				local ko = S.koValues[math.clamp(spec.rank or 1, 0, 5) + 1]
				num2 += ko
				num3 += ko * math.floor(combo)
			end
		end
		combo = math.max(0, combo - S.comboSpawnerLoss)
	end
	local num4 = (num2 + num3) * ((S.survivalBonus[1] or 1) - 1)
	local num14 = num3 + num4
	return { silver = math.floor(num2 + num14 * S.medalRatios.silver), gold = math.floor(num2 + num14 * S.medalRatios.gold),
		adamantium = math.floor(num2 + num14 * S.medalRatios.adamantium) }
end

if not Config.Mission then task.spawn(function()
	SPSO:SetAttribute("Waves", #Config.Waves)
	while true do
		SPSO:SetAttribute("State", "waiting")
		repeat task.wait(1) until heroAlive()
		Score.team, Score.deaths, Score.kos = 0, 0, 0
		publishScore()
		local m = medals(#Players:GetPlayers())
		SPSO:SetAttribute("MedalSilver", m.silver)
		SPSO:SetAttribute("MedalGold", m.gold)
		SPSO:SetAttribute("MedalAdamantium", m.adamantium)
		SPSO:SetAttribute("State", "playing")
		local start = now()
		local first = RunService:IsStudio() and SPSO:GetAttribute("TestStartWave") or 1
		for w, wave in Config.Waves do
			if w < first then continue end
			SPSO:SetAttribute("Wave", w)
			SPSO:SetAttribute("Music", wave.music)
			banner(wave.boss and "BOSS FIGHT!" or ("WAVE " .. w))
			task.wait(2.5)
			local i = 0
			for _, arch in { "Thug", "Blaster", "Grenadier", "Bazooka", "Warlord" } do
				for _ = 1, wave.enemies[arch] or 0 do
					i += 1
					spawnEnemy(arch, i + w)
					task.wait(0.35)
				end
			end
			SPSO:SetAttribute("EnemiesLeft", enemiesLeft())
			repeat task.wait(0.5) until enemiesLeft() == 0
			task.wait(Config.WaveBreak)
		end
		publishScore()
		local final = SPSO:GetAttribute("TeamScore") or 0
		local medal = final >= m.adamantium and "Adamantium" or final >= m.gold and "Gold" or final >= m.silver and "Silver" or "Bronze"
		SPSO:SetAttribute("Medal", medal)
		SPSO:SetAttribute("RunTime", math.floor(now() - start))
		SPSO:SetAttribute("KOs", Score.kos)
		SPSO:SetAttribute("State", "results")
		banner("VICTORY!")
		for _, f in fighters do
			if f.team == "Hero" and not f.dead and not f.action and f.anim:HasClip("emote_victory") then
				f:play("emote_victory", 0.25, "emote")
			end
		end
		task.wait(Config.ResultsTime)
		for _, f in fighters do
			if f.team == "Hero" and not f.dead then f.hum.Health = f.hum.MaxHealth end
		end
		if Config.Mode == "Hub" and _G.SPSO_Travel then -- mission over: back to the social zone
			for _, p in Players:GetPlayers() do
				if p:GetAttribute("SPSO_Zone") == "Brawler" then _G.SPSO_Travel(p, Config.StartZone) end
			end
		end
	end
end) end
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX000015"><Properties><string name="Name">Hub</string><ProtectedString name="Source"><![CDATA[-- SPSO social zones (hub), after the original game's social space: players arrive in a zone with their hero and
--   * collect fractals and hero tokens at the zone's original spawn points (they come back after a while)
--   * meet civilians walking the original NPC paths and pigeons that take off when a hero runs at them
--   * poke the interactive props (hydrants, mailboxes, bins...) to make them jiggle and drop stars
--   * use doors (pairs teleport), the game launchers (mission -> the brawler, zones -> travel) and shops (soon)
-- Zone data: HubData (tools/convert_hub.py); geometry and props are built by setup/02_hub.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local SPSO = ReplicatedStorage:WaitForChild("SPSO")
local Game = SPSO:WaitForChild("Game")
local Config = require(Game:WaitForChild("GameConfig"))
local Net = require(Game:WaitForChild("Net"))
local HubData = Config.HubData
if not HubData or Config.Mode ~= "Hub" then return end
local H = Config.Hub
local HubRemote = Net.event("Hub")
local hubRoot = workspace:WaitForChild("SPSO_Hub", 30)
local now = os.clock

local function cfOf(t)
	return CFrame.new(t[1], t[2], t[3], t[4], t[5], t[6], t[7], t[8], t[9], t[10], t[11], t[12])
end
local function v3(t) return Vector3.new(t[1], t[2], t[3]) end
local function zoneOf(player: Player): string? return player:GetAttribute("SPSO_Zone") end
local function heroesIn(zone: string)
	local out = {}
	for _, p in Players:GetPlayers() do
		local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
		if zoneOf(p) == zone and hrp then table.insert(out, { player = p, hrp = hrp }) end
	end
	return out
end
local function notify(player: Player, kind: string, data) HubRemote:FireClient(player, kind, data or {}) end

-- arrival: zone spawn points (the brawler uses its own) -------------------------------------------------------------
_G.SPSO_SpawnCF = function(player: Player): CFrame?
	local z = HubData.Zones[zoneOf(player) or ""]
	if not z or #z.spawns == 0 then return nil end
	return cfOf(z.spawns[math.random(#z.spawns)]) + Vector3.new(0, 3.5, 0)
end
local function counters(p: Player)
	for _, k in { "Fractals", "Tokens", "Stars" } do
		if p:GetAttribute("SPSO_" .. k) == nil then p:SetAttribute("SPSO_" .. k, 0) end
	end
	local ls = p:FindFirstChild("leaderstats") or Instance.new("Folder")
	ls.Name = "leaderstats"
	for _, k in { "Fractals", "Tokens" } do
		local v = ls:FindFirstChild(k) or Instance.new("IntValue")
		v.Name = k
		v.Value = p:GetAttribute("SPSO_" .. k)
		v.Parent = ls
	end
	ls.Parent = p
end
local function add(p: Player, k: string, n: number)
	p:SetAttribute("SPSO_" .. k, (p:GetAttribute("SPSO_" .. k) or 0) + n)
	local v = p:FindFirstChild("leaderstats") and p.leaderstats:FindFirstChild(k)
	if v then v.Value = p:GetAttribute("SPSO_" .. k) end
end
local function onPlayer(p: Player)
	if not zoneOf(p) then p:SetAttribute("SPSO_Zone", Config.StartZone) end
	counters(p)
end
Players.PlayerAdded:Connect(onPlayer)
for _, p in Players:GetPlayers() do task.spawn(onPlayer, p) end

local function travel(player: Player, zone: string)
	if zone ~= "Brawler" and not HubData.Zones[zone] then return end
	player:SetAttribute("SPSO_Zone", zone)
	if _G.SPSO_SpawnHero and player:GetAttribute("SPSO_Hero") then _G.SPSO_SpawnHero(player) end
	notify(player, "zone", { zone = zone })
end
_G.SPSO_Travel = travel

-- collectibles: fractals (crystals) and hero tokens (coins) -------------------------------------------------------
-- models: Hub_Pickups (tools/build_hub_pickups.py: the original fractal shard, an original token coin and star),
-- inserted by setup/02_hub; a copy goes to ReplicatedStorage for the client's pickup effects
local pickupSrc = ServerStorage:FindFirstChild("SPSO") and ServerStorage.SPSO:FindFirstChild("HubSource")
pickupSrc = pickupSrc and pickupSrc:FindFirstChild("Hub_Pickups")
local pickupTpl = {}
if pickupSrc then
	for _, d in pickupSrc:GetDescendants() do
		local name = d:IsA("MeshPart") and string.match(d.Name, "^(.-)__%d+$")
		if name then pickupTpl[name] = d end
	end
	local rep = Instance.new("Folder")
	rep.Name = "HubPickups"
	for name, t in pickupTpl do
		local c = t:Clone()
		c.Name = name
		c.Parent = rep
	end
	rep.Parent = SPSO
end
local PICKUP_LOOK = {
	Fractal = { model = "Fractal", color = Color3.fromRGB(176, 104, 255), material = Enum.Material.Neon },
	Token = { model = "HeroToken", color = Color3.fromRGB(255, 205, 60), material = Enum.Material.Metal },
}
local collectibles = {}
local function collectible(zf: Instance, zone: string, kind: string, pos: Vector3, respawn: number)
	local lookOf = PICKUP_LOOK[kind]
	local tpl = pickupTpl[lookOf.model]
	local p
	if tpl then
		p = tpl:Clone()
		p.TextureID = ""
	else
		p = Instance.new("Part")
		if kind == "Fractal" then
			p.Size = Vector3.new(1.3, 2.2, 1.3)
		else
			p.Shape = Enum.PartType.Cylinder
			p.Size = Vector3.new(0.35, 2.2, 2.2)
		end
	end
	p.Name = kind
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
	p.CastShadow = false
	p.Material, p.Color = lookOf.material, lookOf.color
	p.CFrame = CFrame.new(pos + Vector3.new(0, 2.2, 0))
	p:SetAttribute("Base", p.Position) -- the client spins and bobs it around this point
	local light = Instance.new("PointLight")
	light.Color, light.Range, light.Brightness = lookOf.color, 8, 1.2
	light.Parent = p
	CollectionService:AddTag(p, "SPSO_Collectible")
	p.Parent = zf
	table.insert(collectibles, { part = p, kind = kind, zone = zone, respawn = respawn, back = 0 })
end

-- civilians and pigeons -------------------------------------------------------------------------------------------------
local chars = ServerStorage:WaitForChild("SPSO"):WaitForChild("Characters")
local seq = 0
local function action(model: Model, clip: string)
	seq += 1
	model:SetAttribute("SPSO_Action", string.format("%s|%.4f|0.150|%d", clip, workspace:GetServerTimeNow(), seq))
end
local function spawnModel(name: string, cf: CFrame, parent: Instance): Model?
	local tpl = chars:FindFirstChild("Hero_" .. name)
	if not tpl then return nil end
	local m = tpl:Clone()
	m.Name = name
	m:SetAttribute("SPSO_Hero", name)
	m:SetAttribute("SPSO_Team", "Neutral")
	m:PivotTo(cf)
	m.Parent = parent
	CollectionService:AddTag(m, "SPSO_Fighter")
	return m
end

local civilians, pigeons = {}, {}
local VARIANTS = { male = { "CivilianMale1", "CivilianMale2", "CivilianMale3", "CivilianMale4" },
	female = { "CivilianFemale1", "CivilianFemale2", "CivilianFemale3", "CivilianFemale4" } }
local function startCivilians(zoneName: string, z, zf: Instance)
	for i, path in z.npcPaths do
		if #path < 2 then continue end
		for k = 1, 2 do -- the original's random-gender spawns: two walkers per path, any of the four looks
			local set = VARIANTS[math.random() < 0.5 and "male" or "female"]
			local name = set[math.random(#set)]
			local start = math.random(#path)
			local m = spawnModel(name, CFrame.new(v3(path[start]) + Vector3.new(0, 3.5, 0)), zf)
			if not m then continue end
			m:SetAttribute("SPSO_Walk", true)
			local hum = m:FindFirstChildOfClass("Humanoid")
			hum.WalkSpeed = H.npcWalkSpeed
			hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
			pcall(function() m.HumanoidRootPart:SetNetworkOwner(nil) end)
			table.insert(civilians, { model = m, hum = hum, path = path, node = start, dir = k == 1 and 1 or -1, wait = 0,
				last = m.HumanoidRootPart.Position, stuck = 0 })
		end
	end
end
local function walkCivilians(dt: number)
	for _, c in civilians do
		local hrp = c.model:FindFirstChild("HumanoidRootPart")
		if not hrp or not c.model.Parent then continue end
		if c.wait > now() then
			c.last, c.stuck = hrp.Position, 0
			continue
		end
		local target = v3(c.path[c.node])
		local flat = Vector3.new(1, 0, 1)
		local arrived = (hrp.Position * flat - target * flat).Magnitude < 3
		-- stuck (a corner, a kerb): after 3 s move on to the next node, after 8 s put the walker on it
		if (hrp.Position - c.last).Magnitude < 0.5 then c.stuck += dt else c.stuck = 0 end
		c.last = hrp.Position
		if c.stuck > 8 then
			c.model:PivotTo(CFrame.new(target + Vector3.new(0, 3.5, 0)))
			c.stuck, arrived = 0, true
		elseif c.stuck > 3 and c.stuck - dt <= 3 then
			arrived = true
		end
		if arrived then
			local nxt = c.node + c.dir
			if nxt < 1 or nxt > #c.path then
				c.dir = -c.dir
				nxt = c.node + c.dir
				if math.random() < 0.5 then -- a pause at the end of the path, sometimes a greeting
					c.wait = now() + 2 + math.random() * 3
					if math.random() < 0.4 then action(c.model, "emote_greet") end
				end
			end
			c.node = math.clamp(nxt, 1, #c.path)
			target = v3(c.path[c.node])
		end
		c.hum:MoveTo(target)
	end
end

-- pigeons: the original social-zone pigeon (pigeon_01) pecks around its spot, takes off when a hero runs at it,
-- flies away and lands back after a while
local pigeonParams = RaycastParams.new()
pigeonParams.FilterType = Enum.RaycastFilterType.Include
local function startPigeons(zoneName: string, z, zf: Instance)
	pigeonParams.FilterDescendantsInstances = { hubRoot }
	for _, pos in z.pigeons do
		local at = v3(pos)
		local hit = workspace:Raycast(at + Vector3.new(0, 4, 0), Vector3.new(0, -12, 0), pigeonParams)
		local floor = hit and hit.Position or at
		local m = spawnModel("HubPigeon", CFrame.new(floor + Vector3.new(0, 3, 0)), zf)
		if not m then return end
		local hrp = m:FindFirstChild("HumanoidRootPart")
		local hum = m:FindFirstChildOfClass("Humanoid")
		hrp.Anchored = true
		if hum then hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end
		local lift = (hum and hum.HipHeight or 0) + hrp.Size.Y / 2
		local home = CFrame.new(floor + Vector3.new(0, lift, 0)) * CFrame.Angles(0, math.random() * math.pi * 2, 0)
		m:PivotTo(home)
		table.insert(pigeons, { model = m, home = home, zone = zoneName, state = "idle", t = 0, peck = now() + math.random() * 6 })
	end
end
local function stepPigeons(dt: number)
	for _, pg in pigeons do
		if not pg.model.Parent then continue end
		local pos = pg.model:GetPivot().Position
		if pg.state == "idle" then
			if now() > pg.peck then -- the second idle (pecking) now and then
				pg.peck = now() + 4 + math.random() * 6
				action(pg.model, "movement_idle_2")
			end
			for _, h in heroesIn(pg.zone) do
				if (h.hrp.Position - pos).Magnitude < H.pigeonScare then
					pg.state, pg.t = "takeoff", 0
					local away = (pos - h.hrp.Position) * Vector3.new(1, 0, 1)
					away = away.Magnitude > 0.1 and away.Unit or Vector3.xAxis
					away = (CFrame.Angles(0, (math.random() - 0.5) * 1.2, 0) * away)
					pg.vel = away * 20 + Vector3.new(0, 12, 0)
					pg.model:PivotTo(CFrame.lookAt(pos, pos + away))
					action(pg.model, math.random() < 0.5 and "fly_takeoff" or "fly_takeoff_2")
					break
				end
			end
		elseif pg.state == "takeoff" or pg.state == "fly" then
			pg.t += dt
			if pg.state == "takeoff" and pg.t > 0.35 then
				pg.state = "fly"
				action(pg.model, "fly")
			end
			if pg.t > 0.2 then
				local p = pos + pg.vel * math.min(pg.t, 1) * dt
				pg.model:PivotTo(CFrame.lookAt(p, p + pg.vel * Vector3.new(1, 0, 1) + Vector3.new(0, 0.01, 0)))
			end
			if pg.t > 4 then
				pg.state, pg.t = "gone", 0
				pg.model:PivotTo(pg.home + Vector3.new(0, -500, 0))
				action(pg.model, "none")
			end
		elseif pg.state == "gone" then
			pg.t += dt
			if pg.t > H.pigeonRespawn then
				local busy = false -- only come back when nobody is standing on the spot
				for _, h in heroesIn(pg.zone) do
					if (h.hrp.Position - pg.home.Position).Magnitude < H.pigeonScare * 1.5 then busy = true end
				end
				if not busy then
					pg.state, pg.t = "idle", 0
					pg.model:PivotTo(pg.home)
					action(pg.model, math.random() < 0.5 and "fly_land" or "fly_land_2")
					pg.peck = now() + 3 + math.random() * 4
				end
			end
		end
	end
end

-- props: poke to jiggle (and maybe a star), doors, launchers, shops ---------------------------------------------------
local function prompt(parent: Instance, text: string, object: string, dist: number?)
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText, pp.ObjectText = text, object
	pp.MaxActivationDistance = dist or 10
	pp.RequiresLineOfSight = false
	pp.Parent = parent
	return pp
end
local function anchor(zf: Instance, pos: Vector3, name: string): BasePart
	local a = Instance.new("Part")
	a.Name = name
	a.Anchored, a.CanCollide, a.CanQuery, a.CanTouch = true, false, false, false
	a.Transparency, a.Size = 1, Vector3.one
	a.Position = pos
	a.Parent = zf
	return a
end
local jiggling = {}
local function jiggle(m: Model, player: Player)
	if jiggling[m] and now() < jiggling[m] then return end
	jiggling[m] = now() + H.jiggleCooldown
	local base = m:GetPivot()
	local t0 = now()
	local conn
	conn = RunService.Heartbeat:Connect(function()
		local t = now() - t0
		if t > 0.7 or not m.Parent then
			conn:Disconnect()
			m:PivotTo(base)
			return
		end
		local a = math.sin(t * 38) * 0.12 * (1 - t / 0.7)
		m:PivotTo(base * CFrame.Angles(a, 0, a * 0.6))
	end)
	if math.random() < H.starChance then
		add(player, "Stars", 1)
		notify(player, "collect", { kind = "Star", pos = base.Position + Vector3.new(0, 4, 0) })
	end
end

local function setupZone(zoneName: string, z)
	local zf = hubRoot and hubRoot:FindFirstChild(zoneName)
	if not zf then
		warn("[SPSO] hub zone not built: " .. zoneName)
		return
	end
	local live = zf:FindFirstChild("Live") or Instance.new("Folder")
	live.Name = "Live"
	live:ClearAllChildren()
	live.Parent = zf
	for _, f in z.fractals do collectible(live, zoneName, "Fractal", v3(f.pos), H.fractalRespawn) end
	for _, t in z.tokens do collectible(live, zoneName, "Token", v3(t.pos), H.tokenRespawn) end
	startCivilians(zoneName, z, live)
	startPigeons(zoneName, z, live)
	local props = zf:FindFirstChild("Props")
	for _, m in props and props:GetChildren() or {} do
		if m:IsA("Model") and m:GetAttribute("Kind") == "PokeAndJiggle" and m.PrimaryPart then
			local cd = Instance.new("ClickDetector")
			cd.MaxActivationDistance = 40
			cd.Parent = m.PrimaryPart
			cd.MouseClick:Connect(function(player)
				if zoneOf(player) == zoneName then jiggle(m, player) end
			end)
		end
	end
	-- doors: pairs lead to each other
	local byName = {}
	for _, d in z.doors do byName[d.name] = d end
	for _, d in z.doors do
		local ex = d.exit and byName[d.exit]
		if ex then
			local a = anchor(live, cfOf(d.cf).Position + Vector3.new(0, 3, 0), "Door")
			prompt(a, "Enter", "Door", 8).Triggered:Connect(function(player)
				local char = player.Character
				if char and zoneOf(player) == zoneName then char:PivotTo(cfOf(ex.cf) + Vector3.new(0, 3.5, 0)) end
			end)
		end
	end
	for _, s in z.shops do
		local a = anchor(live, v3(s.pos) + Vector3.new(0, 3, 0), "Shop")
		prompt(a, "Browse", string.upper(s.kind), 8).Triggered:Connect(function(player)
			notify(player, "message", { text = "The " .. s.kind .. " is closed for now: come back soon!" })
		end)
	end
	for _, l in z.launchers do
		local a = anchor(live, v3(l.pos) + Vector3.new(0, 3, 0), "Launcher")
		local text = ({ mission = "Start Mission", zones = "Travel", cardgame = "Card Game", hq = "Headquarters" })[l.kind] or "Use"
		prompt(a, text, "", 12).Triggered:Connect(function(player)
			if zoneOf(player) ~= zoneName then return end
			if l.kind == "mission" then
				travel(player, "Brawler")
			elseif l.kind == "zones" then
				notify(player, "zones", {})
			else
				notify(player, "message", { text = "Coming soon!" })
			end
		end)
	end
end

HubRemote.OnServerEvent:Connect(function(player, kind, data)
	if kind == "travel" and type(data) == "table" and type(data.zone) == "string" then
		local f = player.Character
		if f and f:GetAttribute("SPSO_Lock") then return end
		travel(player, data.zone)
	end
end)

for zoneName, z in HubData.Zones do task.spawn(setupZone, zoneName, z) end

local lastCollect, lastWalk = 0, now()
RunService.Heartbeat:Connect(function(dt)
	stepPigeons(dt)
	local t = now()
	if t - lastWalk > 0.5 then
		walkCivilians(t - lastWalk)
		lastWalk = t
	end
	if t - lastCollect < 0.15 then return end
	lastCollect = t
	for _, c in collectibles do
		if c.back > 0 then
			if t >= c.back then
				c.back = 0
				c.part.Transparency = 0
				c.part.PointLight.Enabled = true
			end
			continue
		end
		for _, h in heroesIn(c.zone) do
			if (h.hrp.Position - c.part.Position).Magnitude < H.collectRadius then
				c.back = t + c.respawn
				c.part.Transparency = 1
				c.part.PointLight.Enabled = false
				add(h.player, c.kind == "Fractal" and "Fractals" or "Tokens", 1)
				notify(h.player, "collect", { kind = c.kind, pos = c.part.Position })
				break
			end
		end
	end
end)
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000027"><Properties><string name="Name">StarterPlayer/StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX000016"><Properties><string name="Name">BrawlerClient</string><ProtectedString name="Source"><![CDATA[-- SPSO brawler client: loading screen, hero select (live animated previews), the exact animation runtime for
-- every fighter, the original effect sequences and sounds, the brawler camera, input (L chain, R1-R3 power
-- attacks, super, emotes), the HUD (built from the original GUI art), projectiles, beams, pickups, results.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local ContentProvider = game:GetService("ContentProvider")
local Debris = game:GetService("Debris")

local SPSO = ReplicatedStorage:WaitForChild("SPSO")
local Game = SPSO:WaitForChild("Game")
local Config = require(Game:WaitForChild("GameConfig"))
local GameData = require(Game:WaitForChild("GameData"))
local Assets = require(Game:WaitForChild("Assets"))
local Net = require(Game:WaitForChild("Net"))
local Sound = require(Game:WaitForChild("Sound"))
local FxPlayer = require(Game:WaitForChild("FxPlayer"))
local CharacterAnimator = require(Game:WaitForChild("CharacterAnimator"))
local HeroPack = require(SPSO:WaitForChild("Runtime"):WaitForChild("HeroPack"))
local ExactAnimator = require(SPSO.Runtime:WaitForChild("ExactAnimator"))

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local AttackRemote, EmoteRemote, FxRemote = Net.event("Attack"), Net.event("Emote"), Net.event("Fx")
local SelectRemote = Net.event("SelectHero")
local G = Assets.Gui
local HEADING, BODY = Enum.Font.Bangers, Enum.Font.FredokaOne

local function img(parent, key, props)
	local i = Instance.new("ImageLabel")
	i.BackgroundTransparency = 1
	i.Image = G[key] or ""
	for k, v in props or {} do i[k] = v end
	i.Parent = parent
	return i
end

local function text(parent, str, props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = BODY
	l.Text = str
	l.TextColor3 = Color3.new(1, 1, 1)
	l.TextStrokeTransparency = 0.35
	l.TextScaled = false
	for k, v in props or {} do l[k] = v end
	l.Parent = parent
	return l
end

local function screen(name, order)
	local g = Instance.new("ScreenGui")
	g.Name = name
	g.ResetOnSpawn = false
	g.IgnoreGuiInset = true
	g.DisplayOrder = order or 0
	g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	g.Parent = playerGui
	return g
end

-- fighters -------------------------------------------------------------------------------------------------------------
local animators = {}
local decor = {} -- model -> { health bar, shadow }
FxPlayer.setAnimatorResolver(function(model)
	local ca = animators[model]
	return type(ca) == "table" and ca.anim or nil
end)

local function groundDecal(key, size, color, transparency)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Transparency = 1
	p.Size = Vector3.new(size, 0.05, size)
	local d = Instance.new("Decal")
	d.Face = Enum.NormalId.Top
	d.Texture = G[key] or ""
	d.Color3 = color or Color3.new(1, 1, 1)
	d.Transparency = transparency or 0
	d.Parent = p
	p.Parent = workspace:FindFirstChild("SPSO_FX") or workspace
	return p, d
end

local function makeHealthBar(model: Model, boss: boolean)
	local hrp = model:FindFirstChild("HumanoidRootPart")
	local bb = Instance.new("BillboardGui")
	bb.Name = "SPSO_Health"
	bb.Size = UDim2.fromOffset(96, 12)
	local ext = model:GetExtentsSize()
	bb.StudsOffset = Vector3.new(0, math.max(4, ext.Y - 2.2), 0)
	bb.AlwaysOnTop = true
	bb.Adornee = hrp
	img(bb, "bh_enemy_health_bg", { Size = UDim2.fromScale(1, 1), ScaleType = Enum.ScaleType.Stretch })
	local damage = img(bb, "bh_enemy_health_damage", { Size = UDim2.fromScale(1, 1), ScaleType = Enum.ScaleType.Stretch, ZIndex = 2 })
	local fill = img(bb, "bh_enemy_health_full", { Size = UDim2.fromScale(1, 1), ScaleType = Enum.ScaleType.Stretch, ZIndex = 3 })
	img(bb, "bh_enemy_health_gleam", { Size = UDim2.fromScale(1, 1), ScaleType = Enum.ScaleType.Stretch, ZIndex = 4 })
	bb.Enabled = not boss -- the boss gets the big bar at the top of the screen
	bb.Parent = playerGui
	return { gui = bb, fill = fill, damage = damage, shown = 1 }
end

local function attach(model: Instance)
	if not model:IsA("Model") or animators[model] then return end
	animators[model] = "pending"
	task.spawn(function()
		local root = model:WaitForChild("RootPart", 10)
		local hrp = model:WaitForChild("HumanoidRootPart", 10)
		if not root or not hrp then
			animators[model] = nil
			return
		end
		local t0 = os.clock()
		-- the rig streams in: wait until its bones stop arriving (small rigs such as the pigeon have only 14)
		local n, still = -1, 0
		while os.clock() - t0 < 10 do
			local c = #root:GetDescendants()
			if c == n and c > 0 then
				still += 1
				if still > 8 then break end
			else
				n, still = c, 0
			end
			task.wait()
		end
		local isLocal = model == player.Character
		local variant = model:GetAttribute("SPSO_Variant")
		local enemy = model:GetAttribute("SPSO_Team") == "Enemy"
		local ok, ca = pcall(CharacterAnimator.new, model, {
			-- exact bone-scale skinning (EditableMesh) for the local hero; others use the bones (memory budget)
			isLocal = isLocal, skin = isLocal or (Config.Models[model:GetAttribute("SPSO_Hero") or ""] or {}).exactSkin == true,
			prebuildSkin = isLocal,
			faces = not (variant and variant ~= ""), lodDistance = 300,
		})
		if not ok then
			warn("[SPSO] animator failed for " .. model:GetFullName() .. ": " .. tostring(ca))
			animators[model] = nil
			return
		end
		if not model.Parent then
			ca:Destroy()
			animators[model] = nil
			return
		end
		animators[model] = ca
		local d = { shadow = (groundDecal(G.ShadowAlpha and "ShadowAlpha" or "Shadow", 6, Color3.new(0, 0, 0), G.ShadowAlpha and 0.25 or 0.8)) }
		if enemy then d.bar = makeHealthBar(model, model:GetAttribute("SPSO_Boss") == true) end
		decor[model] = d
	end)
end

local function detach(model: Instance)
	local ca = animators[model]
	if type(ca) == "table" then ca:Destroy() end
	animators[model] = nil
	local d = decor[model]
	if d then
		if d.bar then d.bar.gui:Destroy() end
		if d.shadow then d.shadow:Destroy() end
	end
	decor[model] = nil
end

